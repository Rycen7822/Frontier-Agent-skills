{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent-skills.local/schemas/frontier-engineering-bundle.schema.json",
  "title": "Frontier Engineering generated bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "compatible_schema_epoch", "release_build_id", "activation_ceiling", "remote_writes", "skills"],
  "properties": {
    "schema_version": {"const": "frontier-engineering-bundle/2.0"},
    "bundle_id": {"const": "frontier-engineering/11.2.0"},
    "compatible_schema_epoch": {"const": 9},
    "release_build_id": {"type": "string", "pattern": "^build-[0-9a-f]{24}$"},
    "activation_ceiling": {"const": "implicit_local_pilot"},
    "remote_writes": {"const": false},
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code-review",
        "code-simplifier",
        "codebase-investigation",
        "debugging",
        "long-document-segmented-writing",
        "runtime-verification",
        "skill-evaluator",
        "software-design",
        "software-quality-workflows",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"$ref": "#/$defs/implicit_skill", "properties": {"version": {"const": "3.1.0"}}},
        "skill-evaluator": {"$ref": "#/$defs/explicit_skill", "properties": {"version": {"const": "5.0.1"}}},
        "software-quality-workflows": {"$ref": "#/$defs/explicit_skill", "properties": {"version": {"const": "13.0.0"}}},
        "writing-plans": {"$ref": "#/$defs/implicit_skill", "properties": {"version": {"const": "9.1.0"}}},
        "code-review": {"$ref": "#/$defs/implicit_skill", "properties": {"version": {"const": "2.0.2"}}},
        "code-simplifier": {"$ref": "#/$defs/implicit_skill", "properties": {"version": {"const": "1.2.0"}}},
        "codebase-investigation": {"$ref": "#/$defs/implicit_skill", "properties": {"version": {"const": "1.1.0"}}},
        "debugging": {"$ref": "#/$defs/implicit_skill", "properties": {"version": {"const": "1.1.0"}}},
        "runtime-verification": {"$ref": "#/$defs/implicit_skill", "properties": {"version": {"const": "1.1.0"}}},
        "software-design": {"$ref": "#/$defs/implicit_skill", "properties": {"version": {"const": "1.1.0"}}}
      }
    }
  },
  "$defs": {
    "base_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "root_hash", "allow_implicit_invocation"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "root_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "allow_implicit_invocation": {"type": "boolean"}
      }
    },
    "implicit_skill": {"$ref": "#/$defs/base_skill", "properties": {"allow_implicit_invocation": {"const": true}}},
    "explicit_skill": {"$ref": "#/$defs/base_skill", "properties": {"allow_implicit_invocation": {"const": false}}}
  }
}
