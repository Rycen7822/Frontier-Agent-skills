{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent.local/sqw/workflow-event-3.0.schema.json",
  "title": "SQW Operator Audit Event 3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "workflow_id", "sequence", "timestamp", "actor", "type", "state_version", "payload"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "event_id": {"type": "string", "pattern": "^evt-[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "workflow_id": {"type": "string", "pattern": "^sqw-workflow:[0-9a-f]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor": {"$ref": "#/$defs/actor"},
    "type": {"$ref": "#/$defs/event_type"},
    "state_version": {"type": "integer", "minimum": 1},
    "node_id": {"type": "string", "pattern": "^N-"},
    "run_id": {"type": "string", "pattern": "^RUN-"},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "previous_event_hash": {"$ref": "#/$defs/hash"},
    "source_state_hash": {"$ref": "#/$defs/hash"},
    "result_state_hash": {"$ref": "#/$defs/hash"},
    "event_hash": {"$ref": "#/$defs/hash"},
    "payload": {"$ref": "#/$defs/payload"}
  },
  "oneOf": [
    {"$ref": "#/$defs/workflow_family"},
    {"$ref": "#/$defs/node_state_family"},
    {"$ref": "#/$defs/node_artifact_family"},
    {"$ref": "#/$defs/artifact_family"},
    {"$ref": "#/$defs/invalidation_family"},
    {"$ref": "#/$defs/source_drift_family"},
    {"$ref": "#/$defs/retry_family"},
    {"$ref": "#/$defs/approval_family"},
    {"$ref": "#/$defs/lock_family"},
    {"$ref": "#/$defs/review_family"},
    {"$ref": "#/$defs/plan_change_family"},
    {"$ref": "#/$defs/publication_family"}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "string_array": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["controller", "worker", "reviewer", "tool", "system"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "event_type": {
      "enum": [
        "workflow_opened", "route_selected", "node_refined", "node_started", "node_output_committed", "node_completed", "node_failed",
        "artifact_observed", "fact_invalidated", "dependency_invalidated", "repair_scoped", "retry_approved", "approval_granted", "approval_revoked",
        "lock_acquired", "lock_released", "source_drift_detected", "review_submitted", "plan_change_proposed", "workflow_completed", "workflow_resumed",
        "publication_handoff_requested", "publication_handoff_completed"
      ]
    },
    "changed_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "fields"],
      "properties": {
        "ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "fields": {"$ref": "#/$defs/string_array"}
      }
    },
    "artifact_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "content_hash"],
      "properties": {
        "artifact_ref": {"type": "string", "pattern": "^artifact:[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "summary", "artifact_refs", "changed_refs", "side_effects_observed"],
      "properties": {
        "classification": {"enum": ["public", "internal", "sensitive_pointer"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "artifact_refs": {"$ref": "#/$defs/string_array"},
        "artifact_bindings": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/artifact_binding"}},
        "changed_refs": {"$ref": "#/$defs/string_array"},
        "changed_fields": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/changed_field"}},
        "side_effects_observed": {"$ref": "#/$defs/string_array"},
        "failure_ref": {"type": "string", "pattern": "^ERR-"},
        "approval_ref": {"type": "string", "pattern": "^AP-"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 1024},
        "lease_expires_at": {"type": "string", "format": "date-time"},
        "plan_change_ref": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "workflow_family": {"properties": {"type": {"enum": ["workflow_opened", "route_selected", "workflow_completed", "workflow_resumed"]}}},
    "node_state_family": {"required": ["node_id"], "properties": {"type": {"enum": ["node_refined", "node_started", "node_failed"]}}},
    "node_artifact_family": {"required": ["node_id"], "properties": {"type": {"enum": ["node_output_committed", "node_completed"]}, "payload": {"properties": {"artifact_refs": {"minItems": 1}}}}},
    "artifact_family": {"properties": {"type": {"const": "artifact_observed"}, "payload": {"properties": {"artifact_refs": {"minItems": 1}}}}},
    "invalidation_family": {"properties": {"type": {"enum": ["fact_invalidated", "dependency_invalidated", "repair_scoped"]}, "payload": {"properties": {"changed_refs": {"minItems": 1}}}}},
    "source_drift_family": {"properties": {"type": {"const": "source_drift_detected"}, "payload": {"properties": {"artifact_refs": {"minItems": 1}}, "required": ["artifact_refs"]}}},
    "retry_family": {"required": ["node_id"], "properties": {"type": {"const": "retry_approved"}, "payload": {"required": ["failure_ref"]}}},
    "approval_family": {"properties": {"type": {"enum": ["approval_granted", "approval_revoked"]}, "payload": {"required": ["approval_ref"]}}},
    "lock_family": {"properties": {"type": {"enum": ["lock_acquired", "lock_released"]}, "payload": {"required": ["resource"]}}},
    "review_family": {"properties": {"type": {"const": "review_submitted"}, "payload": {"properties": {"artifact_refs": {"minItems": 1}}}}},
    "plan_change_family": {"properties": {"type": {"const": "plan_change_proposed"}, "payload": {"required": ["plan_change_ref"]}}},
    "publication_family": {"properties": {"type": {"enum": ["publication_handoff_requested", "publication_handoff_completed"]}, "payload": {"properties": {"artifact_refs": {"minItems": 1}}}}}
  }
}
