{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontier://software-quality-workflows/reference-card-frontmatter/2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["card_id", "card_version", "kind", "decision_id", "required_artifact_ids", "produced_artifact_ids", "max_bytes"],
  "properties": {
    "card_id": {"type": "string", "pattern": "^sqw(?:\\.[a-z0-9][a-z0-9-]*)+$"},
    "card_version": {"type": "integer", "minimum": 1},
    "kind": {"enum": ["decision", "procedure", "rubric", "recipe", "safety", "bridge"]},
    "decision_id": {"type": "string", "pattern": "^sqw\\.select\\.[a-z0-9.-]+$"},
    "required_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}},
    "produced_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"}},
    "max_bytes": {"type": "integer", "minimum": 512, "maximum": 8192}
  }
}
