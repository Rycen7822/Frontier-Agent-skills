{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent-skills.local/software-quality-workflows/route-result.schema.json",
  "title": "Software Quality Workflows decision route result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "route_action", "route_owner", "selected_decision_id",
    "primary_card", "required_artifact_ids", "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "route_action": {"enum": ["select_card", "handoff", "terminal", "blocked"]},
    "route_owner": {"enum": ["writing-plans", "software-quality-workflows", null]},
    "selected_decision_id": {"type": ["string", "null"], "minLength": 1},
    "primary_card": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["card_id", "path", "sha256", "bytes"],
          "properties": {
            "card_id": {"type": "string", "pattern": "^sqw\\."},
            "path": {"type": "string", "pattern": "^references/"},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 1, "maximum": 8192}
          }
        }
      ]
    },
    "required_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "uniqueItems": true}
  }
}
