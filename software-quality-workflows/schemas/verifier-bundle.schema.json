{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/sqw/verifier-bundle-1.0.schema.json",
  "title": "SQW Verifier Bundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "closure_epoch", "status", "content_hash", "contract_hash", "source_revision", "scope_hash", "environment_fingerprint", "protected_paths", "oracles", "qualification_summary", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_id": {"type": "string", "pattern": "^VB-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "closure_epoch": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "frozen", "qualified", "rejected", "superseded"]},
    "content_hash": {"$ref": "#/$defs/hash"},
    "contract_hash": {"$ref": "#/$defs/hash"},
    "source_revision": {"type": "string", "minLength": 1, "maxLength": 256},
    "scope_hash": {"$ref": "#/$defs/hash"},
    "environment_fingerprint": {"$ref": "#/$defs/hash"},
    "protected_paths": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "oracles": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/oracle"}},
    "qualification_summary": {"$ref": "#/$defs/qualification_summary"},
    "limitations": {"$ref": "#/$defs/string_array"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "qualified"}}, "required": ["status"]}, "then": {"properties": {"qualification_summary": {"properties": {"status": {"const": "pass"}}, "required": ["status"]}}}},
    {"if": {"properties": {"status": {"const": "rejected"}}, "required": ["status"]}, "then": {"properties": {"qualification_summary": {"properties": {"status": {"const": "fail"}}, "required": ["status"]}, "limitations": {"minItems": 1}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "string_array": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "artifact_ref": {"type": "string", "pattern": "^artifact:[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "artifact_refs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact_ref"}},
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {"kind": {"enum": ["command", "script", "schema", "external"]}, "target": {"type": "string", "minLength": 1, "maxLength": 2048}}
    },
    "repeat_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["runs", "warmup_runs", "flake_tolerance", "evidence_refs"],
      "properties": {"runs": {"type": "integer", "minimum": 1, "maximum": 1000}, "warmup_runs": {"type": "integer", "minimum": 0, "maximum": 1000}, "flake_tolerance": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"$ref": "#/$defs/artifact_refs"}}
    },
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "requirement_refs", "constraint_refs", "class", "authority", "command", "environment_refs", "corner_refs", "expected_baseline", "qualification_level", "repeat_policy", "cost_class", "timeout_seconds", "counterexample_adapter", "evidence_schema_id", "protected_from_candidate"],
      "properties": {
        "id": {"type": "string", "pattern": "^ORACLE-[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
        "requirement_refs": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^VR-"}},
        "constraint_refs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^HC-"}},
        "class": {"enum": ["static", "repository_test", "property_test", "runtime_probe", "differential", "benchmark", "security_negative", "external", "manual", "hidden"]},
        "authority": {"enum": ["controller_owned", "repository_protected", "external", "candidate_supplementary", "promoted"]},
        "command": {"$ref": "#/$defs/command"},
        "environment_refs": {"$ref": "#/$defs/artifact_refs"},
        "corner_refs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^CORNER-"}},
        "expected_baseline": {"enum": ["pass", "fail_known", "metric", "not_applicable"]},
        "qualification_level": {"enum": ["addressable", "stable", "discriminating", "independent"]},
        "repeat_policy": {"$ref": "#/$defs/repeat_policy"},
        "cost_class": {"enum": ["low", "medium", "high"]},
        "timeout_seconds": {"type": "integer", "minimum": 0, "maximum": 604800},
        "counterexample_adapter": {"type": "string", "minLength": 1, "maxLength": 2048},
        "evidence_schema_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "protected_from_candidate": {"type": "boolean"}
      }
    },
    "qualification_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "required_oracle_ids", "qualified_oracle_ids", "unqualified_oracle_ids", "baseline_result_refs", "discrimination_evidence_refs", "independence_evidence_refs"],
      "properties": {
        "status": {"enum": ["pass", "fail", "inconclusive"]},
        "required_oracle_ids": {"$ref": "#/$defs/oracle_ids"},
        "qualified_oracle_ids": {"$ref": "#/$defs/oracle_ids"},
        "unqualified_oracle_ids": {"$ref": "#/$defs/oracle_ids"},
        "baseline_result_refs": {"$ref": "#/$defs/artifact_refs"},
        "discrimination_evidence_refs": {"$ref": "#/$defs/artifact_refs"},
        "independence_evidence_refs": {"$ref": "#/$defs/artifact_refs"}
      }
    },
    "oracle_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^ORACLE-"}}
  }
}
