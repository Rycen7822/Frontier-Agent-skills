{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/sqw/owner-registry-2.0.schema.json",
  "title": "SQW Owner Registry 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owners", "external_owners"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "owners": {"type": "array", "maxItems": 200, "items": {"oneOf": [{"$ref": "#/$defs/normative_owner"}, {"$ref": "#/$defs/companion"}]}},
    "external_owners": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/external_owner"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "slug_array": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "signal_array": {"type": "array", "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"}},
    "phase_array": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z_]{1,39}$"}},
    "role": {"enum": ["lifecycle", "safety", "control_plane", "mechanism", "domain", "evidence", "review", "recovery", "support", "recipe", "review_rubric"]},
    "normative_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "authority", "role", "phases", "owns", "positive_triggers", "exclusions", "requires", "may_load", "conflicts_with"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "path": {"type": "string", "pattern": "^references/[a-z0-9-]+\\.md$"},
        "authority": {"const": "normative_owner"},
        "role": {"$ref": "#/$defs/role"},
        "phases": {"$ref": "#/$defs/phase_array"},
        "owns": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "positive_triggers": {"$ref": "#/$defs/signal_array"},
        "exclusions": {"$ref": "#/$defs/signal_array"},
        "requires": {"$ref": "#/$defs/slug_array"},
        "may_load": {"$ref": "#/$defs/slug_array"},
        "conflicts_with": {"$ref": "#/$defs/slug_array"}
      }
    },
    "companion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "authority", "role", "phases", "contributes", "positive_triggers", "exclusions", "requires", "may_load", "conflicts_with"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "path": {"type": "string", "pattern": "^references/[a-z0-9-]+\\.md$"},
        "authority": {"const": "companion"},
        "role": {"$ref": "#/$defs/role"},
        "phases": {"$ref": "#/$defs/phase_array"},
        "contributes": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
        "positive_triggers": {"$ref": "#/$defs/signal_array"},
        "exclusions": {"$ref": "#/$defs/signal_array"},
        "requires": {"$ref": "#/$defs/slug_array"},
        "may_load": {"$ref": "#/$defs/slug_array"},
        "conflicts_with": {"$ref": "#/$defs/slug_array"}
      }
    },
    "external_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "availability", "probe"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "availability": {"enum": ["required", "optional"]},
        "probe": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    }
  }
}
