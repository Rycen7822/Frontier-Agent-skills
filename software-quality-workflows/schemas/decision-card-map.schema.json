{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent-skills.local/software-quality-workflows/decision-card-map.schema.json",
  "title": "Software Quality Workflows decision-card map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "skill_version", "decisions"],
  "properties": {
    "schema_version": {"const": "decision-card-map/1.0"},
    "skill_id": {"const": "software-quality-workflows"},
    "skill_version": {"const": "8.0.0"},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id", "card_id", "priority", "required_artifact_ids", "produced_artifact_ids",
          "positive_fixture_id", "near_miss_fixture_id"
        ],
        "properties": {
          "decision_id": {"type": "string", "pattern": "^sqw\\.select\\.[a-z0-9.-]+$"},
          "card_id": {"type": "string", "pattern": "^sqw\\.[a-z0-9.-]+$"},
          "priority": {"type": "integer", "minimum": 1},
          "required_artifact_ids": {"$ref": "#/$defs/artifacts"},
          "produced_artifact_ids": {"$ref": "#/$defs/artifacts"},
          "positive_fixture_id": {"type": "string", "pattern": "^sqw-positive-[a-z0-9-]+$"},
          "near_miss_fixture_id": {"type": "string", "pattern": "^sqw-near-miss-[a-z0-9-]+$"}
        }
      }
    }
  },
  "$defs": {
    "artifacts": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}, "uniqueItems": true}
  }
}
