{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/sqw/workflow-state-1.1.schema.json",
  "title": "SQW Workflow State 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "mode", "request_mode", "execution_policy", "policy_bundle_hash", "status", "state_version", "source", "authority", "scope", "global_invariants", "active_owners", "nodes", "verifiers", "edges", "frontier", "locks", "artifacts", "recent_failures", "events_ref", "pending_background", "closure"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "workflow_id": {"type": "string", "pattern": "^wf-[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"},
    "mode": {"enum": ["M1_TRACE", "M2_SPARSE", "M3_FULL"]},
    "request_mode": {"enum": ["report", "review", "diagnose", "change", "recovery"]},
    "execution_policy": {"enum": ["standard", "autonomous_closure"]},
    "policy_bundle_hash": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["open", "active", "blocked", "closing", "closed", "aborted"]},
    "state_version": {"type": "integer", "minimum": 1},
    "state_hash": {"$ref": "#/$defs/hash"},
    "source": {"$ref": "#/$defs/source"},
    "authority": {"$ref": "#/$defs/authority"},
    "scope": {"$ref": "#/$defs/scope"},
    "global_invariants": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/invariant"}},
    "active_owners": {"$ref": "#/$defs/active_owners"},
    "plan_ref": {"$ref": "#/$defs/plan_ref"},
    "nodes": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/node"}},
    "verifiers": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/verifier"}},
    "edges": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/edge"}},
    "frontier": {"$ref": "#/$defs/id_array"},
    "locks": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/lock"}},
    "artifacts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/artifact"}},
    "recent_failures": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/failure"}},
    "events_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
    "pending_background": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-"}},
    "closure": {"$ref": "#/$defs/closure"},
    "closure_run": {"$ref": "#/$defs/closure_run"}
  },
  "allOf": [
    {
      "if": {"properties": {"execution_policy": {"const": "standard"}}, "required": ["execution_policy"]},
      "then": {"not": {"required": ["closure_run"]}}
    },
    {
      "if": {"properties": {"execution_policy": {"const": "autonomous_closure"}}, "required": ["execution_policy"]},
      "then": {
        "required": ["closure_run"],
        "properties": {
          "mode": {"enum": ["M2_SPARSE", "M3_FULL"]},
          "request_mode": {"enum": ["change", "recovery"]}
        }
      }
    }
  ],
  "$defs": {
    "non_empty": {"type": "string", "minLength": 1, "maxLength": 4096},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "local_id": {"type": "string", "pattern": "^(N|EV|VER|I|AP|LOCK|X|ERR|RUN)-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "external_ref": {"type": "string", "pattern": "^(plan|workflow|review|longdoc):[A-Za-z0-9._-]+#[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "ref_id": {"oneOf": [{"$ref": "#/$defs/local_id"}, {"$ref": "#/$defs/external_ref"}]},
    "id_array": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/ref_id"}},
    "string_array": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "owner_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "workflow_phase": {"enum": ["ADMISSION", "SPEC_COMPILING", "CONTRACT_FROZEN", "BASELINING", "VERIFIER_QUALIFYING", "PLANNING", "SEARCHING", "SIGNING_OFF", "TERMINAL", "DIRECT", "DIAGNOSING", "RECOVERY"]},
    "artifact_ref": {"type": "string", "pattern": "^artifact:[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "base_revision", "observed_revision", "scope_hash"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 1024},
        "base_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "observed_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "scope_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "scope", "actor_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^AP-"},
        "status": {"enum": ["requested", "granted", "revoked", "expired"]},
        "scope": {"$ref": "#/$defs/non_empty"},
        "actor_ref": {"$ref": "#/$defs/non_empty"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["risk_ceiling", "external_writes", "destructive_actions", "approvals"],
      "properties": {
        "risk_ceiling": {"enum": ["none", "local_ephemeral", "local_reversible", "external_reversible", "external_non_idempotent", "destructive"]},
        "external_writes": {"enum": ["forbidden", "approved"]},
        "destructive_actions": {"enum": ["forbidden", "approved"]},
        "approvals": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/approval"}}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_reads", "allowed_writes", "protected_paths", "coverage"],
      "properties": {
        "allowed_reads": {"$ref": "#/$defs/string_array"},
        "allowed_writes": {"$ref": "#/$defs/string_array"},
        "protected_paths": {"$ref": "#/$defs/string_array"},
        "coverage": {"enum": ["targeted", "affected", "full"]}
      }
    },
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "status", "sensitive"],
      "properties": {
        "id": {"type": "string", "pattern": "^I-"},
        "statement": {"$ref": "#/$defs/non_empty"},
        "status": {"enum": ["current", "changed", "unknown", "invalidated"]},
        "sensitive": {"type": "boolean"}
      }
    },
    "loaded_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_id", "path", "reason_code", "phase"],
      "properties": {
        "owner_id": {"$ref": "#/$defs/owner_id"},
        "path": {"type": "string", "pattern": "^references/[a-z0-9-]+\\.md$"},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "phase": {"$ref": "#/$defs/workflow_phase"}
      }
    },
    "active_owners": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "normative", "companions", "loaded_references"],
      "properties": {
        "primary": {"$ref": "#/$defs/owner_id"},
        "normative": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/owner_id"}},
        "companions": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/owner_id"}},
        "loaded_references": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/loaded_reference"}}
      }
    },
    "plan_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "state_ref", "content_hash"],
      "properties": {
        "artifact_ref": {"type": "string", "pattern": "^plan:[A-Za-z0-9._-]+#[A-Za-z0-9._-]+$"},
        "state_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "attempt_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "attempts_used", "idempotency"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 0, "maximum": 20},
        "attempts_used": {"type": "integer", "minimum": 0, "maximum": 20},
        "idempotency": {"enum": ["idempotent", "inspect_before_retry", "idempotency_key", "manual_reconciliation", "not_retryable"]},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "operation_type", "status", "objective", "depends_on", "input_refs", "output_refs", "input_contracts", "output_contracts", "read_set", "write_set", "resource_set", "side_effect", "verifier_refs", "required_approvals", "attempt_policy", "sensitive"],
      "properties": {
        "id": {"type": "string", "pattern": "^N-"},
        "operation_type": {"enum": ["model", "tool", "manual", "background", "approval", "verification"]},
        "status": {"enum": ["pending", "ready", "running", "blocked", "done", "failed", "invalidated", "superseded", "skipped", "cancelled"]},
        "objective": {"$ref": "#/$defs/non_empty"},
        "plan_node_ref": {"type": "string", "pattern": "^plan:[A-Za-z0-9._-]+#P-[A-Za-z0-9._-]+$"},
        "depends_on": {"$ref": "#/$defs/id_array"},
        "input_refs": {"$ref": "#/$defs/id_array"},
        "output_refs": {"$ref": "#/$defs/id_array"},
        "input_contracts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/io_contract"}},
        "output_contracts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/io_contract"}},
        "read_set": {"$ref": "#/$defs/string_array"},
        "write_set": {"$ref": "#/$defs/string_array"},
        "resource_set": {"$ref": "#/$defs/string_array"},
        "side_effect": {"enum": ["none", "local_ephemeral", "local_reversible", "external_reversible", "external_non_idempotent", "destructive"]},
        "verifier_refs": {"$ref": "#/$defs/id_array"},
        "required_approvals": {"$ref": "#/$defs/id_array"},
        "attempt_policy": {"$ref": "#/$defs/attempt_policy"},
        "sensitive": {"type": "boolean"}
      }
    },
    "io_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "schema_id"],
      "properties": {
        "ref": {"type": "string", "pattern": "^EV-"},
        "schema_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*/[0-9]+\\.[0-9]+$"}
      }
    },
    "verifier": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "claim", "required_evidence", "observed_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^VER-"},
        "kind": {"enum": ["focused_behavior", "regression_guard", "static_contract", "runtime", "manual", "public_surface", "security_negative", "canonical"]},
        "status": {"enum": ["pending", "partial", "passed", "failed", "stale", "invalidated"]},
        "claim": {"$ref": "#/$defs/non_empty"},
        "required_evidence": {"$ref": "#/$defs/id_array"},
        "observed_evidence": {"$ref": "#/$defs/id_array"},
        "evidence_sensitivity": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/evidence_binding"}}
      }
    },
    "evidence_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "fields"],
      "properties": {
        "ref": {"type": "string", "pattern": "^EV-"},
        "fields": {"$ref": "#/$defs/string_array"}
      }
    },
    "sensitivity": {
      "type": "object", "additionalProperties": false,
      "required": ["fields"],
      "properties": {"fields": {"$ref": "#/$defs/string_array"}}
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": {"type": "string", "pattern": "^X-"},
        "kind": {"enum": ["control", "data", "evidence", "invariant", "effect", "resource", "approval"]},
        "from": {"$ref": "#/$defs/ref_id"},
        "to": {"$ref": "#/$defs/ref_id"},
        "sensitivity": {"$ref": "#/$defs/sensitivity"}
      }
    },
    "lock": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "resource", "owner", "acquired_at", "lease_expires_at", "state_version"],
      "properties": {
        "id": {"type": "string", "pattern": "^LOCK-"},
        "resource": {"$ref": "#/$defs/non_empty"},
        "owner": {"$ref": "#/$defs/non_empty"},
        "acquired_at": {"type": "string", "format": "date-time"},
        "lease_expires_at": {"type": "string", "format": "date-time"},
        "state_version": {"type": "integer", "minimum": 1}
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "run_id"],
      "properties": {"node_id": {"type": "string", "pattern": "^N-"}, "run_id": {"type": "string", "pattern": "^RUN-"}}
    },
    "artifact_source": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "scope_hash"],
      "properties": {"revision": {"type": "string", "minLength": 1, "maxLength": 256}, "scope_hash": {"$ref": "#/$defs/hash"}}
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["command_ref", "working_directory", "exit_code", "duration_ms", "result_summary", "classification"],
      "properties": {
        "command_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "working_directory": {"type": "string", "minLength": 1, "maxLength": 1024},
        "exit_code": {"type": "integer", "minimum": -255, "maximum": 255},
        "duration_ms": {"type": "integer", "minimum": 0},
        "result_summary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "classification": {"enum": ["pass", "expected_red", "product_failure", "baseline_failure", "environment_failure", "blocked", "inconclusive"]}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "paths"],
      "properties": {"level": {"enum": ["focused", "affected", "canonical", "public_surface", "installed"]}, "paths": {"$ref": "#/$defs/string_array"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "schema_id", "claim", "producer", "source", "observation", "artifact_ref", "content_hash", "freshness", "coverage", "limitations", "sensitive"],
      "properties": {
        "id": {"type": "string", "pattern": "^EV-"},
        "kind": {"enum": ["test_result", "static_result", "runtime_observation", "review_result", "manual_oracle", "trace_summary", "failure_record"]},
        "schema_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*/[0-9]+\\.[0-9]+$"},
        "claim": {"$ref": "#/$defs/non_empty"},
        "producer": {"$ref": "#/$defs/producer"},
        "source": {"$ref": "#/$defs/artifact_source"},
        "observation": {"$ref": "#/$defs/observation"},
        "artifact_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "content_hash": {"$ref": "#/$defs/hash"},
        "freshness": {"enum": ["fresh", "stale", "invalidated", "unknown"]},
        "coverage": {"$ref": "#/$defs/coverage"},
        "limitations": {"$ref": "#/$defs/string_array"},
        "sensitive": {"type": "boolean"}
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "classification", "node_id", "summary", "artifact_ref", "sensitive"],
      "properties": {
        "id": {"type": "string", "pattern": "^ERR-"},
        "classification": {"enum": ["product_failure", "baseline_failure", "environment_failure", "authority_block", "external_state", "inconclusive"]},
        "node_id": {"type": "string", "pattern": "^N-"},
        "summary": {"$ref": "#/$defs/non_empty"},
        "artifact_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sensitive": {"type": "boolean"}
      }
    },
    "closure": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "required_verifiers", "evidence_refs", "known_gaps", "residual_risk", "epistemic_status"],
      "properties": {
        "status": {"enum": ["open", "proposed", "closed", "aborted", "inconclusive"]},
        "required_verifiers": {"$ref": "#/$defs/id_array"},
        "evidence_refs": {"$ref": "#/$defs/id_array"},
        "known_gaps": {"$ref": "#/$defs/string_array"},
        "residual_risk": {"$ref": "#/$defs/string_array"},
        "epistemic_status": {"enum": ["needs_repair", "verified_within_scope", "blocked", "empirical_validation_required"]}
      }
    },
    "artifact_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "content_hash"],
      "properties": {"artifact_ref": {"$ref": "#/$defs/artifact_ref"}, "content_hash": {"$ref": "#/$defs/hash"}}
    },
    "epoch_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "content_hash", "epoch"],
      "properties": {"artifact_ref": {"$ref": "#/$defs/artifact_ref"}, "content_hash": {"$ref": "#/$defs/hash"}, "epoch": {"type": "integer", "minimum": 1}}
    },
    "closure_budget": {
      "type": "object", "additionalProperties": false,
      "required": ["iterations_used", "iterations_limit", "candidate_evaluations_used", "candidate_evaluations_limit", "review_rounds_used", "review_rounds_limit"],
      "properties": {
        "iterations_used": {"type": "integer", "minimum": 0},
        "iterations_limit": {"type": "integer", "minimum": 1},
        "candidate_evaluations_used": {"type": "integer", "minimum": 0},
        "candidate_evaluations_limit": {"type": "integer", "minimum": 1},
        "review_rounds_used": {"type": "integer", "minimum": 0},
        "review_rounds_limit": {"type": "integer", "minimum": 1}
      }
    },
    "closure_run": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "policy_bundle_hash", "active_candidate_refs", "active_counterexample_refs", "budget", "terminal_status", "terminal_certificate_ref"],
      "properties": {
        "phase": {"enum": ["SPEC_COMPILING", "CONTRACT_FROZEN", "BASELINING", "VERIFIER_QUALIFYING", "PLANNING", "SEARCHING", "SIGNING_OFF", "TERMINAL"]},
        "policy_bundle_hash": {"$ref": "#/$defs/hash"},
        "contract_ref": {"$ref": "#/$defs/epoch_binding"},
        "verifier_bundle_ref": {"$ref": "#/$defs/epoch_binding"},
        "baseline_ref": {"$ref": "#/$defs/artifact_binding"},
        "incumbent_candidate_ref": {"$ref": "#/$defs/artifact_ref"},
        "active_candidate_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact_ref"}},
        "active_counterexample_refs": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact_ref"}},
        "budget": {"$ref": "#/$defs/closure_budget"},
        "terminal_status": {"oneOf": [{"type": "null"}, {"enum": ["CLOSED", "SPEC_UNDERDETERMINED", "SPEC_UNSAT", "AUTHORITY_BLOCKED", "ENVIRONMENT_UNAVAILABLE", "BASELINE_UNSTABLE", "VERIFIER_UNQUALIFIED", "NON_CONVERGED", "BUDGET_EXHAUSTED", "WORKFLOW_INVALID", "ABORTED_BY_SOURCE_DRIFT"]}]},
        "terminal_certificate_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"phase": {"const": "SPEC_COMPILING"}}, "required": ["phase"]},
          "then": {
            "properties": {"active_candidate_refs": {"maxItems": 0}, "active_counterexample_refs": {"maxItems": 0}, "terminal_status": {"type": "null"}, "terminal_certificate_ref": {"type": "null"}},
            "not": {"anyOf": [{"required": ["contract_ref"]}, {"required": ["baseline_ref"]}, {"required": ["verifier_bundle_ref"]}, {"required": ["incumbent_candidate_ref"]}]}
          }
        },
        {
          "if": {"properties": {"phase": {"const": "CONTRACT_FROZEN"}}, "required": ["phase"]},
          "then": {
            "required": ["contract_ref"],
            "properties": {"active_candidate_refs": {"maxItems": 0}, "active_counterexample_refs": {"maxItems": 0}, "terminal_status": {"type": "null"}, "terminal_certificate_ref": {"type": "null"}},
            "not": {"anyOf": [{"required": ["baseline_ref"]}, {"required": ["verifier_bundle_ref"]}, {"required": ["incumbent_candidate_ref"]}]}
          }
        },
        {
          "if": {"properties": {"phase": {"const": "BASELINING"}}, "required": ["phase"]},
          "then": {
            "required": ["contract_ref"],
            "properties": {"active_candidate_refs": {"maxItems": 0}, "active_counterexample_refs": {"maxItems": 0}, "terminal_status": {"type": "null"}, "terminal_certificate_ref": {"type": "null"}},
            "not": {"anyOf": [{"required": ["verifier_bundle_ref"]}, {"required": ["incumbent_candidate_ref"]}]}
          }
        },
        {
          "if": {"properties": {"phase": {"const": "VERIFIER_QUALIFYING"}}, "required": ["phase"]},
          "then": {
            "required": ["contract_ref", "baseline_ref"],
            "properties": {"active_candidate_refs": {"maxItems": 0}, "active_counterexample_refs": {"maxItems": 0}, "terminal_status": {"type": "null"}, "terminal_certificate_ref": {"type": "null"}},
            "not": {"required": ["incumbent_candidate_ref"]}
          }
        },
        {
          "if": {"properties": {"phase": {"const": "PLANNING"}}, "required": ["phase"]},
          "then": {
            "required": ["contract_ref", "baseline_ref", "verifier_bundle_ref"],
            "properties": {"active_candidate_refs": {"maxItems": 0}, "active_counterexample_refs": {"maxItems": 0}, "terminal_status": {"type": "null"}, "terminal_certificate_ref": {"type": "null"}},
            "not": {"required": ["incumbent_candidate_ref"]}
          }
        },
        {
          "if": {"properties": {"phase": {"const": "SEARCHING"}}, "required": ["phase"]},
          "then": {"required": ["contract_ref", "baseline_ref", "verifier_bundle_ref"], "properties": {"terminal_status": {"type": "null"}, "terminal_certificate_ref": {"type": "null"}}}
        },
        {
          "if": {"properties": {"phase": {"const": "SIGNING_OFF"}}, "required": ["phase"]},
          "then": {"required": ["contract_ref", "baseline_ref", "verifier_bundle_ref", "incumbent_candidate_ref"], "properties": {"terminal_status": {"type": "null"}, "terminal_certificate_ref": {"type": "null"}}}
        },
        {
          "if": {"properties": {"phase": {"const": "TERMINAL"}}, "required": ["phase"]},
          "then": {
            "properties": {
              "active_candidate_refs": {"maxItems": 0},
              "active_counterexample_refs": {"maxItems": 0},
              "terminal_status": {"enum": ["CLOSED", "SPEC_UNDERDETERMINED", "SPEC_UNSAT", "AUTHORITY_BLOCKED", "ENVIRONMENT_UNAVAILABLE", "BASELINE_UNSTABLE", "VERIFIER_UNQUALIFIED", "NON_CONVERGED", "BUDGET_EXHAUSTED", "WORKFLOW_INVALID", "ABORTED_BY_SOURCE_DRIFT"]},
              "terminal_certificate_ref": {"$ref": "#/$defs/artifact_ref"}
            }
          }
        },
        {
          "if": {"properties": {"phase": {"const": "TERMINAL"}, "terminal_status": {"const": "CLOSED"}}, "required": ["phase", "terminal_status"]},
          "then": {"required": ["contract_ref", "baseline_ref", "verifier_bundle_ref", "incumbent_candidate_ref", "terminal_certificate_ref"]}
        }
      ]
    }
  }
}
