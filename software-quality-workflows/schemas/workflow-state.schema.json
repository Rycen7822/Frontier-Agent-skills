{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent.local/sqw/workflow-state-3.0.schema.json",
  "title": "SQW Workflow State 3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "bundle_id", "policy_bundle_hash", "card_manifest_hash", "mode", "request_mode", "status", "state_version", "state_hash", "bootstrap", "scope_binding", "source_identity", "source_snapshot", "source", "authority", "scope", "global_invariants", "active_owners", "nodes", "verifiers", "edges", "frontier", "active_frontier", "card_completions", "artifacts", "recent_failures", "pending_background", "last_transition"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "workflow_id": {"type": "string", "pattern": "^sqw-workflow:[0-9a-f]{64}$"},
    "bundle_id": {"const": "frontier-engineering/6.0.0+5.0.0"},
    "mode": {"enum": ["M2", "M3"]},
    "request_mode": {"enum": ["report", "review", "diagnose", "change", "recovery"]},
    "policy_bundle_hash": {"$ref": "#/$defs/hash"},
    "card_manifest_hash": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["open", "active", "blocked", "completed", "aborted"]},
    "state_version": {"type": "integer", "minimum": 1},
    "state_hash": {"$ref": "#/$defs/hash"},
    "bootstrap": {"$ref": "#/$defs/bootstrap"},
    "scope_binding": {"$ref": "#/$defs/scope_binding"},
    "source_identity": {"$ref": "#/$defs/source_identity"},
    "source_snapshot": {"$ref": "#/$defs/source_snapshot"},
    "source": {"$ref": "#/$defs/source"},
    "authority": {"$ref": "#/$defs/authority"},
    "scope": {"$ref": "#/$defs/scope"},
    "global_invariants": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/invariant"}},
    "active_owners": {"$ref": "#/$defs/active_owners"},
    "context_trace_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact_ref"}]},
    "plan_ref": {"$ref": "#/$defs/plan_ref"},
    "nodes": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/node"}},
    "verifiers": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/verifier"}},
    "edges": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/edge"}},
    "frontier": {"$ref": "#/$defs/id_array"},
    "active_frontier": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/card_frontier"}]},
    "card_completions": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/card_completion"}},
    "artifacts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/artifact"}},
    "recent_failures": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/failure"}},
    "pending_background": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "pattern": "^RUN-"}},
    "last_transition": {"$ref": "#/$defs/last_transition"}
  },
  "$defs": {
    "non_empty": {"type": "string", "minLength": 1, "maxLength": 4096},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bootstrap": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "entry_completion_id", "initial_source_identity_hash", "initial_root_binding", "established_root_identity"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/hash"},
        "entry_completion_id": {"$ref": "#/$defs/hash"},
        "initial_source_identity_hash": {"$ref": "#/$defs/hash"},
        "initial_root_binding": {"$ref": "#/$defs/root_binding"},
        "established_root_identity": {"$ref": "#/$defs/root_binding"}
      }
    },
    "root_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["dev", "ino", "uid", "mode"],
      "properties": {
        "dev": {"type": "integer", "minimum": 0}, "ino": {"type": "integer", "minimum": 1},
        "uid": {"type": "integer", "minimum": 0}, "mode": {"type": "integer", "minimum": 0, "maximum": 511}
      }
    },
    "scope_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "mode", "allowed_reads", "allowed_writes", "effects", "approval_requirements", "publication_ceiling"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/hash"}, "mode": {"enum": ["M2", "M3"]},
        "allowed_reads": {"$ref": "#/$defs/string_array"}, "allowed_writes": {"$ref": "#/$defs/string_array"},
        "effects": {"$ref": "#/$defs/string_array"}, "approval_requirements": {"$ref": "#/$defs/string_array"},
        "publication_ceiling": {"enum": ["none", "local-artifact", "publication-authorized"]}
      }
    },
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identity_hash"],
      "properties": {"kind": {"enum": ["repository", "unversioned"]}, "identity_hash": {"$ref": "#/$defs/hash"}}
    },
    "source_record": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "content_hash", "bytes", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "content_hash": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 8388608},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"}
      }
    },
    "source_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identity_hash", "root_binding", "head_commit", "head_tree", "scoped_records", "exterior_guard_hash"],
      "properties": {
        "kind": {"enum": ["repository", "unversioned"]},
        "identity_hash": {"$ref": "#/$defs/hash"},
        "root_binding": {
          "type": "object", "additionalProperties": false,
          "required": ["dev", "ino"],
          "properties": {"dev": {"type": "integer", "minimum": 0}, "ino": {"type": "integer", "minimum": 1}}
        },
        "head_commit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}]},
        "head_tree": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}]},
        "scoped_records": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/source_record"}},
        "exterior_guard_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "card_frontier": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "decision_id", "card_id", "card_path", "card_hash"],
      "properties": {
        "kind": {"const": "card"}, "decision_id": {"type": "string", "pattern": "^sqw\\.select\\."},
        "card_id": {"type": "string", "pattern": "^sqw\\."}, "card_path": {"type": "string", "pattern": "^references/"},
        "card_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "card_completion": {
      "oneOf": [
        {"$ref": "#/$defs/inline_card_completion"},
        {"$ref": "#/$defs/materialized_card_completion"}
      ]
    },
    "inline_card_completion": {
      "type": "object", "additionalProperties": false,
      "required": ["storage", "operation_id", "prior_state_version", "prior_state_hash", "completion"],
      "properties": {
        "storage": {"const": "inline"}, "operation_id": {"$ref": "#/$defs/hash"},
        "prior_state_version": {"type": "integer", "minimum": 0},
        "prior_state_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "completion": {"type": "object"}
      }
    },
    "materialized_card_completion": {
      "type": "object", "additionalProperties": false,
      "required": ["storage", "operation_id", "prior_state_version", "prior_state_hash", "completion_id", "card_id", "artifact_id", "source_hash", "scope_binding_id", "content_locator", "outcome"],
      "properties": {
        "storage": {"const": "materialized"}, "operation_id": {"$ref": "#/$defs/hash"},
        "prior_state_version": {"type": "integer", "minimum": 0},
        "prior_state_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "completion_id": {"$ref": "#/$defs/hash"}, "card_id": {"type": "string", "pattern": "^sqw\\."},
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_hash": {"$ref": "#/$defs/hash"}, "scope_binding_id": {"$ref": "#/$defs/hash"},
        "content_locator": {"$ref": "#/$defs/artifact_content_locator"},
        "outcome": {"$ref": "#/$defs/completion_outcome"}
      }
    },
    "artifact_content_locator": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "content_kind", "artifact_id", "content_hash", "bytes"],
      "properties": {
        "schema_version": {"const": "content-locator/1"}, "content_kind": {"const": "artifact"},
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "content_hash": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 2097152}
      }
    },
    "completion_outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["blocker", "decision_request"],
      "properties": {
        "blocker": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "decision_request": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]}
      }
    },
    "last_transition": {
      "type": "object", "additionalProperties": false,
      "required": ["transition_kind", "operation_id", "prior_state_version", "prior_state_hash", "completion_id", "next_decision_id"],
      "properties": {
        "transition_kind": {"enum": ["bootstrap", "card"]}, "operation_id": {"$ref": "#/$defs/hash"},
        "prior_state_version": {"type": "integer", "minimum": 0},
        "prior_state_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "completion_id": {"$ref": "#/$defs/hash"},
        "next_decision_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sqw\\.select\\."}]}
      }
    },
    "local_id": {"type": "string", "pattern": "^(N|EV|VER|I|AP|LOCK|X|ERR|RUN)-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "external_ref": {"type": "string", "pattern": "^(plan|workflow|review|longdoc):[A-Za-z0-9._-]+#[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "ref_id": {"oneOf": [{"$ref": "#/$defs/local_id"}, {"$ref": "#/$defs/external_ref"}]},
    "id_array": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/ref_id"}},
    "string_array": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
    "owner_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "artifact_ref": {"type": "string", "pattern": "^artifact:[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "base_revision", "observed_revision", "scope_hash"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 1024},
        "base_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "observed_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "scope_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "scope", "actor_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^AP-"},
        "status": {"enum": ["requested", "granted", "revoked", "expired"]},
        "scope": {"$ref": "#/$defs/non_empty"},
        "actor_ref": {"$ref": "#/$defs/non_empty"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["risk_ceiling", "external_writes", "destructive_actions", "approvals"],
      "properties": {
        "risk_ceiling": {"enum": ["none", "local_ephemeral", "local_reversible", "external_reversible", "external_non_idempotent", "destructive"]},
        "external_writes": {"enum": ["forbidden", "approved"]},
        "destructive_actions": {"enum": ["forbidden", "approved"]},
        "approvals": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/approval"}}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_reads", "allowed_writes", "protected_paths", "coverage"],
      "properties": {
        "allowed_reads": {"$ref": "#/$defs/string_array"},
        "allowed_writes": {"$ref": "#/$defs/string_array"},
        "protected_paths": {"$ref": "#/$defs/string_array"},
        "coverage": {"enum": ["targeted", "affected", "full"]}
      }
    },
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "status", "locality", "targets", "sensitive"],
      "properties": {
        "id": {"type": "string", "pattern": "^I-"},
        "statement": {"$ref": "#/$defs/non_empty"},
        "status": {"enum": ["current", "changed", "unknown", "invalidated"]},
        "locality": {"enum": ["global", "node_set", "resource_set"]},
        "targets": {"$ref": "#/$defs/string_array"},
        "sensitive": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"locality": {"const": "global"}}, "required": ["locality"]},
          "then": {"properties": {"targets": {"maxItems": 0}}},
          "else": {"properties": {"targets": {"minItems": 1}}}
        }
      ]
    },
    "active_owners": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "normative", "companions"],
      "properties": {
        "primary": {"$ref": "#/$defs/owner_id"},
        "normative": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/owner_id"}},
        "companions": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/owner_id"}}
      }
    },
    "plan_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "artifact_ref", "state_ref", "content_hash"],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^plan-[A-Za-z0-9._-]+$"},
        "artifact_ref": {"type": "string", "pattern": "^artifact:plan/[A-Za-z0-9._-]+$"},
        "state_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "attempt_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "attempts_used", "idempotency"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 0, "maximum": 20},
        "attempts_used": {"type": "integer", "minimum": 0, "maximum": 20},
        "idempotency": {"enum": ["idempotent", "inspect_before_retry", "idempotency_key", "manual_reconciliation", "not_retryable"]},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "operation_type", "status", "objective", "depends_on", "input_refs", "output_refs", "input_contracts", "output_contracts", "read_set", "write_set", "resource_set", "effect_set", "side_effect", "verifier_refs", "required_approvals", "attempt_policy", "sensitive"],
      "properties": {
        "id": {"type": "string", "pattern": "^N-"},
        "operation_type": {"enum": ["model", "tool", "manual", "background", "approval", "verification"]},
        "status": {"enum": ["pending", "ready", "running", "blocked", "done", "failed", "invalidated", "superseded", "skipped", "cancelled"]},
        "objective": {"$ref": "#/$defs/non_empty"},
        "plan_node_ref": {"type": "string", "pattern": "^plan:[A-Za-z0-9._-]+#P-[A-Za-z0-9._-]+$"},
        "depends_on": {"$ref": "#/$defs/id_array"},
        "input_refs": {"$ref": "#/$defs/id_array"},
        "output_refs": {"$ref": "#/$defs/id_array"},
        "input_contracts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/io_contract"}},
        "output_contracts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/io_contract"}},
        "read_set": {"$ref": "#/$defs/string_array"},
        "write_set": {"$ref": "#/$defs/string_array"},
        "resource_set": {"$ref": "#/$defs/string_array"},
        "effect_set": {"$ref": "#/$defs/string_array"},
        "side_effect": {"enum": ["none", "local_ephemeral", "local_reversible", "external_reversible", "external_non_idempotent", "destructive"]},
        "verifier_refs": {"$ref": "#/$defs/id_array"},
        "required_approvals": {"$ref": "#/$defs/id_array"},
        "attempt_policy": {"$ref": "#/$defs/attempt_policy"},
        "sensitive": {"type": "boolean"}
      }
    },
    "io_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "schema_id"],
      "properties": {
        "ref": {"type": "string", "pattern": "^EV-"},
        "schema_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*/[0-9]+\\.[0-9]+$"}
      }
    },
    "verifier": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "claim", "required_evidence", "observed_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^VER-"},
        "kind": {"enum": ["focused_behavior", "regression_guard", "static_contract", "runtime", "manual", "public_surface", "security_negative", "canonical"]},
        "status": {"enum": ["pending", "partial", "passed", "failed", "stale", "invalidated"]},
        "claim": {"$ref": "#/$defs/non_empty"},
        "required_evidence": {"$ref": "#/$defs/id_array"},
        "observed_evidence": {"$ref": "#/$defs/id_array"},
        "evidence_sensitivity": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/evidence_binding"}}
      }
    },
    "evidence_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "fields"],
      "properties": {
        "ref": {"type": "string", "pattern": "^EV-"},
        "fields": {"$ref": "#/$defs/string_array"}
      }
    },
    "sensitivity": {
      "type": "object", "additionalProperties": false,
      "required": ["fields"],
      "properties": {"fields": {"$ref": "#/$defs/string_array"}}
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": {"type": "string", "pattern": "^X-"},
        "kind": {"enum": ["data", "control", "evidence", "invariant", "read", "write", "resource", "approval"]},
        "from": {"$ref": "#/$defs/ref_id"},
        "to": {"$ref": "#/$defs/ref_id"},
        "sensitivity": {"$ref": "#/$defs/sensitivity"}
      }
    },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "run_id"],
      "properties": {"node_id": {"type": "string", "pattern": "^N-"}, "run_id": {"type": "string", "pattern": "^RUN-"}}
    },
    "artifact_source": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "scope_hash"],
      "properties": {"revision": {"type": "string", "minLength": 1, "maxLength": 256}, "scope_hash": {"$ref": "#/$defs/hash"}}
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["command_ref", "working_directory", "exit_code", "duration_ms", "result_summary", "classification"],
      "properties": {
        "command_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "working_directory": {"type": "string", "minLength": 1, "maxLength": 1024},
        "exit_code": {"type": "integer", "minimum": -255, "maximum": 255},
        "duration_ms": {"type": "integer", "minimum": 0},
        "result_summary": {"type": "string", "minLength": 1, "maxLength": 2048},
        "classification": {"enum": ["pass", "expected_red", "product_failure", "baseline_failure", "environment_failure", "blocked", "inconclusive"]}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "paths"],
      "properties": {"level": {"enum": ["focused", "affected", "canonical", "public_surface", "installed"]}, "paths": {"$ref": "#/$defs/string_array"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "schema_id", "claim", "producer", "source", "observation", "artifact_ref", "content_hash", "freshness", "coverage", "limitations", "sensitive"],
      "properties": {
        "id": {"type": "string", "pattern": "^EV-"},
        "kind": {"enum": ["test_result", "static_result", "runtime_observation", "review_result", "manual_oracle", "trace_summary", "failure_record"]},
        "schema_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*/[0-9]+\\.[0-9]+$"},
        "claim": {"$ref": "#/$defs/non_empty"},
        "producer": {"$ref": "#/$defs/producer"},
        "source": {"$ref": "#/$defs/artifact_source"},
        "observation": {"$ref": "#/$defs/observation"},
        "artifact_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "content_hash": {"$ref": "#/$defs/hash"},
        "freshness": {"enum": ["fresh", "stale", "invalidated", "unknown"]},
        "coverage": {"$ref": "#/$defs/coverage"},
        "limitations": {"$ref": "#/$defs/string_array"},
        "sensitive": {"type": "boolean"}
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "classification", "node_id", "summary", "artifact_ref", "sensitive"],
      "properties": {
        "id": {"type": "string", "pattern": "^ERR-"},
        "classification": {"enum": ["product_failure", "baseline_failure", "environment_failure", "authority_block", "external_state", "inconclusive"]},
        "node_id": {"type": "string", "pattern": "^N-"},
        "summary": {"$ref": "#/$defs/non_empty"},
        "artifact_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sensitive": {"type": "boolean"}
      }
    }
  }
}
