{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent-skills.local/software-quality-workflows/card-protocol.schema.json",
  "$ref": "#/$defs/command",
  "$defs": {
    "humanOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker"],
      "properties": {
        "blocker": {"type": ["string", "null"]}
      }
    },
    "completionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker", "decision_request"],
      "properties": {
        "blocker": {"type": ["string", "null"]},
        "decision_request": {"type": ["string", "null"]}
      }
    },
    "routeFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_mode", "intent_status", "root_cause_status", "implicated_surfaces",
        "unknown_implicated_facts", "persistence_need", "delegation_need", "external_side_effect"
      ],
      "properties": {
        "request_mode": {"enum": ["change", "report", "review", "recovery", "plan"]},
        "intent_status": {"enum": ["adequate", "materially_underdefined"]},
        "root_cause_status": {"enum": ["known", "unknown", "not_applicable"]},
        "implicated_surfaces": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unknown_implicated_facts": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "persistence_need": {"enum": ["none", "trace", "durable"]},
        "delegation_need": {"enum": ["none", "read", "write"]},
        "external_side_effect": {"enum": ["none", "authorized", "unauthorized", "irreversible"]}
      }
    },
    "entryFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent", "root_cause", "current_behavior", "expected_behavior",
        "protected_paths", "proof_requirements"
      ],
      "properties": {
        "intent": {"type": "string", "minLength": 1},
        "root_cause": {"type": "string", "minLength": 1},
        "current_behavior": {"type": "string", "minLength": 1},
        "expected_behavior": {"type": "string", "minLength": 1},
        "protected_paths": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "proof_requirements": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "scopeFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "allowed_reads", "allowed_writes", "effects",
        "approval_requirements", "publication_ceiling"
      ],
      "properties": {
        "mode": {"enum": ["M0", "M2", "M3"]},
        "allowed_reads": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_writes": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "effects": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["READ_ONLY", "LOCAL_REVERSIBLE", "EXTERNAL_STATE", "PRIVILEGED_DANGEROUS"]}
        },
        "approval_requirements": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "publication_ceiling": {"enum": ["none", "local-artifact", "publication-authorized"]}
      }
    },
    "decisionFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale", "alternatives", "evidence_refs"],
      "properties": {
        "decision": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "evidenceFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "observations", "limitations", "verdict"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verdict": {"type": "string", "minLength": 1}
      }
    },
    "gateFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gates", "results", "verdict", "false_green_checks"],
      "properties": {
        "gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "results": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "verdict": {"enum": ["pass", "fail", "blocked"]},
        "false_green_checks": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "handoffFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "requirements", "authority_requirements", "ordered_slices", "rollback"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "authority_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ordered_slices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "reviewResultFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "verdict", "blockers", "evidence_refs"],
      "properties": {
        "findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verdict": {"enum": ["pass", "fail", "blocked"]},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity_hash"],
      "properties": {
        "kind": {"enum": ["repository", "unversioned"]},
        "identity_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "nextCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "decision_id", "card_id", "card_path", "card_hash"],
      "properties": {
        "kind": {"const": "card"},
        "decision_id": {"type": "string", "minLength": 1},
        "card_id": {"type": "string", "minLength": 1},
        "card_path": {"type": "string", "minLength": 1},
        "card_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "inlineReceiptCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_hash", "producer_card_id", "decision_id", "fields", "outcome"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "producer_card_id": {"type": "string", "pattern": "^sqw\\."},
        "decision_id": {"type": "string", "pattern": "^sqw\\.select\\."},
        "fields": {"oneOf": [{"$ref": "#/$defs/entryFields"}, {"$ref": "#/$defs/scopeFields"}, {"$ref": "#/$defs/decisionFields"}, {"$ref": "#/$defs/evidenceFields"}, {"$ref": "#/$defs/gateFields"}, {"$ref": "#/$defs/handoffFields"}, {"$ref": "#/$defs/reviewResultFields"}]},
        "outcome": {"$ref": "#/$defs/completionOutcome"}
      }
    },
    "contentLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "content_kind", "artifact_id", "content_hash", "bytes"],
      "properties": {
        "schema_version": {"const": "content-locator/1"},
        "content_kind": {"const": "artifact"},
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 2097152}
      }
    },
    "materializedReceiptCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_hash", "producer_card_id", "decision_id", "outcome", "content_locator"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "producer_card_id": {"type": "string", "pattern": "^sqw\\."},
        "decision_id": {"type": "string", "pattern": "^sqw\\.select\\."},
        "outcome": {"$ref": "#/$defs/completionOutcome"},
        "content_locator": {"$ref": "#/$defs/contentLocator"}
      }
    },
    "completion": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/inlineReceiptCompletion"},
        {"$ref": "#/$defs/materializedReceiptCompletion"}
      ]
    },
    "scopeBinding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "binding_id", "mode", "allowed_reads", "allowed_writes", "effects",
        "approval_requirements", "publication_ceiling"
      ],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "mode": {"enum": ["M0", "M2", "M3"]},
        "allowed_reads": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "allowed_writes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "effects": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "approval_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "publication_ceiling": {"type": "string"}
      }
    },
    "durableOwnerLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workflow_id", "bootstrap_operation_id", "bundle_id", "initial_source_identity_hash", "scope_binding_id", "mode", "initial_root_binding_hash"],
      "properties": {
        "schema_version": {"const": "sqw-workflow-owner/1"},
        "workflow_id": {"type": "string", "pattern": "^sqw-workflow:[0-9a-f]{64}$"},
        "bootstrap_operation_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bundle_id": {"type": "string", "minLength": 1},
        "initial_source_identity_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "scope_binding_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "mode": {"enum": ["M2", "M3"]},
        "initial_root_binding_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "ownerLocator": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/durableOwnerLocator"}]
    },
    "nextTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "decision_id", "reason_codes"],
      "properties": {
        "kind": {"const": "terminal"},
        "decision_id": {"type": "null"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "nextStep": {
      "oneOf": [{"$ref": "#/$defs/nextCard"}, {"$ref": "#/$defs/nextTerminal"}]
    },
    "lease": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["lease_id", "producer_id", "decision_id", "lease_expires_at"],
      "properties": {
        "lease_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "producer_id": {"type": "string", "pattern": "^sqw\\."},
        "decision_id": {"type": "string", "pattern": "^sqw\\.select\\."},
        "lease_expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "receipt_kind", "receipt_id", "bundle_id", "skill_id",
        "source_identity", "next_step", "route_context", "completion", "scope_binding",
        "owner_locator", "current_lease", "state_version", "state_hash", "source_fresh", "pending_source_transition"
      ],
      "properties": {
        "schema_version": {"const": "sqw-card-receipt/1"},
        "receipt_kind": {"enum": ["route", "completion", "render"]},
        "receipt_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bundle_id": {"type": "string", "minLength": 1},
        "skill_id": {"const": "software-quality-workflows"},
        "source_identity": {"$ref": "#/$defs/sourceIdentity"},
        "next_step": {"$ref": "#/$defs/nextStep"},
        "route_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/routeFields"}]},
        "completion": {"$ref": "#/$defs/completion"},
        "scope_binding": {"$ref": "#/$defs/scopeBinding"},
        "owner_locator": {"$ref": "#/$defs/ownerLocator"},
        "current_lease": {"$ref": "#/$defs/lease"},
        "state_version": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
        "state_hash": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]},
        "source_fresh": {"type": "boolean"},
        "pending_source_transition": {"type": "null"}
      }
    },
    "routeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "sqw.route.initial/1"},
        "invocation_phase": {"const": "initial"},
        "previous_receipt": {"type": "null"},
        "fields": {"$ref": "#/$defs/routeFields"},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "entryCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "sqw.complete.entry/1"},
        "invocation_phase": {"const": "initial"},
        "previous_receipt": {"$ref": "#/$defs/receipt"},
        "fields": {"$ref": "#/$defs/entryFields"},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "scopeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "sqw.complete.scope/1"},
        "invocation_phase": {"const": "initial"},
        "previous_receipt": {"$ref": "#/$defs/receipt"},
        "fields": {"$ref": "#/$defs/scopeFields"},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "resumeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields"],
      "properties": {
        "contract_id": {"const": "sqw.route.resume/1"},
        "invocation_phase": {"const": "resume"},
        "previous_receipt": {"type": "null"},
        "fields": {
          "type": "object", "additionalProperties": false,
          "required": ["owner_locator"],
          "properties": {"owner_locator": {"$ref": "#/$defs/durableOwnerLocator"}}
        }
      }
    },
    "activeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "sqw.complete.card/1"},
        "invocation_phase": {"const": "active"},
        "previous_receipt": {"$ref": "#/$defs/receipt"},
        "fields": {"oneOf": [{"$ref": "#/$defs/decisionFields"}, {"$ref": "#/$defs/evidenceFields"}, {"$ref": "#/$defs/gateFields"}, {"$ref": "#/$defs/handoffFields"}, {"$ref": "#/$defs/reviewResultFields"}]},
        "outcome": {"$ref": "#/$defs/completionOutcome"}
      }
    },
    "command": {
      "oneOf": [
        {"$ref": "#/$defs/routeCommand"},
        {"$ref": "#/$defs/resumeCommand"},
        {"$ref": "#/$defs/entryCommand"},
        {"$ref": "#/$defs/scopeCommand"},
        {"$ref": "#/$defs/activeCommand"}
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    },
    "artifactFamilyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_def", "payload_def", "human_max_bytes", "payload_max_bytes",
        "source_binding", "persistence_class"
      ],
      "properties": {
        "human_def": {"type": "string", "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9]*$"},
        "payload_def": {"type": "string", "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9]*$"},
        "human_max_bytes": {"type": "integer", "minimum": 1},
        "payload_max_bytes": {"type": "integer", "minimum": 1},
        "source_binding": {"const": "required"},
        "persistence_class": {
          "enum": ["semantic_inline", "boundary_by_contract", "immutable_projection", "owner_disposable_projection"]
        }
      }
    },
    "artifactContractRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "families", "artifacts"],
      "properties": {
        "schema_version": {"const": "sqw-artifact-family-contracts/1"},
        "families": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/artifactFamilyContract"}
        },
        "artifacts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
