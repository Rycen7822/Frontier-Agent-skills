{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-evaluator/schemas/execution-plan-v3.schema.json",
  "title": "Skill Evaluator execution plan v3",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "evaluation_id",
    "source_revision",
    "package_digests",
    "compiler",
    "subject_shape",
    "module_decisions",
    "treatments",
    "catalog",
    "execution_profile",
    "ordering",
    "expected_counts",
    "dimension_coverage",
    "entries",
    "artifacts",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "plan_id": {"$ref": "#/$defs/safe_id"},
    "evaluation_id": {"$ref": "#/$defs/safe_id"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_digests": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/safe_id"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "compiler": {"$ref": "#/$defs/compiler"},
    "subject_shape": {"enum": ["single_skill", "skill_catalog", "ordered_pipeline", "handoff_graph"]},
    "module_decisions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "eval-spec-v7.schema.json#/$defs/module_decision"}
    },
    "treatments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "eval-spec-v7.schema.json#/$defs/treatment"}
    },
    "catalog": {
      "type": "array",
      "items": {"$ref": "host-manifest-v2.schema.json#/$defs/catalog_entry"}
    },
    "execution_profile": {"$ref": "#/$defs/execution_profile"},
    "ordering": {"$ref": "#/$defs/ordering"},
    "expected_counts": {"$ref": "#/$defs/expected_counts"},
    "dimension_coverage": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/safe_id"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    },
    "artifacts": {"$ref": "#/$defs/artifacts"},
    "authority": {"$ref": "#/$defs/authority"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "compiler": {
      "type": "object",
      "required": ["algorithm", "version", "source_revision", "python_executable", "python_version"],
      "properties": {
        "algorithm": {"const": "skill-evaluator-plan"},
        "version": {"const": 2},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "python_executable": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "execution_profile": {
      "type": "object",
      "required": [
        "source_revision",
        "host_id",
        "host_version",
        "provider",
        "model",
        "model_revision",
        "harness",
        "harness_version",
        "platform",
        "command_id",
        "catalog_ids",
        "prompt_id",
        "tool_schema_id",
        "policy_id",
        "tokenizer_id",
        "pricing_id",
        "utc_clock_id",
        "monotonic_clock_id",
        "as_of"
      ],
      "properties": {
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "host_id": {"$ref": "#/$defs/safe_id"},
        "host_version": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "harness_version": {"type": "string", "minLength": 1},
        "platform": {"$ref": "host-manifest-v2.schema.json#/$defs/host_identity/properties/platform"},
        "command_id": {"$ref": "#/$defs/safe_id"},
        "catalog_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/safe_id"}},
        "prompt_id": {"$ref": "#/$defs/safe_id"},
        "tool_schema_id": {"$ref": "#/$defs/safe_id"},
        "policy_id": {"$ref": "#/$defs/safe_id"},
        "tokenizer_id": {"type": "string", "minLength": 1},
        "pricing_id": {"type": "string", "minLength": 1},
        "utc_clock_id": {"type": "string", "minLength": 1},
        "monotonic_clock_id": {"type": "string", "minLength": 1},
        "as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
      },
      "additionalProperties": false
    },
    "ordering": {
      "type": "object",
      "required": ["algorithm", "version", "seed"],
      "properties": {
        "algorithm": {"const": "sha256-block-sort-treatment-rotation"},
        "version": {"const": 1},
        "seed": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "expected_counts": {
      "type": "object",
      "required": ["total", "execute", "unsupported", "not_evaluable"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "execute": {"type": "integer", "minimum": 0},
        "unsupported": {"type": "integer", "minimum": 0},
        "not_evaluable": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "feasibility_evidence": {
      "type": "object",
      "required": ["required_capabilities", "probes", "derived_status"],
      "properties": {
        "required_capabilities": {
          "type": "array",
          "items": {"$ref": "host-manifest-v2.schema.json#/$defs/capability_name"}
        },
        "probes": {
          "type": "array",
          "items": {"$ref": "host-manifest-v2.schema.json#/$defs/probe"}
        },
        "derived_status": {"enum": ["feasible", "unsupported", "not_evaluable"]}
      },
      "additionalProperties": false
    },
    "attempt_policy": {
      "type": "object",
      "required": ["max_attempts", "retryable_apparatus_classes", "backoff_seconds"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 9999},
        "retryable_apparatus_classes": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "backoff_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "execute_case_payload": {
      "type": "object",
      "required": [
        "subject_skill_id",
        "case",
        "treatment",
        "repeat",
        "workspace",
        "fixture",
        "catalog",
        "execution_context",
        "coordination",
        "turns",
        "fault_script",
        "model_policy",
        "tool_policy",
        "network_policy",
        "permission_policy",
        "context_policy",
        "observation_contracts",
        "artifact_contract",
        "capture_contract"
      ],
      "properties": {
        "subject_skill_id": {"$ref": "#/$defs/safe_id"},
        "case": {"$ref": "scenario-v1.schema.json"},
        "treatment": {"$ref": "eval-spec-v7.schema.json#/$defs/treatment"},
        "repeat": {"type": "integer", "minimum": 1},
        "workspace": {"$ref": "#/$defs/relative_path"},
        "fixture": {"$ref": "scenario-v1.schema.json#/$defs/fixture"},
        "catalog": {"type": "array", "items": {"$ref": "host-manifest-v2.schema.json#/$defs/catalog_entry"}},
        "execution_context": {"$ref": "scenario-v1.schema.json#/$defs/execution_context"},
        "coordination": {
          "anyOf": [
            {"$ref": "scenario-v1.schema.json#/$defs/coordination"},
            {"type": "null"}
          ]
        },
        "turns": {"type": "array", "items": {"$ref": "scenario-v1.schema.json#/$defs/turn"}},
        "fault_script": {"type": "array", "items": {"$ref": "scenario-v1.schema.json#/$defs/fault"}},
        "model_policy": {"$ref": "#/$defs/safe_id"},
        "tool_policy": {"$ref": "#/$defs/safe_id"},
        "network_policy": {"$ref": "#/$defs/safe_id"},
        "permission_policy": {"$ref": "#/$defs/safe_id"},
        "context_policy": {"$ref": "#/$defs/safe_id"},
        "observation_contracts": {"type": "array", "items": {"$ref": "scenario-v1.schema.json#/$defs/observation_contract"}},
        "artifact_contract": {"type": "object"},
        "capture_contract": {"type": "object"}
      },
      "additionalProperties": false
    },
    "model_grade_spec": {
      "type": "object",
      "required": ["grader_id", "blinded_projection", "prompt_id", "prompt", "schema_id", "schema", "schedule_id", "batch_id", "batch_entry_ids", "batch_owner_entry_id"],
      "properties": {
        "grader_id": {"$ref": "#/$defs/safe_id"},
        "blinded_projection": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prompt_id": {"$ref": "#/$defs/safe_id"},
        "prompt": {"$ref": "eval-spec-v7.schema.json#/$defs/repository_ref"},
        "schema_id": {"$ref": "#/$defs/safe_id"},
        "schema": {"$ref": "eval-spec-v7.schema.json#/$defs/repository_ref"},
        "schedule_id": {"$ref": "#/$defs/safe_id"},
        "batch_id": {"$ref": "#/$defs/safe_id"},
        "batch_entry_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        },
        "batch_owner_entry_id": {"$ref": "#/$defs/safe_id"}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": [
        "entry_id",
        "entry_ordinal",
        "disposition",
        "feasibility",
        "case_id",
        "treatment_id",
        "repeat",
        "attempt_policy",
        "execute_case_payload",
        "model_grade_specs",
        "grader_ids",
        "check_ids",
        "principal_slot_ids",
        "handoff_ids",
        "action_ids",
        "observation_ids",
        "timeout_seconds",
        "reset_policy",
        "cleanup_policy",
        "required_authority",
        "required_capabilities",
        "artifact_relpath"
      ],
      "properties": {
        "entry_id": {"$ref": "#/$defs/safe_id"},
        "entry_ordinal": {"type": "integer", "minimum": 0},
        "disposition": {"enum": ["execute", "unsupported", "not_evaluable"]},
        "feasibility": {"$ref": "#/$defs/feasibility_evidence"},
        "case_id": {"$ref": "#/$defs/safe_id"},
        "treatment_id": {"$ref": "#/$defs/safe_id"},
        "repeat": {"type": "integer", "minimum": 1},
        "attempt_policy": {"$ref": "#/$defs/attempt_policy"},
        "execute_case_payload": {"$ref": "#/$defs/execute_case_payload"},
        "model_grade_specs": {"type": "array", "items": {"$ref": "#/$defs/model_grade_spec"}},
        "grader_ids": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "check_ids": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "principal_slot_ids": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "handoff_ids": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "action_ids": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "observation_ids": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "reset_policy": {"type": "string", "minLength": 1},
        "cleanup_policy": {"type": "string", "minLength": 1},
        "required_authority": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "required_capabilities": {"type": "array", "items": {"$ref": "host-manifest-v2.schema.json#/$defs/capability_name"}},
        "artifact_relpath": {"$ref": "#/$defs/relative_path"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["root", "index_relpath", "retention", "immutable"],
      "properties": {
        "root": {"$ref": "#/$defs/relative_path"},
        "index_relpath": {"$ref": "#/$defs/relative_path"},
        "retention": {"type": "string", "minLength": 1},
        "immutable": {"const": true}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["runner_capabilities", "external_effects_allowed"],
      "properties": {
        "runner_capabilities": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "external_effects_allowed": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
