{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-evaluator/schemas/comparison-report-v3.schema.json",
  "title": "Skill Evaluator comparison report v3",
  "type": "object",
  "required": [
    "schema_version",
    "comparison_id",
    "kind",
    "claim_scope",
    "generator",
    "registration_status",
    "inputs",
    "comparability_checks",
    "metrics",
    "result",
    "authority_eligibility",
    "claim_ceiling",
    "diagnostic_index_path"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "comparison_id": {"$ref": "#/$defs/safe_id"},
    "kind": {"enum": ["revision", "model_transition"]},
    "claim_scope": {
      "enum": [
        "diagnostic_only",
        "revision_closure",
        "transition_retention"
      ]
    },
    "generator": {"$ref": "#/$defs/generator"},
    "registration_status": {
      "enum": [
        "declared_pre_registered",
        "exploratory",
        "not_evaluable"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/input_record"}
    },
    "comparability_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/comparability_check"}
    },
    "metrics": {
      "type": "array",
      "items": {"$ref": "#/$defs/metric_result"}
    },
    "result": {
      "oneOf": [
        {"$ref": "#/$defs/revision_result"},
        {"$ref": "#/$defs/transition_result"}
      ]
    },
    "authority_eligibility": {"enum": ["eligible", "blocked"]},
    "claim_ceiling": {
      "enum": [
        "diagnostic_only",
        "revision_closure",
        "transition_retention"
      ]
    },
    "diagnostic_index_path": {"$ref": "#/$defs/relative_path"}
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "kind": {"const": "revision"},
        "claim_scope": {
          "enum": ["diagnostic_only", "revision_closure"]
        },
        "result": {"$ref": "#/$defs/revision_result"}
      }
    },
    {
      "properties": {
        "kind": {"const": "model_transition"},
        "claim_scope": {
          "enum": ["diagnostic_only", "transition_retention"]
        },
        "result": {"$ref": "#/$defs/transition_result"}
      }
    }
  ],
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_number": {
      "anyOf": [
        {"type": "number"},
        {"type": "null"}
      ]
    },
    "role": {
      "enum": ["prior", "candidate", "A", "B", "C"]
    },
    "generator": {
      "type": "object",
      "required": ["name", "version", "source_revision"],
      "properties": {
        "name": {"const": "compare_cycles.py"},
        "version": {"const": "5.0.0"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "input_record": {
      "type": "object",
      "required": [
        "role",
        "cycle_id",
        "evaluation_id",
        "plan_id",
        "capsule_digest",
        "execution_profile"
      ],
      "properties": {
        "role": {"$ref": "#/$defs/role"},
        "cycle_id": {"$ref": "#/$defs/safe_id"},
        "evaluation_id": {"$ref": "#/$defs/safe_id"},
        "plan_id": {"$ref": "#/$defs/safe_id"},
        "capsule_digest": {"$ref": "#/$defs/sha256"},
        "execution_profile": {
          "$ref": "execution-plan-v3.schema.json#/$defs/execution_profile"
        }
      },
      "additionalProperties": false
    },
    "comparability_check": {
      "type": "object",
      "required": ["check_id", "status", "roles", "diagnostic_ids"],
      "properties": {
        "check_id": {"$ref": "#/$defs/safe_id"},
        "status": {"enum": ["pass", "fail", "not_evaluable"]},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/role"}
        },
        "diagnostic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        }
      },
      "additionalProperties": false
    },
    "metric_result": {
      "type": "object",
      "required": [
        "metric_id",
        "purpose",
        "reference_role",
        "later_role",
        "status",
        "direction",
        "point",
        "lower",
        "upper",
        "gain_retention",
        "distinct_case_count",
        "diagnostic_ids"
      ],
      "properties": {
        "metric_id": {"$ref": "#/$defs/safe_id"},
        "purpose": {
          "enum": [
            "target_improvement",
            "protected_noninferiority",
            "gain_retention",
            "native_capability",
            "routing",
            "loading",
            "application",
            "interference",
            "specialization"
          ]
        },
        "reference_role": {"$ref": "#/$defs/role"},
        "later_role": {"$ref": "#/$defs/role"},
        "status": {"enum": ["pass", "fail", "not_evaluable"]},
        "direction": {
          "enum": ["higher_is_better", "lower_is_better"]
        },
        "point": {"$ref": "#/$defs/nullable_number"},
        "lower": {"$ref": "#/$defs/nullable_number"},
        "upper": {"$ref": "#/$defs/nullable_number"},
        "gain_retention": {"$ref": "#/$defs/nullable_number"},
        "distinct_case_count": {"type": "integer", "minimum": 0},
        "diagnostic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        }
      },
      "additionalProperties": false
    },
    "revision_result": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "target_failure_class",
        "closed_diagnostic_ids",
        "remaining_diagnostic_ids"
      ],
      "properties": {
        "kind": {"const": "revision"},
        "status": {"enum": ["closed", "open", "not_evaluable"]},
        "target_failure_class": {"$ref": "#/$defs/safe_id"},
        "closed_diagnostic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        },
        "remaining_diagnostic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        }
      },
      "additionalProperties": false
    },
    "transition_result": {
      "type": "object",
      "required": [
        "kind",
        "mode",
        "classification",
        "classification_metric_ids"
      ],
      "properties": {
        "kind": {"const": "model_transition"},
        "mode": {"enum": ["direct", "bridge", "combined"]},
        "classification": {
          "enum": [
            "apparatus_inconclusive",
            "safety_or_protected_interference",
            "routing_loss",
            "loading_loss",
            "application_loss",
            "skill_interference",
            "retained_specialized_value",
            "native_capability_absorption_candidate",
            "insufficient_specialization",
            "stable_no_incremental_value",
            "mixed_or_underpowered",
            "combined_model_harness_drift"
          ]
        },
        "classification_metric_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        }
      },
      "additionalProperties": false
    }
  }
}
