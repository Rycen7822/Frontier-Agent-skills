{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-evaluator/schemas/comparison-observations-v2.schema.json",
  "title": "Skill Evaluator comparison observations v2",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "cycle_id",
    "evaluation_id",
    "plan_id",
    "subject",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "generator": {"$ref": "#/$defs/generator"},
    "cycle_id": {"$ref": "#/$defs/safe_id"},
    "evaluation_id": {"$ref": "#/$defs/safe_id"},
    "plan_id": {"$ref": "#/$defs/safe_id"},
    "subject": {"$ref": "#/$defs/subject"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "generator": {
      "type": "object",
      "required": ["name", "version", "source_revision"],
      "properties": {
        "name": {"const": "analyze_runs.py"},
        "version": {"const": "5.0.0"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["skill_id", "version", "shape", "source_revision"],
      "properties": {
        "skill_id": {"$ref": "#/$defs/safe_id"},
        "version": {"type": "string", "minLength": 1},
        "shape": {
          "enum": [
            "single_skill",
            "skill_catalog",
            "ordered_pipeline",
            "handoff_graph"
          ]
        },
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "scale": {
      "type": "object",
      "required": ["raw", "reported", "normalization"],
      "properties": {
        "raw": {"type": "string", "minLength": 1},
        "reported": {"type": "string", "minLength": 1},
        "normalization": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "case_value": {
      "type": "object",
      "required": ["case_id", "comparator_value", "candidate_value"],
      "properties": {
        "case_id": {"$ref": "#/$defs/safe_id"},
        "comparator_value": {"type": "number"},
        "candidate_value": {"type": "number"}
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": [
        "metric_id",
        "direction",
        "effect",
        "scale",
        "comparator_treatment_id",
        "candidate_treatment_id",
        "status",
        "reason",
        "repeat_count",
        "values"
      ],
      "properties": {
        "metric_id": {"$ref": "#/$defs/safe_id"},
        "direction": {
          "enum": ["higher_is_better", "lower_is_better"]
        },
        "effect": {"enum": ["absolute", "relative"]},
        "scale": {"$ref": "#/$defs/scale"},
        "comparator_treatment_id": {"$ref": "#/$defs/safe_id"},
        "candidate_treatment_id": {"$ref": "#/$defs/safe_id"},
        "status": {"enum": ["complete", "not_evaluable"]},
        "reason": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "repeat_count": {"type": "integer", "minimum": 0},
        "values": {
          "type": "array",
          "items": {"$ref": "#/$defs/case_value"}
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "complete"}}
          },
          "then": {
            "properties": {
              "reason": {"type": "null"},
              "repeat_count": {"type": "integer", "minimum": 1},
              "values": {
                "type": "array",
                "minItems": 2,
                "items": {"$ref": "#/$defs/case_value"}
              }
            }
          },
          "else": {
            "properties": {
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    }
  }
}
