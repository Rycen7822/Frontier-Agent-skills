{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-evaluator/schemas/eval-spec-v5.schema.json",
  "title": "Skill Evaluator evaluation spec v5",
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_id",
    "level",
    "risk_tier",
    "decision",
    "subject",
    "applicability",
    "execution",
    "authority",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 5},
    "evaluation_id": {"$ref": "#/$defs/safe_id"},
    "level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "risk_tier": {"enum": ["low", "standard", "high"]},
    "decision": {"$ref": "#/$defs/decision"},
    "subject": {"$ref": "#/$defs/subject"},
    "applicability": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/module_decision"}
    },
    "execution": {"$ref": "#/$defs/execution"},
    "suite": {"$ref": "#/$defs/suite"},
    "host": {"$ref": "#/$defs/host_binding"},
    "treatments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/treatment"}
    },
    "graders": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/grader"}
    },
    "analysis": {"$ref": "#/$defs/analysis"},
    "hard_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/hard_gate"}
    },
    "authority": {"$ref": "#/$defs/authority"},
    "artifacts": {"$ref": "#/$defs/artifacts"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"level": {"const": "L0"}}, "required": ["level"]},
      "then": {
        "properties": {
          "execution": {
            "allOf": [
              {"properties": {"mode": {"const": "static"}, "ready": {"const": false}}},
              {"not": {"required": ["as_of"]}}
            ]
          }
        },
        "not": {
          "anyOf": [
            {"required": ["suite"]},
            {"required": ["host"]},
            {"required": ["treatments"]},
            {"required": ["graders"]},
            {"required": ["analysis"]},
            {"required": ["hard_gates"]}
          ]
        }
      },
      "else": {
        "required": ["suite", "host", "treatments", "graders", "analysis", "hard_gates"],
        "properties": {
          "execution": {"required": ["as_of"]}
        }
      }
    },
    {
      "if": {"properties": {"level": {"const": "L1"}}, "required": ["level"]},
      "then": {"properties": {"execution": {"properties": {"mode": {"const": "diagnostic"}}}}}
    },
    {
      "if": {"properties": {"level": {"enum": ["L2", "L3", "L4"]}}, "required": ["level"]},
      "then": {
        "properties": {
          "execution": {"properties": {"mode": {"const": "scored"}}},
          "suite": {"required": ["quality", "quality_contract_hash"]}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "rfc3339_seconds": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["kind", "owner", "question", "maximum_claim", "external_authority_boundary"],
      "properties": {
        "kind": {"enum": ["audit", "diagnose", "compare", "readiness", "longitudinal"]},
        "owner": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "maximum_claim": {"type": "string", "minLength": 1},
        "external_authority_boundary": {
          "type": "array",
          "items": {"enum": ["install", "publish", "deploy", "release", "external_write"]}
        }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["skill_id", "name", "version", "shape", "mechanisms", "principal_mode", "claimed_hosts", "package", "claims"],
      "properties": {
        "skill_id": {"$ref": "#/$defs/safe_id"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "shape": {"enum": ["single_skill", "skill_catalog", "ordered_pipeline", "handoff_graph"]},
        "mechanisms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["knowledge_reference", "procedure_workflow", "script_cli", "tool_api_mcp", "hook_guardrail", "stateful", "catalog_routed", "composition_orchestration", "host_adapter", "security_sensitive"]
          }
        },
        "principal_mode": {"enum": ["single", "multiple"]},
        "claimed_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        },
        "package": {
          "type": "object",
          "required": ["path", "package_hash", "repository_revision", "repository_tree", "dirty_state"],
          "properties": {
            "path": {"$ref": "#/$defs/relative_path"},
            "package_hash": {"$ref": "#/$defs/sha256"},
            "repository_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "repository_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "dirty_state": {"enum": ["clean", "declared_dirty"]}
          },
          "additionalProperties": false
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "module_name": {
      "enum": ["core_outcome", "natural_routing", "catalog_routing", "declared_composition", "multi_principal_coordination", "multi_turn_state", "tool_faults", "host_conformance", "dynamic_security", "longitudinal"]
    },
    "module_decision": {
      "type": "object",
      "required": ["module", "status", "reason", "evidence", "approved_by"],
      "properties": {
        "module": {"$ref": "#/$defs/module_name"},
        "status": {"enum": ["required", "not_applicable"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "failure-index-v1.schema.json#/$defs/locator"}
        },
        "approved_by": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["mode", "ready", "timeout_seconds", "reset_policy", "retry_policy", "order_policy", "network_policy", "credential_policy", "max_parallel"],
      "properties": {
        "mode": {"enum": ["static", "diagnostic", "scored"]},
        "ready": {"type": "boolean"},
        "as_of": {"$ref": "#/$defs/rfc3339_seconds"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "reset_policy": {"type": "string", "minLength": 1},
        "retry_policy": {
          "type": "object",
          "required": ["max_attempts", "retryable_apparatus_classes", "backoff_seconds"],
          "properties": {
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 9999},
            "retryable_apparatus_classes": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
            "backoff_seconds": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "order_policy": {"type": "string", "minLength": 1},
        "network_policy": {"type": "string", "minLength": 1},
        "credential_policy": {"type": "string", "minLength": 1},
        "max_parallel": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": [
        "scenarios",
        "public_scenarios",
        "holdout",
        "fixture_set_hash",
        "grader_set_hash",
        "grader_schedule_hash",
        "treatment_contract_hash",
        "repeats",
        "order_seed",
        "reset_policy",
        "retry_policy"
      ],
      "properties": {
        "scenarios": {"$ref": "#/$defs/binding"},
        "public_scenarios": {"$ref": "#/$defs/binding"},
        "holdout": {
          "anyOf": [
            {
              "type": "object",
              "required": ["manifest", "payload", "custodian", "exposure_status"],
              "properties": {
                "manifest": {"$ref": "#/$defs/binding"},
                "payload": {"$ref": "#/$defs/binding"},
                "custodian": {"type": "string", "minLength": 1},
                "exposure_status": {"enum": ["sealed", "exposed", "not_applicable"]}
              },
              "additionalProperties": false
            },
            {"type": "null"}
          ]
        },
        "fixture_set_hash": {"$ref": "#/$defs/sha256"},
        "grader_set_hash": {"$ref": "#/$defs/sha256"},
        "grader_schedule_hash": {"$ref": "#/$defs/sha256"},
        "treatment_contract_hash": {"$ref": "#/$defs/sha256"},
        "calibration": {"$ref": "#/$defs/binding"},
        "quality": {"$ref": "#/$defs/binding"},
        "quality_contract_hash": {"$ref": "#/$defs/sha256"},
        "repeats": {"type": "integer", "minimum": 1},
        "order_seed": {"type": "integer"},
        "reset_policy": {"type": "string", "minLength": 1},
        "retry_policy": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "host_binding": {
      "type": "object",
      "required": ["manifest", "required_capabilities"],
      "properties": {
        "manifest": {"$ref": "#/$defs/binding"},
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "host-manifest-v1.schema.json#/$defs/capability_name"}
        }
      },
      "additionalProperties": false
    },
    "treatment_profile": {
      "enum": ["baseline/skill_disabled", "candidate/natural_routing", "candidate/force_loaded", "prior/natural_routing", "prior/force_loaded", "comparator/raw_instructions", "comparator/alternative_intervention", "comparator/raw_model_upgrade"]
    },
    "treatment": {
      "type": "object",
      "required": [
        "treatment_id",
        "profile",
        "causal_role",
        "prompt_variant_group_id",
        "intervention_axes",
        "model_identity",
        "harness_identity",
        "host_identity",
        "implementation_hash",
        "base_catalog_hash",
        "delivery_transform_hash",
        "tool_policy_hash",
        "permission_policy_hash",
        "network_policy_hash",
        "context_policy_hash",
        "expected_capabilities",
        "scenario_ids",
        "scenario_tags",
        "exclusions",
        "exclusion_reason"
      ],
      "properties": {
        "treatment_id": {"$ref": "#/$defs/safe_id"},
        "profile": {"$ref": "#/$defs/treatment_profile"},
        "causal_role": {"enum": ["baseline", "candidate", "prior", "comparator", "stratum"]},
        "prompt_variant_group_id": {"$ref": "#/$defs/safe_id"},
        "intervention_axes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safe_id"}},
        "model_identity": {"$ref": "#/$defs/sha256"},
        "harness_identity": {"$ref": "#/$defs/sha256"},
        "host_identity": {"$ref": "#/$defs/sha256"},
        "implementation_hash": {"$ref": "#/$defs/sha256"},
        "base_catalog_hash": {"$ref": "#/$defs/sha256"},
        "delivery_transform_hash": {"$ref": "#/$defs/sha256"},
        "tool_policy_hash": {"$ref": "#/$defs/sha256"},
        "permission_policy_hash": {"$ref": "#/$defs/sha256"},
        "network_policy_hash": {"$ref": "#/$defs/sha256"},
        "context_policy_hash": {"$ref": "#/$defs/sha256"},
        "expected_capabilities": {"type": "array", "items": {"$ref": "host-manifest-v1.schema.json#/$defs/capability_name"}},
        "scenario_ids": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "scenario_tags": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "exclusions": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "exclusion_reason": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "grader_check": {
      "type": "object",
      "required": ["check_id", "dimension", "required", "pass_condition"],
      "properties": {
        "check_id": {"$ref": "#/$defs/safe_id"},
        "dimension": {"$ref": "#/$defs/safe_id"},
        "required": {"type": "boolean"},
        "pass_condition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "grader": {
      "oneOf": [
        {
          "type": "object",
          "required": ["grader_id", "type", "checks", "verifier"],
          "properties": {
            "grader_id": {"$ref": "#/$defs/safe_id"},
            "type": {"const": "deterministic"},
            "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/grader_check"}},
            "verifier": {
              "type": "object",
              "required": ["argv", "path", "sha256", "cwd", "env_allowlist", "timeout_seconds", "input_allowlist", "pass_exit_codes"],
              "properties": {
                "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "path": {"$ref": "#/$defs/relative_path"},
                "sha256": {"$ref": "#/$defs/sha256"},
                "cwd": {"$ref": "#/$defs/relative_path"},
                "env_allowlist": {"type": "array", "items": {"type": "string", "minLength": 1}},
                "timeout_seconds": {"type": "integer", "minimum": 1},
                "input_allowlist": {"type": "array", "items": {"$ref": "#/$defs/relative_path"}},
                "pass_exit_codes": {"type": "array", "minItems": 1, "items": {"type": "integer"}}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["grader_id", "type", "checks", "model", "prompt", "output_schema", "batch_schedule_hash"],
          "properties": {
            "grader_id": {"$ref": "#/$defs/safe_id"},
            "type": {"const": "model"},
            "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/grader_check"}},
            "model": {"type": "string", "minLength": 1},
            "prompt": {"$ref": "#/$defs/binding"},
            "output_schema": {"$ref": "#/$defs/binding"},
            "batch_schedule_hash": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      ]
    },
    "analysis": {
      "type": "object",
      "required": ["estimands", "confidence_level", "bootstrap_iterations", "resampling_unit", "slices", "reliability", "materiality"],
      "properties": {
        "estimands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/estimand"}},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "bootstrap_iterations": {"type": "integer", "minimum": 1},
        "resampling_unit": {"const": "case"},
        "slices": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "reliability": {"type": "array", "items": {"enum": ["pass_at_k", "pass_to_k", "observed_consistency"]}},
        "materiality": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}}
      },
      "additionalProperties": false
    },
    "estimand": {
      "type": "object",
      "required": ["estimand_id", "metric", "candidate_treatment_id", "comparator_treatment_id", "direction", "effect", "minimum_benefit", "eligible_modules"],
      "properties": {
        "estimand_id": {"$ref": "#/$defs/safe_id"},
        "metric": {"$ref": "#/$defs/safe_id"},
        "candidate_treatment_id": {"$ref": "#/$defs/safe_id"},
        "comparator_treatment_id": {"$ref": "#/$defs/safe_id"},
        "direction": {"enum": ["higher_is_better", "lower_is_better"]},
        "effect": {"enum": ["absolute", "relative"]},
        "minimum_benefit": {"type": "number"},
        "eligible_modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module_name"}}
      },
      "additionalProperties": false
    },
    "hard_gate": {
      "type": "object",
      "required": ["gate_id", "kind", "metric", "direction", "threshold", "authority", "required"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/safe_id"},
        "kind": {"enum": ["benefit", "noninferiority", "safety", "protected", "context", "quality", "calibration", "host", "module", "manual"]},
        "metric": {"$ref": "#/$defs/safe_id"},
        "direction": {"enum": ["at_least", "at_most", "equal", "present"]},
        "threshold": {"anyOf": [{"type": "number"}, {"type": "string", "minLength": 1}, {"type": "boolean"}]},
        "authority": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["runner_capabilities", "manual_review", "install", "publish", "deploy", "release", "external_writes"],
      "properties": {
        "runner_capabilities": {"type": "array", "items": {"$ref": "#/$defs/safe_id"}},
        "manual_review": {
          "type": "object",
          "required": ["required", "role", "decision_contract_hash"],
          "properties": {
            "required": {"type": "boolean"},
            "role": {"type": "string", "minLength": 1},
            "decision_contract_hash": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
          },
          "additionalProperties": false
        },
        "install": {"type": "boolean"},
        "publish": {"type": "boolean"},
        "deploy": {"type": "boolean"},
        "release": {"type": "boolean"},
        "external_writes": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "required": ["root", "index_relpath", "retention", "redaction", "manifest_required", "cleanup_required", "failure_index_budget"],
      "properties": {
        "root": {"$ref": "#/$defs/relative_path"},
        "index_relpath": {"$ref": "#/$defs/relative_path"},
        "retention": {"type": "string", "minLength": 1},
        "redaction": {"type": "string", "minLength": 1},
        "manifest_required": {"type": "boolean"},
        "cleanup_required": {"type": "boolean"},
        "failure_index_budget": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
