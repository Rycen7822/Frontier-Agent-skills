{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/skill-evaluator/schemas/comparison-plan-v2.schema.json",
  "title": "Skill Evaluator comparison plan v2",
  "type": "object",
  "required": [
    "schema_version",
    "comparison_id",
    "kind",
    "claim_scope",
    "registration",
    "owner_attestation",
    "input_bindings",
    "decision_policy",
    "output"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "comparison_id": {"$ref": "#/$defs/safe_id"},
    "kind": {"enum": ["revision", "model_transition"]},
    "claim_scope": {
      "enum": [
        "diagnostic_only",
        "revision_closure",
        "transition_retention"
      ]
    },
    "registration": {"$ref": "#/$defs/registration"},
    "owner_attestation": {"$ref": "#/$defs/owner_attestation"},
    "input_bindings": {"type": "object"},
    "decision_policy": {"type": "object"},
    "output": {"$ref": "#/$defs/output"}
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "kind": {"const": "revision"},
        "claim_scope": {
          "enum": ["diagnostic_only", "revision_closure"]
        },
        "input_bindings": {"$ref": "#/$defs/revision_bindings"},
        "decision_policy": {"$ref": "#/$defs/revision_policy"}
      }
    },
    {
      "properties": {
        "kind": {"const": "model_transition"},
        "claim_scope": {
          "enum": ["diagnostic_only", "transition_retention"]
        },
        "input_bindings": {"$ref": "#/$defs/transition_ac_bindings"},
        "decision_policy": {
          "allOf": [
            {"$ref": "#/$defs/transition_policy"},
            {
              "properties": {
                "mode": {"enum": ["direct", "combined"]}
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "kind": {"const": "model_transition"},
        "claim_scope": {
          "enum": ["diagnostic_only", "transition_retention"]
        },
        "input_bindings": {"$ref": "#/$defs/transition_bridge_bindings"},
        "decision_policy": {
          "allOf": [
            {"$ref": "#/$defs/transition_policy"},
            {
              "properties": {"mode": {"const": "bridge"}}
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "rfc3339_seconds": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "registration": {
      "type": "object",
      "required": ["mode", "registered_at", "authority_id"],
      "properties": {
        "mode": {"enum": ["pre_registered", "exploratory"]},
        "registered_at": {"$ref": "#/$defs/rfc3339_seconds"},
        "authority_id": {"$ref": "#/$defs/safe_id"}
      },
      "additionalProperties": false
    },
    "owner_attestation": {
      "type": "object",
      "required": ["owner_id", "scope", "attested_at"],
      "properties": {
        "owner_id": {"$ref": "#/$defs/safe_id"},
        "scope": {"$ref": "#/$defs/safe_id"},
        "attested_at": {"$ref": "#/$defs/rfc3339_seconds"}
      },
      "additionalProperties": false
    },
    "bound_artifact": {
      "type": "object",
      "required": ["path", "schema", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "schema": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "expected_identity": {
      "type": "object",
      "required": [
        "evaluation_id",
        "plan_id",
        "execution_profile"
      ],
      "properties": {
        "evaluation_id": {"$ref": "#/$defs/safe_id"},
        "plan_id": {"$ref": "#/$defs/safe_id"},
        "execution_profile": {
          "$ref": "execution-plan-v2.schema.json#/$defs/execution_profile"
        }
      },
      "additionalProperties": false
    },
    "cycle_binding": {
      "type": "object",
      "required": ["cycle_id", "expected_identity", "capsule"],
      "properties": {
        "cycle_id": {"$ref": "#/$defs/safe_id"},
        "expected_identity": {"$ref": "#/$defs/expected_identity"},
        "capsule": {
          "allOf": [
            {"$ref": "#/$defs/bound_artifact"},
            {"properties": {"schema": {"const": "comparison-cycle-capsule/2"}}}
          ]
        }
      },
      "additionalProperties": false
    },
    "revision_bindings": {
      "type": "object",
      "required": ["prior", "candidate"],
      "properties": {
        "prior": {
          "$ref": "#/$defs/cycle_binding"
        },
        "candidate": {"$ref": "#/$defs/cycle_binding"}
      },
      "additionalProperties": false
    },
    "transition_cycle_binding": {"$ref": "#/$defs/cycle_binding"},
    "transition_ac_bindings": {
      "type": "object",
      "required": ["A", "C"],
      "properties": {
        "A": {"$ref": "#/$defs/transition_cycle_binding"},
        "C": {"$ref": "#/$defs/transition_cycle_binding"}
      },
      "additionalProperties": false
    },
    "transition_bridge_bindings": {
      "type": "object",
      "required": ["A", "B", "C"],
      "properties": {
        "A": {"$ref": "#/$defs/transition_cycle_binding"},
        "B": {"$ref": "#/$defs/transition_cycle_binding"},
        "C": {"$ref": "#/$defs/transition_cycle_binding"}
      },
      "additionalProperties": false
    },
    "revision_target": {
      "type": "object",
      "required": [
        "failure_class",
        "diagnostic_ids",
        "case_ids",
        "requirement_ids"
      ],
      "properties": {
        "failure_class": {"$ref": "#/$defs/safe_id"},
        "diagnostic_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^sf-[0-9a-f]{24}$"}
        },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        }
      },
      "additionalProperties": false
    },
    "change_set": {
      "type": "object",
      "required": ["category", "paths", "candidate_revision"],
      "properties": {
        "category": {
          "enum": [
            "instruction",
            "reference",
            "script",
            "schema",
            "test",
            "package"
          ]
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relative_path"}
        },
        "candidate_revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "revision_metric_rule": {
      "type": "object",
      "required": ["purpose", "metric_id", "direction", "margin"],
      "properties": {
        "purpose": {
          "enum": ["target_improvement", "protected_noninferiority"]
        },
        "metric_id": {"$ref": "#/$defs/safe_id"},
        "direction": {
          "enum": ["higher_is_better", "lower_is_better"]
        },
        "margin": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "revision_policy": {
      "type": "object",
      "required": [
        "kind",
        "target",
        "change_set",
        "metric_rules",
        "minimum_distinct_cases",
        "required_gates",
        "require_candidate_failure_index"
      ],
      "properties": {
        "kind": {"const": "revision"},
        "target": {"$ref": "#/$defs/revision_target"},
        "change_set": {"$ref": "#/$defs/change_set"},
        "metric_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/revision_metric_rule"}
        },
        "minimum_distinct_cases": {"type": "integer", "minimum": 2},
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["safety", "protected", "context"]}
        },
        "require_candidate_failure_index": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "transition_metric_rule": {
      "type": "object",
      "required": ["purpose", "metric_id", "direction", "threshold"],
      "properties": {
        "purpose": {
          "enum": [
            "gain_retention",
            "protected_noninferiority",
            "interference",
            "specialization",
            "native_capability"
          ]
        },
        "metric_id": {"$ref": "#/$defs/safe_id"},
        "direction": {
          "enum": ["higher_is_better", "lower_is_better"]
        },
        "threshold": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "stage_rule": {
      "type": "object",
      "required": [
        "purpose",
        "surface",
        "stage",
        "minimum_retention"
      ],
      "properties": {
        "purpose": {"enum": ["routing", "loading", "application"]},
        "surface": {
          "enum": [
            "skill_tool_access",
            "action_effect",
            "plan",
            "review",
            "safety",
            "grounding"
          ]
        },
        "stage": {"$ref": "#/$defs/safe_id"},
        "minimum_retention": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "transition_policy": {
      "type": "object",
      "required": [
        "kind",
        "mode",
        "metric_rules",
        "stage_rules",
        "minimum_distinct_cases",
        "required_gates",
        "token_policy",
        "judge_policy",
        "apparatus_change_fields"
      ],
      "properties": {
        "kind": {"const": "model_transition"},
        "mode": {"enum": ["direct", "bridge", "combined"]},
        "metric_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/transition_metric_rule"}
        },
        "stage_rules": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/stage_rule"}
        },
        "minimum_distinct_cases": {"type": "integer", "minimum": 2},
        "required_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["safety", "protected", "context"]}
        },
        "token_policy": {
          "enum": ["require_same_tokenizer", "bytes_only_if_changed"]
        },
        "judge_policy": {
          "enum": ["require_same_judge", "bridge_required_if_changed"]
        },
        "apparatus_change_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "host_version",
              "harness_version",
              "prompt_id",
              "tool_schema_id",
              "policy_id",
              "platform",
              "tokenizer_id",
              "pricing_id",
              "utc_clock_id",
              "monotonic_clock_id"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["root", "report", "diagnostic_index"],
      "properties": {
        "root": {"$ref": "#/$defs/relative_path"},
        "report": {"const": "comparison-report.json"},
        "diagnostic_index": {
          "const": "comparison-diagnostic-index.json"
        }
      },
      "additionalProperties": false
    }
  }
}
