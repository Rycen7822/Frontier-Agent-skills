{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier.local/model-evolution/manual-authority-packet-v1.schema.json",
  "title": "Confirmatory manual authority packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "revision_reports", "holdout", "decision", "custodian_id", "signed_attestation"],
  "properties": {
    "schema_version": {"const": "manual-authority-packet/1"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "revision_reports": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "holdout": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approve", "hold", "reject"]},
    "custodian_id": {"const": "confirmatory-manual-custodian"},
    "signed_attestation": {"type": "string", "minLength": 1}
  }
}
