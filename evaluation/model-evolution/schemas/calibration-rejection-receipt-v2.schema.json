{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier.local/model-evolution/calibration-rejection-receipt-v2.schema.json",
  "title": "Frontier model evolution calibration rejection receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "state_revision", "qualification",
    "preparation", "skill_id", "classification", "labels", "ratings",
    "request_count", "thresholds", "check_metrics", "failed_checks", "requests"
  ],
  "properties": {
    "schema_version": {"const": "model-evolution-calibration-rejection-receipt/2"},
    "campaign_id": {"$ref": "#/$defs/safe_id"},
    "state_revision": {"type": "integer", "minimum": 0},
    "qualification": {"$ref": "#/$defs/campaign_ref"},
    "preparation": {"$ref": "#/$defs/campaign_ref"},
    "skill_id": {"$ref": "#/$defs/skill_id"},
    "classification": {"const": "completed_turns_rejected_by_calibration_threshold"},
    "labels": {"$ref": "#/$defs/external_binding"},
    "ratings": {"$ref": "#/$defs/external_binding"},
    "request_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_agreement", "minimum_examples"],
      "properties": {
        "minimum_agreement": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_examples": {"type": "integer", "minimum": 1}
      }
    },
    "check_metrics": {"type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["check_id", "sample_count", "agreement"],
        "properties": {
          "check_id": {"$ref": "#/$defs/safe_id"},
          "sample_count": {"type": "integer", "minimum": 1},
          "agreement": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "failed_checks": {"type": "array", "minItems": 1, "maxItems": 16,
      "uniqueItems": true, "items": {"$ref": "#/$defs/safe_id"}},
    "requests": {"type": "array", "minItems": 1, "maxItems": 64,
      "items": {"type": "object", "additionalProperties": false,
        "required": [
          "entry_ordinal", "entry_id", "request_id", "check_id",
          "terminal_status", "host_result", "terminal"
        ],
        "properties": {
          "entry_ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
          "entry_id": {"$ref": "#/$defs/safe_id"},
          "request_id": {"$ref": "#/$defs/safe_id"},
          "check_id": {"$ref": "#/$defs/safe_id"},
          "terminal_status": {"const": "completed"},
          "host_result": {"$ref": "#/$defs/external_binding"},
          "terminal": {"$ref": "#/$defs/external_binding"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "skill_id": {"enum": [
      "long-document-segmented-writing", "skill-evaluator",
      "software-quality-workflows", "writing-plans"
    ]},
    "campaign_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "path", "schema_version"],
      "properties": {
        "root": {"const": "campaign"}, "path": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "external_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "path", "digest", "schema_version"],
      "properties": {
        "root": {"const": "external"}, "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/hash"},
        "schema_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
