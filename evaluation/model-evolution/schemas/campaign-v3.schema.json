{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier.local/model-evolution/campaign-v3.schema.json",
  "title": "Frontier model evolution campaign v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "state_revision",
    "phase",
    "apparatus_report",
    "product",
    "profiles",
    "interaction_probes",
    "sentinel_index",
    "budgets",
    "plans",
    "skill_evidence",
    "candidate"
  ],
  "properties": {
    "schema_version": {"const": "model-evolution-campaign/3"},
    "campaign_id": {"$ref": "#/$defs/safe_id"},
    "state_revision": {"type": "integer", "minimum": 0},
    "phase": {
      "enum": [
        "declared",
        "apparatus_ready",
        "target_profile_ready",
        "calibration_ready",
        "current_evidence_ready",
        "decision_ready",
        "candidate_registered",
        "candidate_evidence_ready",
        "final_plugin_ready",
        "holdout_ready"
      ]
    },
    "apparatus_report": {"$ref": "#/$defs/nullable_binding"},
    "product": {"$ref": "#/$defs/product"},
    "profiles": {"$ref": "#/$defs/profiles"},
    "interaction_probes": {"$ref": "#/$defs/interaction_probes"},
    "sentinel_index": {"$ref": "#/$defs/binding"},
    "apparatus_retry_policy": {"$ref": "#/$defs/nullable_binding"},
    "host_artifact_authority": {"$ref": "#/$defs/nullable_binding"},
    "budgets": {"$ref": "#/$defs/budgets"},
    "plans": {"type": "array", "items": {"$ref": "#/$defs/plan"}},
    "plan_replacement_lineage": {
      "type": "array",
      "items": {"$ref": "#/$defs/plan_replacement"}
    },
    "product_rebind_lineage": {
      "type": "array",
      "items": {"$ref": "#/$defs/product_rebind"}
    },
    "current_evidence_refresh_lineage": {
      "type": "array",
      "maxItems": 1,
      "items": {"$ref": "#/$defs/current_evidence_refresh"}
    },
    "skill_evidence": {"$ref": "#/$defs/skill_evidence"},
    "candidate": {"anyOf": [{"$ref": "#/$defs/candidate"}, {"type": "null"}]}
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "binding": {
      "oneOf": [
        {"$ref": "#/$defs/repository_ref"},
        {"$ref": "#/$defs/campaign_ref"},
        {"$ref": "#/$defs/external_binding"}
      ]
    },
    "repository_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path"],
      "properties": {
        "root": {"const": "repository"},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[A-Za-z0-9._/-]+$"
        }
      }
    },
    "campaign_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path", "schema_version"],
      "properties": {
        "root": {"const": "campaign"},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[A-Za-z0-9._/-]+$"
        },
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "external_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path", "digest", "schema_version"],
      "properties": {
        "root": {"const": "external"},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[A-Za-z0-9._/-]+$"
        },
        "digest": {"$ref": "#/$defs/hash"},
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "nullable_binding": {
      "anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]
    },
    "skill_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "root_hash", "allow_implicit_invocation"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "root_hash": {"$ref": "#/$defs/hash"},
        "allow_implicit_invocation": {"type": "boolean"}
      }
    },
    "skill_identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "long-document-segmented-writing",
        "skill-evaluator",
        "software-quality-workflows",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"$ref": "#/$defs/skill_identity"},
        "skill-evaluator": {"$ref": "#/$defs/skill_identity"},
        "software-quality-workflows": {"$ref": "#/$defs/skill_identity"},
        "writing-plans": {"$ref": "#/$defs/skill_identity"}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_version",
        "source_commit",
        "source_tree",
        "dirty",
        "plugin_tree",
        "plugin_build",
        "plugin_root",
        "calibration_requests",
        "bundle_manifest",
        "bundle_build",
        "static_gate",
        "skills"
      ],
      "properties": {
        "bundle_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "bundle_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "source_commit": {"$ref": "#/$defs/git_commit"},
        "source_tree": {"$ref": "#/$defs/git_commit"},
        "dirty": {"const": false},
        "plugin_tree": {"$ref": "#/$defs/hash"},
        "plugin_build": {"$ref": "#/$defs/binding"},
        "plugin_root": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[A-Za-z0-9._/-]+$"
        },
        "calibration_requests": {"type": "integer", "minimum": 1},
        "bundle_manifest": {"$ref": "#/$defs/binding"},
        "bundle_build": {"$ref": "#/$defs/binding"},
        "static_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "status"],
          "properties": {
            "schema_version": {"const": "static-contract-diagnostic/1.0"},
            "status": {"const": "pass"}
          }
        },
        "skills": {"$ref": "#/$defs/skill_identities"}
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle",
        "host",
        "plugin_tree_digest",
        "qualification"
      ],
      "properties": {
        "cycle": {"$ref": "#/$defs/binding"},
        "host": {"$ref": "#/$defs/binding"},
        "plugin_tree_digest": {"$ref": "#/$defs/hash"},
        "qualification": {"$ref": "#/$defs/nullable_binding"}
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor", "target_provisional", "target_observed"],
      "properties": {
        "predecessor": {
          "anyOf": [{"$ref": "#/$defs/predecessor"}, {"type": "null"}]
        },
        "target_provisional": {"$ref": "#/$defs/binding"},
        "target_observed": {"$ref": "#/$defs/nullable_binding"}
      }
    },
    "probe_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "probe_id", "status", "artifact", "result_status"],
      "properties": {
        "request_id": {"$ref": "#/$defs/safe_id"},
        "probe_id": {"$ref": "#/$defs/safe_id"},
        "status": {"enum": ["reserved", "closed", "blocked"]},
        "artifact": {"$ref": "#/$defs/nullable_binding"},
        "result_status": {
          "type": ["string", "null"],
          "enum": ["pass", "unsupported", "unknown", null]
        }
      }
    },
    "interaction_probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_set", "results", "requests", "blocker"],
      "properties": {
        "probe_set": {"$ref": "#/$defs/binding"},
        "results": {"$ref": "#/$defs/nullable_binding"},
        "requests": {
          "type": "array",
          "maxItems": 6,
          "items": {"$ref": "#/$defs/probe_request"}
        },
        "blocker": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_requests",
        "execute",
        "model_grade",
        "reviewer",
        "optimizer",
        "download_bytes",
        "artifact_bytes",
        "candidates"
      ],
      "properties": {
        "provider_requests": {"type": ["integer", "null"], "minimum": 0},
        "execute": {"type": ["integer", "null"], "minimum": 0},
        "model_grade": {"type": ["integer", "null"], "minimum": 0},
        "reviewer": {"type": ["integer", "null"], "minimum": 0},
        "optimizer": {"type": ["integer", "null"], "minimum": 0},
        "download_bytes": {"type": ["integer", "null"], "minimum": 0},
        "artifact_bytes": {"type": ["integer", "null"], "minimum": 0},
        "candidates": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceiling", "reserved", "observed", "candidate_count"],
      "properties": {
        "ceiling": {"$ref": "#/$defs/counts"},
        "reserved": {"$ref": "#/$defs/counts"},
        "observed": {"$ref": "#/$defs/counts"},
        "candidate_count": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "skill_id",
        "plan",
        "plan_digest",
        "host_id",
        "host_version",
        "execute_ceiling",
        "model_grade_ceiling",
        "runner_status"
      ],
      "properties": {
        "role": {
          "enum": [
            "target_current",
            "target_candidate",
            "target_prior",
            "target_holdout"
          ]
        },
        "skill_id": {"$ref": "#/$defs/skill_id"},
        "plan": {"$ref": "#/$defs/campaign_ref"},
        "plan_digest": {"$ref": "#/$defs/hash"},
        "host_id": {"$ref": "#/$defs/safe_id"},
        "host_version": {"type": "string", "minLength": 1},
        "execute_ceiling": {"type": "integer", "minimum": 0},
        "model_grade_ceiling": {"type": "integer", "minimum": 0},
        "runner_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed", "total", "failed"],
          "properties": {
            "completed": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "plan_replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "skill_id",
        "plan_digest",
        "registered_state_revision"
      ],
      "properties": {
        "role": {
          "enum": [
            "target_current",
            "target_candidate",
            "target_prior",
            "target_holdout"
          ]
        },
        "skill_id": {"$ref": "#/$defs/skill_id"},
        "plan_digest": {"$ref": "#/$defs/hash"},
        "registered_state_revision": {"type": "integer", "minimum": 1}
      }
    },
    "product_rebind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_product",
        "new_product",
        "unchanged_skill_digests",
        "old_apparatus_report",
        "new_apparatus_report",
        "old_target_provisional",
        "new_target_provisional",
        "old_target_observed",
        "new_target_observed",
        "old_writing_plans_summary",
        "rebound_state_revision"
      ],
      "properties": {
        "old_product": {"$ref": "#/$defs/product"},
        "new_product": {"$ref": "#/$defs/product"},
        "unchanged_skill_digests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "long-document-segmented-writing",
            "skill-evaluator",
            "software-quality-workflows"
          ],
          "properties": {
            "long-document-segmented-writing": {"$ref": "#/$defs/hash"},
            "skill-evaluator": {"$ref": "#/$defs/hash"},
            "software-quality-workflows": {"$ref": "#/$defs/hash"}
          }
        },
        "old_apparatus_report": {"$ref": "#/$defs/nullable_binding"},
        "new_apparatus_report": {"$ref": "#/$defs/binding"},
        "old_target_provisional": {"$ref": "#/$defs/binding"},
        "new_target_provisional": {"$ref": "#/$defs/binding"},
        "old_target_observed": {"$ref": "#/$defs/nullable_binding"},
        "new_target_observed": {"$ref": "#/$defs/binding"},
        "old_writing_plans_summary": {"$ref": "#/$defs/binding"},
        "rebound_state_revision": {"type": "integer", "minimum": 1}
      }
    },
    "refreshed_current_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_current_summary",
        "old_current_summary_digest",
        "old_plan",
        "old_plan_digest",
        "unchanged_skill_digest",
        "old_plugin_build",
        "old_plugin_build_digest"
      ],
      "properties": {
        "old_current_summary": {"$ref": "#/$defs/binding"},
        "old_current_summary_digest": {"$ref": "#/$defs/hash"},
        "old_plan": {"$ref": "#/$defs/campaign_ref"},
        "old_plan_digest": {"$ref": "#/$defs/hash"},
        "unchanged_skill_digest": {"$ref": "#/$defs/hash"},
        "old_plugin_build": {"$ref": "#/$defs/binding"},
        "old_plugin_build_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "retained_current_skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_summary",
        "current_summary_digest",
        "plan",
        "plan_digest",
        "plugin_build",
        "plugin_build_digest",
        "source_commit",
        "skill_digest",
        "catalog_digest"
      ],
      "properties": {
        "current_summary": {"$ref": "#/$defs/binding"},
        "current_summary_digest": {"$ref": "#/$defs/hash"},
        "plan": {"$ref": "#/$defs/campaign_ref"},
        "plan_digest": {"$ref": "#/$defs/hash"},
        "plugin_build": {"$ref": "#/$defs/binding"},
        "plugin_build_digest": {"$ref": "#/$defs/hash"},
        "source_commit": {"$ref": "#/$defs/git_commit"},
        "skill_digest": {"$ref": "#/$defs/hash"},
        "catalog_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "current_evidence_refresh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "product_rebind_state_revision",
        "refresh_before_state_revision",
        "refresh_after_state_revision",
        "old_product",
        "new_product",
        "refresh_set",
        "refreshed_skills",
        "retained_writing_plans"
      ],
      "properties": {
        "reason": {"const": "bundle_revision_full_product_alignment"},
        "product_rebind_state_revision": {"type": "integer", "minimum": 1},
        "refresh_before_state_revision": {"const": 26},
        "refresh_after_state_revision": {"const": 27},
        "old_product": {"$ref": "#/$defs/product"},
        "new_product": {"$ref": "#/$defs/product"},
        "refresh_set": {
          "type": "array",
          "prefixItems": [
            {"const": "long-document-segmented-writing"},
            {"const": "skill-evaluator"},
            {"const": "software-quality-workflows"}
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "refreshed_skills": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "long-document-segmented-writing",
            "skill-evaluator",
            "software-quality-workflows"
          ],
          "properties": {
            "long-document-segmented-writing": {"$ref": "#/$defs/refreshed_current_skill"},
            "skill-evaluator": {"$ref": "#/$defs/refreshed_current_skill"},
            "software-quality-workflows": {"$ref": "#/$defs/refreshed_current_skill"}
          }
        },
        "retained_writing_plans": {"$ref": "#/$defs/retained_current_skill"}
      }
    },
    "skill_id": {
      "enum": [
        "long-document-segmented-writing",
        "skill-evaluator",
        "software-quality-workflows",
        "writing-plans"
      ]
    },
    "skill_evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grader_calibration",
        "current_summary",
        "transition_report",
        "candidate_summary",
        "revision_report",
        "holdout_summary"
      ],
      "properties": {
        "grader_calibration": {"$ref": "#/$defs/nullable_binding"},
        "current_summary": {"$ref": "#/$defs/nullable_binding"},
        "transition_report": {"$ref": "#/$defs/nullable_binding"},
        "candidate_summary": {"$ref": "#/$defs/nullable_binding"},
        "revision_report": {"$ref": "#/$defs/nullable_binding"},
        "holdout_summary": {"$ref": "#/$defs/nullable_binding"}
      }
    },
    "skill_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "long-document-segmented-writing",
        "skill-evaluator",
        "software-quality-workflows",
        "writing-plans",
        "plugin_build"
      ],
      "properties": {
        "long-document-segmented-writing": {"$ref": "#/$defs/skill_evidence_item"},
        "skill-evaluator": {"$ref": "#/$defs/skill_evidence_item"},
        "software-quality-workflows": {"$ref": "#/$defs/skill_evidence_item"},
        "writing-plans": {"$ref": "#/$defs/skill_evidence_item"},
        "plugin_build": {"$ref": "#/$defs/nullable_binding"}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "status", "duration_ms", "state_revision", "exit_code", "diagnostic"],
      "properties": {
        "operation_id": {"$ref": "#/$defs/safe_id"},
        "status": {"enum": ["pass", "fail"]},
        "duration_ms": {"type": "integer", "minimum": 0},
        "state_revision": {"type": "integer", "minimum": 0},
        "exit_code": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
        "diagnostic": {"anyOf": [{"type": "string", "maxLength": 500}, {"type": "null"}]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_commit",
        "candidate_commit",
        "candidate_tree",
        "changed_paths",
        "root_cause_ids",
        "owner_surface",
        "skills",
        "semantic_changes",
        "operations"
      ],
      "properties": {
        "base_commit": {"$ref": "#/$defs/git_commit"},
        "candidate_commit": {"$ref": "#/$defs/git_commit"},
        "candidate_tree": {"$ref": "#/$defs/git_commit"},
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"}
        },
        "root_cause_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safe_id"}
        },
        "owner_surface": {"$ref": "#/$defs/skill_id"},
        "skills": {"$ref": "#/$defs/skill_identities"},
        "semantic_changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/operation"}
        }
      }
    }
  }
}
