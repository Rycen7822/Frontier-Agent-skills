{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier.local/model-evolution/failure-receipt-v2.schema.json",
  "title": "Frontier model evolution failed-request receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "campaign_id", "state_revision", "qualification",
    "preparation", "skill_id", "request_kind", "classification",
    "request_count", "outcomes", "requests"
  ],
  "properties": {
    "schema_version": {"const": "model-evolution-failure-receipt/2"},
    "campaign_id": {"$ref": "#/$defs/safe_id"},
    "state_revision": {"type": "integer", "minimum": 0},
    "qualification": {"$ref": "#/$defs/campaign_ref"},
    "preparation": {"$ref": "#/$defs/campaign_ref"},
    "skill_id": {"$ref": "#/$defs/skill_id"},
    "request_kind": {"const": "model_grade"},
    "classification": {"const": "host_failed_before_completed_turn"},
    "request_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "outcomes": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout", "failed"],
      "properties": {
        "timeout": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "requests": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "entry_ordinal", "entry_id", "request_id", "terminal_status",
          "failure_class", "host_result", "host_stderr"
        ],
        "properties": {
          "entry_ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
          "entry_id": {"$ref": "#/$defs/safe_id"},
          "request_id": {"$ref": "#/$defs/safe_id"},
          "terminal_status": {"enum": ["timeout", "failed"]},
          "failure_class": {"enum": ["model_task_timeout", "provider_nonretryable"]},
          "host_result": {"$ref": "#/$defs/external_binding"},
          "host_stderr": {"$ref": "#/$defs/external_binding"}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "skill_id": {"enum": [
      "long-document-segmented-writing", "skill-evaluator",
      "software-quality-workflows", "writing-plans"
    ]},
    "campaign_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "path", "schema_version"],
      "properties": {
        "root": {"const": "campaign"}, "path": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "external_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "path", "digest", "schema_version"],
      "properties": {
        "root": {"const": "external"}, "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/hash"},
        "schema_version": {"type": "string", "minLength": 1}
      }
    }
  }
}
