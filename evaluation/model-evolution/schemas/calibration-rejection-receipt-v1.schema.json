{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier.local/model-evolution/calibration-rejection-receipt-v1.schema.json",
  "title": "Frontier model evolution completed calibration rejection receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_hash",
    "qualification",
    "preparation",
    "skill_id",
    "classification",
    "labels",
    "ratings",
    "request_count",
    "thresholds",
    "check_metrics",
    "failed_checks",
    "requests",
    "calibration_rejection_receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "model-evolution-calibration-rejection-receipt/1"},
    "campaign_hash": {"$ref": "#/$defs/hash"},
    "qualification": {"$ref": "#/$defs/binding"},
    "preparation": {"$ref": "#/$defs/binding"},
    "skill_id": {"$ref": "#/$defs/skill_id"},
    "classification": {"const": "completed_turns_rejected_by_calibration_threshold"},
    "labels": {"$ref": "#/$defs/binding"},
    "ratings": {"$ref": "#/$defs/binding"},
    "request_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_agreement", "minimum_examples"],
      "properties": {
        "minimum_agreement": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_examples": {"type": "integer", "minimum": 1}
      }
    },
    "check_metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "sample_count", "agreement"],
        "properties": {
          "check_id": {"$ref": "#/$defs/safe_id"},
          "sample_count": {"type": "integer", "minimum": 1},
          "agreement": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "failed_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safe_id"}
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_ordinal",
          "entry_id",
          "request_hash",
          "payload_hash",
          "check_id",
          "terminal_status",
          "host_result",
          "terminal"
        ],
        "properties": {
          "entry_ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
          "entry_id": {"$ref": "#/$defs/safe_id"},
          "request_hash": {"$ref": "#/$defs/hash"},
          "payload_hash": {"$ref": "#/$defs/hash"},
          "check_id": {"$ref": "#/$defs/safe_id"},
          "terminal_status": {"const": "completed"},
          "host_result": {"$ref": "#/$defs/binding"},
          "terminal": {"$ref": "#/$defs/binding"}
        }
      }
    },
    "calibration_rejection_receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "skill_id": {
      "enum": [
        "long-document-segmented-writing",
        "skill-evaluator",
        "software-quality-workflows",
        "writing-plans"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "root", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "root": {"enum": ["repository", "campaign"]},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
