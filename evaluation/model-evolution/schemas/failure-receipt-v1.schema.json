{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier.local/model-evolution/failure-receipt-v1.schema.json",
  "title": "Frontier model evolution failed-request receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_hash",
    "qualification",
    "preparation",
    "skill_id",
    "request_kind",
    "classification",
    "request_count",
    "outcomes",
    "requests",
    "failure_receipt_hash"
  ],
  "properties": {
    "schema_version": {"const": "model-evolution-failure-receipt/1"},
    "campaign_hash": {"$ref": "#/$defs/hash"},
    "qualification": {"$ref": "#/$defs/binding"},
    "preparation": {"$ref": "#/$defs/binding"},
    "skill_id": {"$ref": "#/$defs/skill_id"},
    "request_kind": {"const": "model_grade"},
    "classification": {"const": "host_failed_before_completed_turn"},
    "request_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout", "failed"],
      "properties": {
        "timeout": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_ordinal",
          "entry_id",
          "request_hash",
          "terminal_status",
          "failure_class",
          "host_result",
          "host_stderr"
        ],
        "properties": {
          "entry_ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
          "entry_id": {"$ref": "#/$defs/safe_id"},
          "request_hash": {"$ref": "#/$defs/hash"},
          "terminal_status": {"enum": ["timeout", "failed"]},
          "failure_class": {
            "enum": ["model_task_timeout", "provider_nonretryable"]
          },
          "host_result": {"$ref": "#/$defs/binding"},
          "host_stderr": {"$ref": "#/$defs/binding"}
        }
      }
    },
    "failure_receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "skill_id": {
      "enum": [
        "long-document-segmented-writing",
        "skill-evaluator",
        "software-quality-workflows",
        "writing-plans"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "root", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "root": {"enum": ["repository", "campaign"]},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
