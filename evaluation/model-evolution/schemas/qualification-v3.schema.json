{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier.local/model-evolution/qualification-v3.schema.json",
  "title": "Frontier model qualification v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "campaign_id",
    "terminal_state_revision",
    "identity",
    "claim",
    "lanes",
    "skills",
    "gates",
    "budget",
    "decision",
    "limits",
    "blockers",
    "validity",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "model-qualification/3"},
    "qualification_id": {"$ref": "#/$defs/safe_id"},
    "campaign_id": {"$ref": "#/$defs/safe_id"},
    "terminal_state_revision": {"type": "integer", "minimum": 0},
    "identity": {"$ref": "#/$defs/identity"},
    "claim": {"$ref": "#/$defs/claim"},
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static_product",
        "host_integration",
        "manual_authority",
        "task_behavior",
        "protected_safety",
        "routing",
        "operational_cost",
        "loop_pathology",
        "longitudinal"
      ],
      "properties": {
        "static_product": {"$ref": "#/$defs/lane"},
        "host_integration": {"$ref": "#/$defs/lane"},
        "manual_authority": {"$ref": "#/$defs/lane"},
        "task_behavior": {"$ref": "#/$defs/task_lane"},
        "protected_safety": {"$ref": "#/$defs/lane"},
        "routing": {"$ref": "#/$defs/lane"},
        "operational_cost": {"$ref": "#/$defs/lane"},
        "loop_pathology": {"$ref": "#/$defs/lane"},
        "longitudinal": {"$ref": "#/$defs/lane"}
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "long-document-segmented-writing",
        "skill-evaluator",
        "software-quality-workflows",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"$ref": "#/$defs/skill_result"},
        "skill-evaluator": {"$ref": "#/$defs/skill_result"},
        "software-quality-workflows": {"$ref": "#/$defs/skill_result"},
        "writing-plans": {"$ref": "#/$defs/skill_result"}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/gate"}
    },
    "budget": {"$ref": "#/$defs/budget"},
    "decision": {"enum": ["qualified", "qualified_with_limits", "blocked"]},
    "limits": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "validity": {"$ref": "#/$defs/validity"},
    "evidence_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_ref"}
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "binding": {
      "oneOf": [
        {"$ref": "#/$defs/repository_ref"},
        {"$ref": "#/$defs/campaign_ref"},
        {"$ref": "#/$defs/external_binding"}
      ]
    },
    "repository_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path"],
      "properties": {
        "root": {"const": "repository"},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[A-Za-z0-9._/-]+$"
        }
      }
    },
    "campaign_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path", "schema_version"],
      "properties": {
        "root": {"const": "campaign"},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[A-Za-z0-9._/-]+$"
        },
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "external_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "path", "digest", "schema_version"],
      "properties": {
        "root": {"const": "external"},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)[A-Za-z0-9._/-]+$"
        },
        "digest": {"$ref": "#/$defs/hash"},
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "receipt_paths", "raw_artifact_paths"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/safe_id"},
        "receipt_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "raw_artifact_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "skill_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "root_hash", "allow_implicit_invocation"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "root_hash": {"$ref": "#/$defs/hash"},
        "allow_implicit_invocation": {"type": "boolean"}
      }
    },
    "skill_identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "long-document-segmented-writing",
        "skill-evaluator",
        "software-quality-workflows",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"$ref": "#/$defs/skill_identity"},
        "skill-evaluator": {"$ref": "#/$defs/skill_identity"},
        "software-quality-workflows": {"$ref": "#/$defs/skill_identity"},
        "writing-plans": {"$ref": "#/$defs/skill_identity"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_version",
        "source_revision",
        "source_tree_hash",
        "plugin_tree_hash",
        "skills",
        "target_observed_host"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "bundle_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree_hash": {"$ref": "#/$defs/hash"},
        "plugin_tree_hash": {"$ref": "#/$defs/hash"},
        "skills": {"$ref": "#/$defs/skill_identities"},
        "target_observed_host": {
          "anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_model_revision",
        "activation_modes",
        "skill_scope",
        "task_version",
        "sentinel_version",
        "ceiling"
      ],
      "properties": {
        "host_model_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "activation_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["catalog", "force_loaded", "skill_disabled"]}
        },
        "skill_scope": {
          "type": "array",
          "prefixItems": [
            {"const": "long-document-segmented-writing"},
            {"const": "skill-evaluator"},
            {"const": "software-quality-workflows"},
            {"const": "writing-plans"}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "task_version": {"$ref": "#/$defs/safe_id"},
        "sentinel_version": {"$ref": "#/$defs/safe_id"},
        "ceiling": {"enum": ["full", "bounded", "diagnostic_only"]}
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["pass", "blocked", "unobserved", "not_applicable"]},
        "evidence": {"anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]}
      }
    },
    "task_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["pass", "blocked", "unobserved", "not_applicable", "limited_native_absorption"]},
        "evidence": {"anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]}
      }
    },
    "skill_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_behavior",
        "protected_safety",
        "routing",
        "operational_cost",
        "loop_pathology",
        "transition",
        "revision",
        "holdout",
        "blocker"
      ],
      "properties": {
        "task_behavior": {"enum": ["pass", "blocked", "unobserved", "not_applicable", "limited_native_absorption"]},
        "protected_safety": {"enum": ["pass", "blocked", "unobserved", "not_applicable"]},
        "routing": {"enum": ["pass", "blocked", "unobserved", "not_applicable"]},
        "operational_cost": {"enum": ["pass", "blocked", "unobserved", "not_applicable"]},
        "loop_pathology": {"enum": ["pass", "blocked", "unobserved", "not_applicable"]},
        "transition": {"enum": ["pass", "blocked", "unobserved", "not_applicable"]},
        "revision": {"enum": ["pass", "blocked", "unobserved", "not_applicable"]},
        "holdout": {"enum": ["pass", "blocked", "unobserved", "not_applicable"]},
        "blocker": {"anyOf": [{"$ref": "#/$defs/safe_id"}, {"type": "null"}]}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "evidence", "reason_code"],
      "properties": {
        "gate_id": {
          "enum": [
            "apparatus",
            "identity_comparability",
            "manual_authority",
            "critical_function",
            "safety_protected",
            "routing",
            "operational_cost",
            "loop_pathology",
            "incremental_value",
            "revision",
            "statistical_support",
            "release_identity"
          ]
        },
        "status": {"enum": ["pass", "blocked", "unobserved", "not_applicable", "limited_native_absorption"]},
        "evidence": {"anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]},
        "reason_code": {"anyOf": [{"$ref": "#/$defs/safe_id"}, {"type": "null"}]}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_requests",
        "execute",
        "model_grade",
        "reviewer",
        "optimizer",
        "download_bytes",
        "artifact_bytes",
        "candidates"
      ],
      "properties": {
        "provider_requests": {"type": ["integer", "null"], "minimum": 0},
        "execute": {"type": ["integer", "null"], "minimum": 0},
        "model_grade": {"type": ["integer", "null"], "minimum": 0},
        "reviewer": {"type": ["integer", "null"], "minimum": 0},
        "optimizer": {"type": ["integer", "null"], "minimum": 0},
        "download_bytes": {"type": ["integer", "null"], "minimum": 0},
        "artifact_bytes": {"type": ["integer", "null"], "minimum": 0},
        "candidates": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceiling", "reserved", "observed", "remaining"],
      "properties": {
        "ceiling": {"$ref": "#/$defs/counts"},
        "reserved": {"$ref": "#/$defs/counts"},
        "observed": {"$ref": "#/$defs/counts"},
        "remaining": {"$ref": "#/$defs/counts"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "scope", "evidence"],
      "properties": {
        "code": {"$ref": "#/$defs/safe_id"},
        "scope": {"$ref": "#/$defs/safe_id"},
        "evidence": {"anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]}
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_as_of", "valid_until", "drift_triggers", "predecessor"],
      "properties": {
        "observed_as_of": {"$ref": "#/$defs/timestamp"},
        "valid_until": {"$ref": "#/$defs/timestamp"},
        "drift_triggers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_revision",
              "plugin_tree_hash",
              "host_identity",
              "model_revision",
              "tool_policy",
              "interaction_probe_set",
              "sentinel_index"
            ]
          }
        },
        "predecessor": {"anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]}
      }
    }
  }
}
