{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent-skills.local/schemas/static-contract-diagnostic.schema.json",
  "title": "Frontier deterministic static contract diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "bundle_id",
    "version",
    "schema_epoch",
    "skill_versions",
    "skill_activation",
    "entry_bytes",
    "model_facing_files_checked",
    "markdown_link_errors",
    "legacy_runtime_paths_present",
    "legacy_protocol_matches",
    "brainstorming_runtime_copies",
    "package_file_count",
    "package_bytes",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "static-contract-diagnostic/1.0"},
    "classification": {"const": "static_contract_diagnostic"},
    "bundle_id": {"const": "frontier-engineering/11.0.2"},
    "version": {"const": "11.0.2"},
    "schema_epoch": {"const": 9},
    "skill_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code-review",
        "code-simplifier",
        "codebase-investigation",
        "debugging",
        "long-document-segmented-writing",
        "runtime-verification",
        "skill-evaluator",
        "software-design",
        "software-quality-workflows",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"const": "3.1.0"},
        "skill-evaluator": {"const": "5.0.1"},
        "software-quality-workflows": {"const": "13.0.0"},
        "writing-plans": {"const": "9.1.0"},
        "code-review": {"const": "2.0.2"},
        "code-simplifier": {"const": "1.2.0"},
        "codebase-investigation": {"const": "1.1.0"},
        "debugging": {"const": "1.1.0"},
        "runtime-verification": {"const": "1.1.0"},
        "software-design": {"const": "1.1.0"}
      }
    },
    "skill_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code-review",
        "code-simplifier",
        "codebase-investigation",
        "debugging",
        "long-document-segmented-writing",
        "runtime-verification",
        "skill-evaluator",
        "software-design",
        "software-quality-workflows",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"const": true},
        "skill-evaluator": {"const": false},
        "software-quality-workflows": {"const": false},
        "writing-plans": {"const": true},
        "code-review": {"const": true},
        "code-simplifier": {"const": true},
        "codebase-investigation": {"const": true},
        "debugging": {"const": true},
        "runtime-verification": {"const": true},
        "software-design": {"const": true}
      }
    },
    "entry_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code-review",
        "code-simplifier",
        "codebase-investigation",
        "debugging",
        "long-document-segmented-writing",
        "runtime-verification",
        "skill-evaluator",
        "software-design",
        "software-quality-workflows",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"type": "integer", "minimum": 1},
        "skill-evaluator": {"type": "integer", "minimum": 1},
        "software-quality-workflows": {"type": "integer", "minimum": 1},
        "writing-plans": {"type": "integer", "minimum": 1, "maximum": 6912},
        "code-review": {"type": "integer", "minimum": 1},
        "code-simplifier": {"type": "integer", "minimum": 1},
        "codebase-investigation": {"type": "integer", "minimum": 1},
        "debugging": {"type": "integer", "minimum": 1},
        "runtime-verification": {"type": "integer", "minimum": 1},
        "software-design": {"type": "integer", "minimum": 1}
      }
    },
    "model_facing_files_checked": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "markdown_link_errors": {"$ref": "#/$defs/linkErrors"},
    "legacy_runtime_paths_present": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "legacy_protocol_matches": {"$ref": "#/$defs/patternMatches"},
    "brainstorming_runtime_copies": {"$ref": "#/$defs/patternMatches"},
    "package_file_count": {"type": "integer", "minimum": 1},
    "package_bytes": {"type": "integer", "minimum": 1},
    "limitations": {
      "const": "Does not test natural routing, model behavior, task success, real host tokens, longitudinal test growth, publication authority, or deployment readiness."
    }
  },
  "$defs": {
    "linkErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "target"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "patternMatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "pattern"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "pattern": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
