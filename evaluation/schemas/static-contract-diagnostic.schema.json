{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent-skills.local/schemas/static-contract-diagnostic.schema.json",
  "title": "Frontier deterministic static contract diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "bundle_id",
    "version",
    "schema_epoch",
    "skill_versions",
    "skill_activation",
    "entry_bytes",
    "model_facing_files_checked",
    "markdown_link_errors",
    "legacy_runtime_paths_present",
    "legacy_protocol_matches",
    "brainstorming_runtime_copies",
    "package_file_count",
    "package_bytes",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "static-contract-diagnostic/1.0"},
    "classification": {"const": "static_contract_diagnostic"},
    "bundle_id": {"const": "frontier-engineering/8.0.0"},
    "version": {"const": "8.0.0"},
    "schema_epoch": {"const": 7},
    "skill_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["long-document-segmented-writing", "skill-evaluator", "software-quality-workflows", "writing-plans"],
      "properties": {
        "long-document-segmented-writing": {"const": "2.0.0"},
        "skill-evaluator": {"const": "5.0.0"},
        "software-quality-workflows": {"const": "11.0.0"},
        "writing-plans": {"const": "8.4.0"}
      }
    },
    "skill_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["long-document-segmented-writing", "skill-evaluator", "software-quality-workflows", "writing-plans"],
      "properties": {
        "long-document-segmented-writing": {"const": true},
        "skill-evaluator": {"const": false},
        "software-quality-workflows": {"const": false},
        "writing-plans": {"const": true}
      }
    },
    "entry_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["long-document-segmented-writing", "skill-evaluator", "software-quality-workflows", "writing-plans"],
      "properties": {
        "long-document-segmented-writing": {"type": "integer", "minimum": 1},
        "skill-evaluator": {"type": "integer", "minimum": 1},
        "software-quality-workflows": {"type": "integer", "minimum": 1, "maximum": 4096},
        "writing-plans": {"type": "integer", "minimum": 1, "maximum": 6656}
      }
    },
    "model_facing_files_checked": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "markdown_link_errors": {"$ref": "#/$defs/linkErrors"},
    "legacy_runtime_paths_present": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "legacy_protocol_matches": {"$ref": "#/$defs/patternMatches"},
    "brainstorming_runtime_copies": {"$ref": "#/$defs/patternMatches"},
    "package_file_count": {"type": "integer", "minimum": 1},
    "package_bytes": {"type": "integer", "minimum": 1},
    "limitations": {
      "const": "Does not test natural routing, model behavior, task success, real host tokens, longitudinal test growth, publication authority, or deployment readiness."
    }
  },
  "$defs": {
    "linkErrors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "target"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "patternMatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "pattern"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "pattern": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
