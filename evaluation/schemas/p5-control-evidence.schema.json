{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/software-engineering-closure/p5-control-evidence.schema.json",
  "title": "P5 ablation and reference evaluation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cohort_id", "bundle_hash", "controller_hash", "ablations", "reference_evaluations"],
  "properties": {
    "schema_version": {"const": "p5-control-evidence/1.0"},
    "cohort_id": {"type": "string", "pattern": "^COHORT-[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "bundle_hash": {"$ref": "#/$defs/hash"},
    "controller_hash": {"$ref": "#/$defs/hash"},
    "ablations": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/ablation"}
    },
    "reference_evaluations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/reference_evaluation"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_refs": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^artifact:[A-Za-z0-9][A-Za-z0-9._/-]{1,255}$"}
    },
    "status": {"enum": ["passed", "failed", "not_run", "not_applicable"]},
    "ablation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence_refs"],
      "properties": {
        "id": {
          "enum": [
            "no_policy_graph", "no_card_navigation", "no_exact_transport_ref",
            "no_context_lease", "no_artifact_boundary_reroute",
            "no_controller_context_separation", "mutable_verifier",
            "no_local_invalidation", "no_one_card_limit"
          ]
        },
        "status": {"enum": ["passed", "failed", "not_run"]},
        "evidence_refs": {"$ref": "#/$defs/artifact_refs"}
      }
    },
    "reference_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id", "owner_type", "owner_id", "decision_case_status", "precision_case_status",
        "exclusion_case_status", "ablation_status", "evidence_refs"
      ],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^(?:sqw|wp)\\.[a-z0-9.-]+$"},
        "owner_type": {"enum": ["card", "machine"]},
        "owner_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "decision_case_status": {"$ref": "#/$defs/status"},
        "precision_case_status": {"$ref": "#/$defs/status"},
        "exclusion_case_status": {"$ref": "#/$defs/status"},
        "ablation_status": {"$ref": "#/$defs/status"},
        "evidence_refs": {"$ref": "#/$defs/artifact_refs"}
      }
    }
  }
}
