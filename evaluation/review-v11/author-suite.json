    },
    {
      "treatment_id": "natural",
      "profile": "candidate/natural_routing"
    }
  ],
  "repeats": 1,
  "constraints": {
    "task_attempt_budget": 0,
    "judge_invocation_budget": 0,
    "timeout_seconds": 300
  }
