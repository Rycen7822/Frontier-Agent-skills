{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/software-engineering-closure/p6-release-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_version", "source_tree_hash", "source_revision",
    "source_revision_signed", "source_clean", "p5_report_content_hash",
    "release_gate", "approved_activation_level"
  ],
  "properties": {
    "schema_version": {"const": "p6-release-evidence/1.0"},
    "bundle_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_tree_hash": {"$ref": "#/$defs/hash"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "source_revision_signed": {"const": true},
    "source_clean": {"const": true},
    "p5_report_content_hash": {"$ref": "#/$defs/hash"},
    "release_gate": {"const": "passed"},
    "approved_activation_level": {"const": "explicit_only"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
