{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/release-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_id", "bundle_version", "source_tree_hash", "plugin_tree_hash", "source_revision",
    "source_revision_signed", "source_clean", "deterministic_report_hash", "l2_scored_report_hash",
    "p3_decision_contract_hash", "evaluated_skill_ids", "arm_report_content_hashes",
    "longitudinal_report_hash", "activation_decision_hash", "approved_skill_activation",
    "remote_writes", "release_gate"
  ],
  "properties": {
    "schema_version": {"const": "release-evidence/4.0"},
    "bundle_id": {"const": "frontier-engineering/6.0.0"},
    "bundle_version": {"const": "6.0.0"},
    "source_tree_hash": {"$ref": "#/$defs/hash"},
    "plugin_tree_hash": {"$ref": "#/$defs/hash"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_revision_signed": {"const": true},
    "source_clean": {"const": true},
    "deterministic_report_hash": {"$ref": "#/$defs/hash"},
    "p3_decision_contract_hash": {"$ref": "#/$defs/hash"},
    "evaluated_skill_ids": {
      "const": ["software-quality-workflows", "writing-plans"]
    },
    "arm_report_content_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["software-quality-workflows", "writing-plans"],
      "properties": {
        "software-quality-workflows": {"$ref": "#/$defs/hash"},
        "writing-plans": {"$ref": "#/$defs/hash"}
      }
    },
    "l2_scored_report_hash": {"$ref": "#/$defs/hash"},
    "longitudinal_report_hash": {"$ref": "#/$defs/hash"},
    "activation_decision_hash": {"$ref": "#/$defs/hash"},
    "approved_skill_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["long-document-segmented-writing", "skill-evaluator", "software-quality-workflows", "writing-plans"],
      "properties": {
        "long-document-segmented-writing": {"const": "implicit"},
        "skill-evaluator": {"const": "explicit_only"},
        "software-quality-workflows": {"const": "explicit_only"},
        "writing-plans": {"const": "explicit_only"}
      }
    },
    "remote_writes": {"const": false},
    "release_gate": {"const": "passed"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
