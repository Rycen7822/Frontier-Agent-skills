{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/source-archive-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layout",
    "bundle_version",
    "root_prefix",
    "skill_versions",
    "source_tree_hash",
    "archive_content_hash",
    "source_file_count",
    "archive_file_count",
    "source_revision_verified",
    "generated_artifacts_excluded",
    "files"
  ],
  "properties": {
    "schema_version": {"const": "source-archive-evidence/3.0"},
    "layout": {"enum": ["bundle", "skills_only"]},
    "bundle_version": {"const": "10.0.0"},
    "root_prefix": {"oneOf": [{"const": "frontier-engineering-bundle"}, {"type": "null"}]},
    "skill_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code-review",
        "code-simplifier",
        "codebase-investigation",
        "debugging",
        "long-document-segmented-writing",
        "runtime-verification",
        "skill-evaluator",
        "software-design",
        "software-quality-workflows",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"const": "3.0.0"},
        "skill-evaluator": {"const": "5.0.1"},
        "software-quality-workflows": {"const": "12.1.0"},
        "writing-plans": {"const": "9.0.0"},
        "code-review": {"const": "1.0.1"},
        "code-simplifier": {"const": "1.0.1"},
        "codebase-investigation": {"const": "1.0.1"},
        "debugging": {"const": "1.0.1"},
        "runtime-verification": {"const": "1.0.1"},
        "software-design": {"const": "1.0.1"}
      }
    },
    "source_tree_hash": {"$ref": "#/$defs/hash"},
    "archive_content_hash": {"$ref": "#/$defs/hash"},
    "source_file_count": {"type": "integer", "minimum": 1},
    "archive_file_count": {"type": "integer", "minimum": 1},
    "source_revision_verified": {"const": false},
    "generated_artifacts_excluded": {"const": true},
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
  },
  "allOf": [
    {
      "if": {"properties": {"layout": {"const": "bundle"}}, "required": ["layout"]},
      "then": {"properties": {"root_prefix": {"const": "frontier-engineering-bundle"}}}
    },
    {
      "if": {"properties": {"layout": {"const": "skills_only"}}, "required": ["layout"]},
      "then": {"properties": {"root_prefix": {"type": "null"}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash", "size", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "content_hash": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 0},
        "mode": {"enum": ["0644", "0755"]}
      }
    }
  }
}
