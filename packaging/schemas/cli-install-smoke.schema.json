{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/cli-install-smoke.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plugin_name", "bundle_version", "plugin_tree_hash", "build_evidence_hash",
    "static_smoke_content_hash", "activation_ceiling", "release_gate", "blocking_prerequisites",
    "release_eligible", "source_revision_verified", "marketplace_name", "codex_cli_version",
    "actual_codex_cli_install", "model_invoked", "remote_writes", "credential_environment_inherited",
    "marketplace_layout_valid", "marketplace_added", "discovered_before_install", "installed_enabled", "skill_activation",
    "installed_tree_hash", "cache_matches_staging", "staged_validator_passed", "installed_validator_passed",
    "source_unchanged", "marketplace_source_unchanged", "uninstall_clean", "marketplace_removed",
    "final_config_clean", "discovered_skills", "explicit_skill_invocation", "implicit_route_invocation",
    "commands", "evidence_hash"
  ],
  "properties": {
    "schema_version": {"const": "cli-install-smoke/3.0"},
    "plugin_name": {"const": "frontier-engineering-plugin"},
    "bundle_version": {"const": "5.0.0"},
    "plugin_tree_hash": {"$ref": "#/$defs/hash"},
    "build_evidence_hash": {"$ref": "#/$defs/hash"},
    "static_smoke_content_hash": {"$ref": "#/$defs/hash"},
    "activation_ceiling": {"const": "implicit_local_pilot"},
    "release_gate": {"enum": ["blocked_prerequisites", "passed"]},
    "blocking_prerequisites": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "release_eligible": {"type": "boolean"},
    "source_revision_verified": {"type": "boolean"},
    "marketplace_name": {"type": "string", "minLength": 1},
    "codex_cli_version": {"type": "string", "minLength": 1},
    "actual_codex_cli_install": {"const": true},
    "model_invoked": {"const": false},
    "remote_writes": {"const": false},
    "credential_environment_inherited": {"const": false},
    "marketplace_layout_valid": {"const": true},
    "marketplace_added": {"const": true},
    "discovered_before_install": {"const": true},
    "installed_enabled": {"const": true},
    "skill_activation": {
      "type": "object", "additionalProperties": false,
      "required": ["long-document-segmented-writing", "skill-evaluator", "software-quality-workflows", "writing-plans"],
      "properties": {
        "long-document-segmented-writing": {"const": true},
        "skill-evaluator": {"const": false},
        "software-quality-workflows": {"const": true},
        "writing-plans": {"const": false}
      }
    },
    "installed_tree_hash": {"$ref": "#/$defs/hash"},
    "cache_matches_staging": {"const": true},
    "staged_validator_passed": {"const": true},
    "installed_validator_passed": {"const": true},
    "source_unchanged": {"const": true},
    "marketplace_source_unchanged": {"const": true},
    "uninstall_clean": {"const": true},
    "marketplace_removed": {"const": true},
    "final_config_clean": {"const": true},
    "discovered_skills": {"const": ["long-document-segmented-writing", "skill-evaluator", "software-quality-workflows", "writing-plans"]},
    "explicit_skill_invocation": {"const": "not_run_model_free"},
    "implicit_route_invocation": {"const": "not_run_model_free"},
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "marketplace_add", "list_available", "plugin_add", "list_installed",
        "plugin_remove", "list_after_remove", "marketplace_remove", "marketplace_list_final"
      ],
      "properties": {
        "marketplace_add": {"const": 0},
        "list_available": {"const": 0},
        "plugin_add": {"const": 0},
        "list_installed": {"const": 0},
        "plugin_remove": {"const": 0},
        "list_after_remove": {"const": 0},
        "marketplace_remove": {"const": 0},
        "marketplace_list_final": {"const": 0}
      }
    },
    "evidence_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"release_gate": {"const": "blocked_prerequisites"}}, "required": ["release_gate"]},
      "then": {
        "properties": {
          "release_gate": {"const": "blocked_prerequisites"},
          "blocking_prerequisites": {"const": ["scored_l2_gate", "activation_decision", "signed_clean_source_revision"]},
          "release_eligible": {"const": false},
          "source_revision_verified": {"const": false}
        }
      },
      "else": {
        "properties": {
          "release_gate": {"const": "passed"},
          "blocking_prerequisites": {"maxItems": 0},
          "release_eligible": {"const": true},
          "source_revision_verified": {"const": true}
        }
      }
    }
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
