{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/release-authorization-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_id", "bundle_version", "source_revision",
    "source_tree_hash", "plugin_tree_hash", "static_gate",
    "approved_skill_activation", "remote_writes", "authority"
  ],
  "properties": {
    "schema_version": {"const": "release-authorization/2"},
    "bundle_id": {"const": "frontier-engineering/7.0.0"},
    "bundle_version": {"const": "7.0.0"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_hash": {"$ref": "#/$defs/digest"},
    "plugin_tree_hash": {"$ref": "#/$defs/digest"},
    "static_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status"],
      "properties": {
        "schema_version": {"const": "static-contract-diagnostic/1.0"},
        "status": {"const": "pass"}
      }
    },
    "approved_skill_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "long-document-segmented-writing", "skill-evaluator",
        "software-quality-workflows", "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"const": "implicit"},
        "skill-evaluator": {"const": "explicit_only"},
        "software-quality-workflows": {"const": "implicit"},
        "writing-plans": {"const": "implicit"}
      }
    },
    "remote_writes": {"const": false},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "role", "decision", "signature_attestation"],
      "properties": {
        "authority_id": {"type": "string", "minLength": 1},
        "role": {"const": "release_owner"},
        "decision": {"const": "approve"},
        "signature_attestation": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
