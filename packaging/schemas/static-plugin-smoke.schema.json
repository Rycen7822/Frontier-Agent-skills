{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/static-plugin-smoke.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_version",
    "plugin_name",
    "plugin_tree_hash",
    "activation_ceiling",
    "actual_codex_cli_install",
    "model_invoked",
    "remote_writes",
    "discovered_skills",
    "isolated_install_discovery",
    "uninstall_clean"
  ],
  "properties": {
    "schema_version": {"const": "static-plugin-smoke/4.0"},
    "bundle_id": {"const": "frontier-engineering/11.1.0"},
    "bundle_version": {"const": "11.1.0"},
    "plugin_name": {"const": "frontier-engineering-plugin"},
    "plugin_tree_hash": {"$ref": "#/$defs/hash"},
    "activation_ceiling": {"const": "implicit_local_pilot"},
    "actual_codex_cli_install": {"const": false},
    "model_invoked": {"const": false},
    "remote_writes": {"const": false},
    "discovered_skills": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code-review",
        "code-simplifier",
        "codebase-investigation",
        "debugging",
        "long-document-segmented-writing",
        "runtime-verification",
        "skill-evaluator",
        "software-design",
        "software-quality-workflows",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "3.1.0"}, "implicit_eligible": {"const": true}}}]},
        "skill-evaluator": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "5.0.1"}, "implicit_eligible": {"const": false}}}]},
        "software-quality-workflows": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "13.0.0"}, "implicit_eligible": {"const": false}}}]},
        "writing-plans": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "9.1.0"}, "implicit_eligible": {"const": true}}}]},
        "code-review": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "2.0.2"}, "implicit_eligible": {"const": true}}}]},
        "code-simplifier": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "1.2.0"}, "implicit_eligible": {"const": true}}}]},
        "codebase-investigation": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "1.1.0"}, "implicit_eligible": {"const": true}}}]},
        "debugging": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "1.1.0"}, "implicit_eligible": {"const": true}}}]},
        "runtime-verification": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "1.1.0"}, "implicit_eligible": {"const": true}}}]},
        "software-design": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "1.1.0"}, "implicit_eligible": {"const": true}}}]}
      }
    },
    "isolated_install_discovery": {"const": true},
    "uninstall_clean": {"const": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "description", "explicit_invocation", "implicit_eligible"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description": {"type": "string", "minLength": 1},
        "explicit_invocation": {"const": true},
        "implicit_eligible": {"type": "boolean"}
      }
    }
  }
}
