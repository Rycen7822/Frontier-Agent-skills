{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/static-plugin-smoke.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_id", "bundle_version", "plugin_name", "plugin_tree_hash", "activation_ceiling",
    "actual_codex_cli_install", "model_invoked", "remote_writes", "discovered_skills",
    "isolated_install_discovery", "uninstall_clean"
  ],
  "properties": {
    "schema_version": {"const": "static-plugin-smoke/4.0"},
    "bundle_id": {"const": "frontier-engineering/8.0.0"},
    "bundle_version": {"const": "8.0.0"},
    "plugin_name": {"const": "frontier-engineering-plugin"},
    "plugin_tree_hash": {"$ref": "#/$defs/hash"},
    "activation_ceiling": {"const": "implicit_local_pilot"},
    "actual_codex_cli_install": {"const": false},
    "model_invoked": {"const": false},
    "remote_writes": {"const": false},
    "discovered_skills": {
      "type": "object", "additionalProperties": false,
      "required": ["long-document-segmented-writing", "skill-evaluator", "software-quality-workflows", "writing-plans"],
      "properties": {
        "long-document-segmented-writing": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "2.0.0"}, "implicit_eligible": {"const": true}}}]},
        "skill-evaluator": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "5.0.0"}, "implicit_eligible": {"const": false}}}]},
        "software-quality-workflows": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "11.0.0"}, "implicit_eligible": {"const": true}}}]},
        "writing-plans": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "8.4.0"}, "implicit_eligible": {"const": true}}}]}
      }
    },
    "isolated_install_discovery": {"const": true},
    "uninstall_clean": {"const": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "description", "explicit_invocation", "implicit_eligible"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description": {"type": "string", "minLength": 1},
        "explicit_invocation": {"const": true},
        "implicit_eligible": {"type": "boolean"}
      }
    }
  }
}
