{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/static-plugin-smoke.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plugin_name", "plugin_tree_hash", "build_evidence_hash", "activation_ceiling",
    "actual_codex_cli_install", "model_invoked", "remote_writes", "discovered_skills",
    "isolated_install_discovery", "uninstall_clean"
  ],
  "properties": {
    "schema_version": {"const": "static-plugin-smoke/2.0"},
    "plugin_name": {"const": "frontier-engineering-plugin"},
    "plugin_tree_hash": {"$ref": "#/$defs/hash"},
    "build_evidence_hash": {"$ref": "#/$defs/hash"},
    "activation_ceiling": {"const": "implicit_local_pilot"},
    "actual_codex_cli_install": {"const": false},
    "model_invoked": {"const": false},
    "remote_writes": {"const": false},
    "discovered_skills": {
      "type": "object", "additionalProperties": false,
      "required": ["brainstorming", "long-document-segmented-writing", "skill-evaluator", "software-quality-workflows", "writing-plans"],
      "properties": {
        "brainstorming": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "1.0.0"}}}]},
        "long-document-segmented-writing": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "1.0.0"}}}]},
        "skill-evaluator": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "1.0.0"}}}]},
        "software-quality-workflows": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "8.0.0"}}}]},
        "writing-plans": {"allOf": [{"$ref": "#/$defs/skill"}, {"properties": {"version": {"const": "7.0.0"}}}]}
      }
    },
    "isolated_install_discovery": {"const": true},
    "uninstall_clean": {"const": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "description_hash", "explicit_invocation", "implicit_eligible"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description_hash": {"$ref": "#/$defs/hash"},
        "explicit_invocation": {"const": true},
        "implicit_eligible": {"const": true}
      }
    }
  }
}
