{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/p3-arm-report-v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study",
    "candidate_revision",
    "candidate_source_tree_hash",
    "candidate_plugin_tree_hash",
    "controller_content_hash",
    "evaluator_source_hash",
    "decision_contract_content_hash",
    "native_artifact_content_hashes",
    "manual_receipt_content_hash",
    "evidence_status",
    "usefulness_status",
    "metrics",
    "gate_results",
    "usage_closure",
    "report_hash"
  ],
  "properties": {
    "schema_version": {"const": "p3-arm-report/3.0"},
    "study": {
      "enum": ["software-quality-workflows", "writing-plans"]
    },
    "candidate_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_source_tree_hash": {"$ref": "#/$defs/hash"},
    "candidate_plugin_tree_hash": {"$ref": "#/$defs/hash"},
    "controller_content_hash": {"$ref": "#/$defs/hash"},
    "evaluator_source_hash": {"$ref": "#/$defs/hash"},
    "decision_contract_content_hash": {"$ref": "#/$defs/hash"},
    "native_artifact_content_hashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "manual_receipt_content_hash": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]
    },
    "evidence_status": {"const": "complete"},
    "usefulness_status": {"const": "supported"},
    "metrics": {"type": "object"},
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gateResult"}
    },
    "usage_closure": {"$ref": "#/$defs/usageClosure"},
    "report_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "metric_id",
        "evidence_artifact_kind",
        "observed",
        "passed"
      ],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "metric_id": {"type": "string", "minLength": 1},
        "evidence_artifact_kind": {
          "enum": ["native_artifact", "report_local"]
        },
        "observed": {},
        "passed": {"const": true}
      }
    },
    "usageClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheduled",
        "observed",
        "graded",
        "missing",
        "duplicate",
        "retries",
        "provider_calls"
      ],
      "properties": {
        "scheduled": {"type": "integer", "minimum": 0},
        "observed": {"type": "integer", "minimum": 0},
        "graded": {"type": "integer", "minimum": 0},
        "missing": {"const": 0},
        "duplicate": {"const": 0},
        "retries": {"type": "integer", "minimum": 0},
        "provider_calls": {"type": "integer", "minimum": 0}
      }
    }
  }
}
