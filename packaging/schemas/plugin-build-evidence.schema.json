{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/plugin-build-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bundle_id", "bundle_version", "skill_versions", "skill_activation", "source_tree_hash",
    "source_revision", "source_file_count", "plugin_tree_hash", "plugin_file_count", "plugin_name",
    "output_class", "release_authorization_hash", "activation_ceiling", "files", "evidence_hash"
  ],
  "properties": {
    "schema_version": {"const": "plugin-build-evidence/3.0"},
    "bundle_id": {"const": "frontier-engineering/6.3.0"},
    "bundle_version": {"const": "6.3.0"},
    "skill_versions": {
      "type": "object", "additionalProperties": false,
      "required": ["long-document-segmented-writing", "skill-evaluator", "software-quality-workflows", "writing-plans"],
      "properties": {
        "long-document-segmented-writing": {"const": "1.1.3"},
        "skill-evaluator": {"const": "3.3.4"},
        "software-quality-workflows": {"const": "9.0.4"},
        "writing-plans": {"const": "8.2.5"}
      }
    },
    "skill_activation": {
      "type": "object", "additionalProperties": false,
      "required": ["long-document-segmented-writing", "skill-evaluator", "software-quality-workflows", "writing-plans"],
      "properties": {
        "long-document-segmented-writing": {"const": true},
        "skill-evaluator": {"const": false},
        "software-quality-workflows": {"const": false},
        "writing-plans": {"const": false}
      }
    },
    "source_tree_hash": {"$ref": "#/$defs/hash"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_file_count": {"type": "integer", "minimum": 1},
    "plugin_tree_hash": {"$ref": "#/$defs/hash"},
    "plugin_file_count": {"type": "integer", "minimum": 1},
    "plugin_name": {"const": "frontier-engineering-plugin"},
    "output_class": {"enum": ["staging", "release"]},
    "release_authorization_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "activation_ceiling": {"const": "implicit_local_pilot"},
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "evidence_hash": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {
      "if": {"properties": {"output_class": {"const": "staging"}}, "required": ["output_class"]},
      "then": {"properties": {"release_authorization_hash": {"type": "null"}}},
      "else": {"properties": {"release_authorization_hash": {"$ref": "#/$defs/hash"}}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "content_hash", "size", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 0},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"}
      }
    }
  }
}
