{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/plugin-build-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "bundle_version",
    "skill_versions",
    "skill_activation",
    "source_tree_hash",
    "source_revision",
    "source_file_count",
    "plugin_tree_hash",
    "plugin_file_count",
    "plugin_name",
    "activation_ceiling",
    "files"
  ],
  "properties": {
    "schema_version": {"const": "plugin-build-evidence/5.0"},
    "bundle_id": {"const": "frontier-engineering/11.3.0"},
    "bundle_version": {"const": "11.3.0"},
    "skill_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code-review",
        "code-simplifier",
        "codebase-investigation",
        "debugging",
        "long-document-segmented-writing",
        "runtime-verification",
        "skill-evaluator",
        "software-design",
        "software-quality-workflows",
        "test-behavior",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"const": "3.1.0"},
        "skill-evaluator": {"const": "5.0.3"},
        "software-quality-workflows": {"const": "13.1.0"},
        "writing-plans": {"const": "9.1.2"},
        "code-review": {"const": "2.0.5"},
        "code-simplifier": {"const": "1.2.1"},
        "codebase-investigation": {"const": "1.1.2"},
        "debugging": {"const": "1.1.2"},
        "test-behavior": {"const": "1.0.0"},
        "runtime-verification": {"const": "1.1.1"},
        "software-design": {"const": "1.1.1"}
      }
    },
    "skill_activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code-review",
        "code-simplifier",
        "codebase-investigation",
        "debugging",
        "long-document-segmented-writing",
        "runtime-verification",
        "skill-evaluator",
        "software-design",
        "software-quality-workflows",
        "test-behavior",
        "writing-plans"
      ],
      "properties": {
        "long-document-segmented-writing": {"const": true},
        "skill-evaluator": {"const": false},
        "software-quality-workflows": {"const": false},
        "writing-plans": {"const": true},
        "code-review": {"const": true},
        "code-simplifier": {"const": true},
        "codebase-investigation": {"const": true},
        "debugging": {"const": true},
        "test-behavior": {"const": true},
        "runtime-verification": {"const": true},
        "software-design": {"const": true}
      }
    },
    "source_tree_hash": {"$ref": "#/$defs/hash"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_file_count": {"type": "integer", "minimum": 1},
    "plugin_tree_hash": {"$ref": "#/$defs/hash"},
    "plugin_file_count": {"type": "integer", "minimum": 1},
    "plugin_name": {"const": "frontier-engineering-plugin"},
    "activation_ceiling": {"const": "implicit_local_pilot"},
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash", "size", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/hash"},
        "size": {"type": "integer", "minimum": 0},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"}
      }
    }
  }
}
