{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/frontier-engineering/p3-decision-contract-v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_revision",
    "candidate_source_tree_hash",
    "candidate_plugin_tree_hash",
    "controller_content_hash",
    "evaluator_source_hash",
    "request_manifest_content_hash",
    "evaluated_skill_ids",
    "budget_contract",
    "gate_contract",
    "decision_contract_hash"
  ],
  "properties": {
    "schema_version": {"const": "p3-decision-contract/4.0"},
    "candidate_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_source_tree_hash": {"$ref": "#/$defs/hash"},
    "candidate_plugin_tree_hash": {"$ref": "#/$defs/hash"},
    "controller_content_hash": {"$ref": "#/$defs/hash"},
    "evaluator_source_hash": {"$ref": "#/$defs/hash"},
    "request_manifest_content_hash": {"$ref": "#/$defs/hash"},
    "evaluated_skill_ids": {
      "const": ["software-quality-workflows", "writing-plans"]
    },
    "budget_contract": {"$ref": "#/$defs/budget"},
    "gate_contract": {"$ref": "#/$defs/gateContract"},
    "decision_contract_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scheduled_provider_calls",
        "scored_call_hard_cap",
        "grader_calibration_call_hard_cap",
        "reviewer_calibration_call_hard_cap",
        "provider_call_hard_cap"
      ],
      "properties": {
        "schema_version": {"const": "provider-budget-contract/1.0"},
        "scheduled_provider_calls": {"type": "integer", "minimum": 1},
        "scored_call_hard_cap": {"type": "integer", "minimum": 1},
        "grader_calibration_call_hard_cap": {"type": "integer", "minimum": 0},
        "reviewer_calibration_call_hard_cap": {"type": "integer", "minimum": 0},
        "provider_call_hard_cap": {"type": "integer", "minimum": 1}
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "scalar",
        "numerator",
        "denominator",
        "comparator_metric_id"
      ],
      "properties": {
        "kind": {"enum": ["scalar", "count_pair", "relative_metric"]},
        "scalar": {"type": ["number", "string", "boolean", "null"]},
        "numerator": {"type": ["integer", "null"], "minimum": 0},
        "denominator": {"type": ["integer", "null"], "minimum": 1},
        "comparator_metric_id": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "metric_id",
        "evidence_artifact_kind",
        "selector",
        "operator",
        "threshold",
        "critical"
      ],
      "properties": {
        "gate_id": {"type": "string", "minLength": 1},
        "metric_id": {"type": "string", "minLength": 1},
        "evidence_artifact_kind": {
          "enum": ["native_artifact", "report_local"]
        },
        "selector": {
          "enum": ["scalar", "point", "lower", "upper", "numerator", "status_value"]
        },
        "operator": {"enum": ["eq", "ne", "lt", "le", "gt", "ge"]},
        "threshold": {"$ref": "#/$defs/threshold"},
        "critical": {"const": true}
      }
    },
    "armGates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/gate"}
    },
    "gateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "software-quality-workflows",
        "writing-plans"
      ],
      "properties": {
        "schema_version": {"const": "gate-contract/1.0"},
        "software-quality-workflows": {"$ref": "#/$defs/armGates"},
        "writing-plans": {"$ref": "#/$defs/armGates"}
      }
    }
  }
}
