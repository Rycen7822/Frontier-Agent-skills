{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontier://writing-plans/reference-cards-manifest/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "skill_id", "skill_version", "cards"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_id": {"const": "frontier-engineering/5.0.0+4.0.0"},
    "skill_id": {"const": "writing-plans"},
    "skill_version": {"const": "4.0.0"},
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id", "card_version", "kind", "consumes", "produces", "max_active_neighbors", "max_bytes", "neighbors", "path", "sha256", "bytes"],
        "properties": {
          "card_id": {"type": "string", "pattern": "^wp\\."},
          "card_version": {"type": "integer", "minimum": 1},
          "kind": {"type": "string"},
          "consumes": {"type": "array"},
          "produces": {"type": "array"},
          "max_active_neighbors": {"type": "integer"},
          "max_bytes": {"type": "integer"},
          "neighbors": {"type": "array"},
          "path": {"type": "string", "pattern": "^references/.+\\.md$"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1, "maximum": 8192}
        }
      }
    }
  }
}
