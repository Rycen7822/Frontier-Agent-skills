{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent.local/writing-plans/plan-state-3.0.schema.json",
  "title": "Writing Plans Program state 3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "manifest_hash",
    "plan_id",
    "profile",
    "status",
    "state_version",
    "goal",
    "non_goals",
    "global_invariants",
    "facts",
    "decisions",
    "evidence",
    "nodes",
    "edges",
    "current_frontier",
    "risks",
    "gaps",
    "approvals",
    "snapshots",
    "policy_claims",
    "completion",
    "scope_binding",
    "initialization",
    "initial_completion_id",
    "initial_root_binding",
    "established_root_identity",
    "source_root_binding",
    "source_identity",
    "rollback",
    "artifacts",
    "pending_card_instances",
    "last_transition",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "bundle_id": {"const": "frontier-engineering/6.0.0+5.0.0"},
    "manifest_hash": {"$ref": "#/$defs/hash"},
    "plan_id": {"type": "string", "pattern": "^wp-plan:[0-9a-f]{64}$"},
    "profile": {"const": "program"},
    "status": {"enum": ["drafting", "ready", "active", "blocked", "completed", "superseded"]},
    "state_version": {"type": "integer", "minimum": 1},
    "content_hash": {"$ref": "#/$defs/hash"},
    "goal": {"$ref": "#/$defs/non_empty_string"},
    "non_goals": {"$ref": "#/$defs/string_array"},
    "global_invariants": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/invariant"}},
    "facts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/fact"}},
    "decisions": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/decision"}},
    "evidence": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/evidence"}},
    "nodes": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/edge"}},
    "current_frontier": {"$ref": "#/$defs/id_array"},
    "risks": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/risk"}},
    "gaps": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/gap"}},
    "approvals": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/approval"}},
    "snapshots": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/snapshot"}},
    "policy_claims": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/policy_claim"}},
    "completion": {"$ref": "#/$defs/completion"},
    "scope_binding": {"$ref": "#/$defs/scope_binding"},
    "initialization": {"$ref": "#/$defs/initialization"},
    "initial_completion_id": {"$ref": "#/$defs/hash"},
    "initial_root_binding": {"$ref": "#/$defs/root_binding"},
    "established_root_identity": {"$ref": "#/$defs/root_binding"},
    "source_root_binding": {"$ref": "#/$defs/source_root_binding"},
    "source_identity": {"$ref": "#/$defs/source_identity"},
    "rollback": {"$ref": "#/$defs/rollback"},
    "artifacts": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/durable_artifact"}},
    "pending_card_instances": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/card_instance"}},
    "last_transition": {"$ref": "#/$defs/last_transition"}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1, "maxLength": 20000},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path_array": {
      "type": "array", "maxItems": 1000, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}
    },
    "root_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["dev", "ino", "uid", "mode"],
      "properties": {
        "dev": {"type": "integer", "minimum": 0},
        "ino": {"type": "integer", "minimum": 1},
        "uid": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511}
      }
    },
    "source_root_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["dev", "ino"],
      "properties": {"dev": {"type": "integer", "minimum": 0}, "ino": {"type": "integer", "minimum": 1}}
    },
    "source_record": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "status", "content_hash", "bytes", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "status": {"enum": ["added", "modified", "deleted", "unchanged"]},
        "content_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "bytes": {"type": "integer", "minimum": 0},
        "mode": {"type": "string", "pattern": "^[0-7]{4}$"}
      }
    },
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identity_hash", "root_binding", "head_commit", "head_tree", "scoped_records", "exterior_guard_hash"],
      "properties": {
        "kind": {"enum": ["repository", "unversioned"]},
        "identity_hash": {"$ref": "#/$defs/hash"},
        "root_binding": {"$ref": "#/$defs/source_root_binding"},
        "head_commit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}]},
        "head_tree": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}]},
        "scoped_records": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/source_record"}},
        "exterior_guard_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "scope_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_kind", "binding_id", "producer_card_id", "initial_source_identity_hash", "allowed_reads", "allowed_plan_outputs", "effect_ceiling", "approval_requirements", "publication_ceiling"],
      "properties": {
        "binding_kind": {"const": "wp-planning"},
        "binding_id": {"$ref": "#/$defs/hash"},
        "producer_card_id": {"type": "string", "pattern": "^wp\\."},
        "initial_source_identity_hash": {"$ref": "#/$defs/hash"},
        "allowed_reads": {"$ref": "#/$defs/path_array"},
        "allowed_plan_outputs": {"$ref": "#/$defs/path_array"},
        "effect_ceiling": {"enum": ["read-only", "local-plan-artifact"]},
        "approval_requirements": {"$ref": "#/$defs/string_array"},
        "publication_ceiling": {"enum": ["none", "local-artifact"]}
      }
    },
    "initialization": {
      "type": "object", "additionalProperties": false,
      "required": ["initialization_id", "program_payload_hash", "initial_queue_hash"],
      "properties": {
        "initialization_id": {"$ref": "#/$defs/hash"},
        "program_payload_hash": {"$ref": "#/$defs/hash"},
        "initial_queue_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "steps", "verifier_refs"],
      "properties": {
        "strategy": {"enum": ["restore_previous_state", "manual_recovery", "not_applicable"]},
        "steps": {"$ref": "#/$defs/string_array"},
        "verifier_refs": {"$ref": "#/$defs/id_array"}
      }
    },
    "content_locator": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "content_kind", "artifact_id", "content_hash", "bytes"],
      "properties": {
        "schema_version": {"const": "content-locator/1"},
        "content_kind": {"const": "artifact"},
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "content_hash": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 2097152}
      }
    },
    "durable_artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["completion_id", "artifact_id", "scope_binding_id", "content_locator"],
      "properties": {
        "completion_id": {"$ref": "#/$defs/hash"},
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "scope_binding_id": {"$ref": "#/$defs/hash"},
        "content_locator": {"$ref": "#/$defs/content_locator"}
      }
    },
    "card_instance": {
      "type": "object", "additionalProperties": false,
      "required": ["card_instance_id", "decision_id", "subject_ref"],
      "properties": {
        "card_instance_id": {"$ref": "#/$defs/hash"},
        "decision_id": {"type": "string", "pattern": "^wp\\.select\\."},
        "subject_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/local_id"}]}
      }
    },
    "runtime_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["hard_failure_refs", "remaining_budget"],
      "properties": {
        "incumbent_artifact_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "hard_failure_refs": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1024}},
        "remaining_budget": {
          "type": "object", "additionalProperties": false,
          "required": ["iterations", "candidate_evaluations", "review_rounds", "changed_lines", "total_changed_lines"],
          "properties": {
            "iterations": {"type": "integer", "minimum": 0},
            "candidate_evaluations": {"type": "integer", "minimum": 0},
            "review_rounds": {"type": "integer", "minimum": 0},
            "changed_lines": {"type": "integer", "minimum": 0},
            "total_changed_lines": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "inline_render_completion": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "consumer_profile", "budget_bytes", "runtime_projection", "manifest_hash", "card_hash", "renderer_contract_hash"],
      "properties": {
        "node_id": {"$ref": "#/$defs/local_id"},
        "consumer_profile": {"type": "string", "minLength": 1, "maxLength": 128},
        "budget_bytes": {"type": "integer", "minimum": 500, "maximum": 8192},
        "runtime_projection": {"$ref": "#/$defs/runtime_projection"},
        "manifest_hash": {"$ref": "#/$defs/hash"},
        "card_hash": {"$ref": "#/$defs/hash"},
        "renderer_contract_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "last_transition": {
      "type": "object", "additionalProperties": false,
      "required": ["transition_kind", "operation_id", "prior_state_version", "prior_content_hash", "scope_binding_id", "completion_id", "completed_card_instance_id", "enqueued_card_instance_ids", "inline_render_completion"],
      "properties": {
        "transition_kind": {"enum": ["init", "card"]},
        "operation_id": {"$ref": "#/$defs/hash"},
        "prior_state_version": {"type": "integer", "minimum": 0},
        "prior_content_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "scope_binding_id": {"$ref": "#/$defs/hash"},
        "completion_id": {"$ref": "#/$defs/hash"},
        "completed_card_instance_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "enqueued_card_instance_ids": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
        "inline_render_completion": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/inline_render_completion"}]}
      }
    },
    "local_id": {"type": "string", "pattern": "^(I|F|D|E|P|R|G|X|AP|S)-[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "ref_id": {"type": "string", "pattern": "^((I|F|D|E|P|R|G|X|AP|S)-[A-Za-z0-9][A-Za-z0-9._-]{0,63}|[a-z_]+:[A-Za-z0-9._:-]+#[A-Za-z0-9._-]+)$"},
    "string_array": {"type": "array", "maxItems": 1000, "items": {"type": "string", "maxLength": 2000}},
    "id_array": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/ref_id"}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_revision", "scope_hash", "observed_at", "bundle_id", "policy_bundle_hash", "reference_manifest_hash"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "maxLength": 4096},
        "base_revision": {"type": "string", "minLength": 1, "maxLength": 256},
        "scope_hash": {"$ref": "#/$defs/hash"},
        "observed_at": {"type": "string", "format": "date-time"},
        "bundle_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "policy_bundle_hash": {"$ref": "#/$defs/hash"},
        "reference_manifest_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_reads", "allowed_writes", "protected_paths", "risk_ceiling"],
      "properties": {
        "allowed_reads": {"$ref": "#/$defs/string_array"},
        "allowed_writes": {"$ref": "#/$defs/string_array"},
        "protected_paths": {"$ref": "#/$defs/string_array"},
        "risk_ceiling": {"enum": ["none", "local_ephemeral", "local_reversible", "external_reversible", "external_non_idempotent", "destructive"]}
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "locality", "applicability", "targets"],
      "properties": {
        "id": {"type": "string", "pattern": "^I-"},
        "statement": {"$ref": "#/$defs/non_empty_string"},
        "locality": {"enum": ["global", "node_set", "resource_set"]},
        "applicability": {"enum": ["always", "when_target_active", "when_resource_touched"]},
        "targets": {"$ref": "#/$defs/string_array"},
        "sensitive": {"type": "boolean"}
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidence_refs", "freshness"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-"},
        "statement": {"$ref": "#/$defs/non_empty_string"},
        "evidence_refs": {"$ref": "#/$defs/id_array"},
        "freshness": {"enum": ["source_bound", "external_time_bound", "stable"]},
        "sensitive": {"type": "boolean"}
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option", "reason"],
      "properties": {
        "option": {"$ref": "#/$defs/non_empty_string"},
        "reason": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "alternatives_rejected", "evidence_refs", "provenance", "materiality", "reversibility"],
      "properties": {
        "id": {"type": "string", "pattern": "^D-"},
        "statement": {"$ref": "#/$defs/non_empty_string"},
        "alternatives_rejected": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/alternative"}},
        "evidence_refs": {"$ref": "#/$defs/id_array"},
        "provenance": {"enum": ["user", "repository", "source", "default_policy", "design_audit"]},
        "materiality": {"enum": ["low", "medium", "high"]},
        "reversibility": {"enum": ["local", "migration_required", "irreversible"]},
        "change_action": {"enum": ["keep", "add", "delete", "rewrite", "merge", "split", "replace", "defer"]},
        "legacy_refs": {"$ref": "#/$defs/string_array"},
        "sensitive": {"type": "boolean"}
      }
    },
    "freshness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["source_bound", "external_time_bound", "stable"]},
        "max_age_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 87600},
        "expected_version": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "claim"],
      "properties": {
        "id": {"type": "string", "pattern": "^E-"},
        "status": {"enum": ["required", "observed", "stale", "invalidated"]},
        "claim": {"$ref": "#/$defs/non_empty_string"},
        "artifact_ref": {"type": "string", "maxLength": 4096},
        "content_hash": {"$ref": "#/$defs/hash"},
        "artifact_mtime_ns": {"type": "integer", "minimum": 0},
        "source_revision": {"type": "string", "maxLength": 256},
        "producer_node": {"type": "string", "pattern": "^P-"},
        "observed_at": {"type": "string", "format": "date-time"},
        "external_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "freshness_policy": {"$ref": "#/$defs/freshness_policy"},
        "sensitive": {"type": "boolean"}
      }
    },
    "distinction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"$ref": "#/$defs/non_empty_string"},
        "after": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "completion_criterion", "false_green_risk", "required_evidence"],
      "properties": {
        "kind": {"enum": ["command", "evidence_set", "manual", "schema", "static", "runtime"]},
        "completion_criterion": {"$ref": "#/$defs/non_empty_string"},
        "false_green_risk": {"$ref": "#/$defs/non_empty_string"},
        "required_evidence": {"$ref": "#/$defs/id_array"},
        "command_ref": {"type": "string", "maxLength": 4096},
        "expected_distinction": {"$ref": "#/$defs/distinction"}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "max_attempts", "idempotency"],
      "properties": {
        "allowed": {"type": "boolean"},
        "max_attempts": {"type": "integer", "minimum": 0, "maximum": 20},
        "idempotency": {"enum": ["idempotent", "inspect_before_retry", "idempotency_key", "manual_reconciliation", "not_retryable"]},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "refinement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent", "replaces"],
      "properties": {
        "parent": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^P-"}]},
        "replaces": {"$ref": "#/$defs/id_array"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "objective", "depends_on", "inputs", "outputs", "read_set", "write_set", "resource_set", "effect_set", "side_effect_level", "verifier", "retry", "refinement"],
      "properties": {
        "id": {"type": "string", "pattern": "^P-"},
        "kind": {"enum": ["discovery", "decision", "verification", "implementation", "migration", "cleanup", "documentation", "approval", "release"]},
        "status": {"enum": ["fog", "ready", "in_progress", "blocked", "done", "failed", "invalidated", "superseded", "skipped"]},
        "objective": {"$ref": "#/$defs/non_empty_string"},
        "completion_criterion": {"$ref": "#/$defs/non_empty_string"},
        "depends_on": {"$ref": "#/$defs/id_array"},
        "inputs": {"$ref": "#/$defs/id_array"},
        "outputs": {"$ref": "#/$defs/id_array"},
        "read_set": {"$ref": "#/$defs/string_array"},
        "write_set": {"$ref": "#/$defs/string_array"},
        "resource_set": {"$ref": "#/$defs/string_array"},
        "effect_set": {"$ref": "#/$defs/string_array"},
        "side_effect_level": {"enum": ["none", "local_ephemeral", "local_reversible", "external_reversible", "external_non_idempotent", "destructive"]},
        "verifier": {"$ref": "#/$defs/verifier"},
        "retry": {"$ref": "#/$defs/retry"},
        "refinement": {"$ref": "#/$defs/refinement"},
        "sensitive": {"type": "boolean"}
      }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {"$ref": "#/$defs/string_array"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to"],
      "properties": {
        "id": {"type": "string", "pattern": "^X-"},
        "kind": {"enum": ["control", "data", "evidence", "invariant", "effect", "resource", "approval"]},
        "from": {"$ref": "#/$defs/ref_id"},
        "to": {"$ref": "#/$defs/ref_id"},
        "sensitivity": {"$ref": "#/$defs/sensitivity"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "mitigation_refs", "escalation"],
      "properties": {
        "id": {"type": "string", "pattern": "^R-"},
        "statement": {"$ref": "#/$defs/non_empty_string"},
        "mitigation_refs": {"$ref": "#/$defs/id_array"},
        "escalation": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "question", "blocks"],
      "properties": {
        "id": {"type": "string", "pattern": "^G-"},
        "status": {"enum": ["fog", "open", "closed"]},
        "question": {"$ref": "#/$defs/non_empty_string"},
        "blocks": {"$ref": "#/$defs/id_array"}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "scope", "authority_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "^AP-"},
        "status": {"enum": ["required", "granted", "revoked"]},
        "scope": {"$ref": "#/$defs/non_empty_string"},
        "authority_ref": {"type": "string", "minLength": 1, "maxLength": 4096}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path"],
      "properties": {
        "id": {"type": "string", "pattern": "^S-"},
        "kind": {"enum": ["path", "line", "snippet", "symbol"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 4096},
        "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:#]{0,511}$"},
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "content_hash": {"$ref": "#/$defs/hash"},
        "source_revision": {"type": "string", "maxLength": 256},
        "sensitive": {"type": "boolean"}
      }
    },
    "card_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "card_hash"],
      "properties": {
        "card_id": {"type": "string", "pattern": "^(wp|sqw)(\\.[a-z0-9][a-z0-9-]*)+$"},
        "card_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "policy_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "bundle_version", "policy_hash"],
      "properties": {
        "policy_id": {"type": "string", "pattern": "^(wp|sqw)(\\.[a-z0-9][a-z0-9-]*)+$"},
        "bundle_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "policy_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "epistemic_status", "required_evidence", "residual_uncertainty"],
      "properties": {
        "status": {"enum": ["open", "complete", "incomplete", "inconclusive"]},
        "epistemic_status": {"enum": ["needs_repair", "verified_within_scope", "blocked", "empirical_validation_required"]},
        "required_evidence": {"$ref": "#/$defs/id_array"},
        "residual_uncertainty": {"$ref": "#/$defs/string_array"}
      }
    }
  }
}
