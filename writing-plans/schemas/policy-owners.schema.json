{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontier://writing-plans/policy-owners/2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "skill_id", "skill_version", "policies"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "bundle_id": {"const": "frontier-engineering/7.0.0+6.0.0"},
    "skill_id": {"const": "writing-plans"},
    "skill_version": {"const": "6.0.0"},
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy_id", "owner_type", "owner_id", "depends_on"],
        "properties": {
          "policy_id": {"type": "string", "pattern": "^wp(?:\\.[a-z0-9][a-z0-9-]*)+$"},
          "owner_type": {"enum": ["card", "machine"]},
          "owner_id": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    }
  }
}
