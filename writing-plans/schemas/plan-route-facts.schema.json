{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent-skills.local/writing-plans/plan-route-facts.schema.json",
  "title": "Writing Plans Route Facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "explicit_plan_request",
    "root_cause_status",
    "intent_status",
    "closure_admission_decision"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "explicit_plan_request": {"type": "boolean"},
    "root_cause_status": {"enum": ["known", "unknown", "not_applicable"]},
    "intent_status": {"enum": ["defined", "materially_underdefined", "low_risk_defaults_available"]},
    "closure_admission_decision": {"enum": ["NOT_REQUESTED", "DIRECT_SELECTED", "CLOSURE_ELIGIBLE", "TERMINAL"]},
    "same_session_execution": {"type": "boolean"},
    "durable_handoff": {"type": "boolean"},
    "public_contract": {"type": "boolean"},
    "migration_or_rollback": {"type": "boolean"},
    "resume_required": {"type": "boolean"},
    "external_side_effect": {"type": "boolean"},
    "independent_write_slices": {"type": "integer", "minimum": 0},
    "strategy_family_count": {"type": "integer", "minimum": 1},
    "long_corpus_only": {"type": "boolean"},
    "copy_paste_projection_requested": {"type": "boolean"},
    "disposable_spike": {"type": "boolean"}
  }
}
