{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent-skills.local/writing-plans/card-protocol.schema.json",
  "$ref": "#/$defs/command",
  "$defs": {
    "humanOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker"],
      "properties": {
        "blocker": {"type": ["string", "null"]}
      }
    },
    "completionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker", "decision_request"],
      "properties": {
        "blocker": {"type": ["string", "null"]},
        "decision_request": {"type": ["string", "null"]}
      }
    },
    "routeFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_plan_request", "root_cause_status", "intent_status",
        "copy_paste_projection_requested", "disposable_spike", "durable_handoff",
        "external_side_effect", "independent_write_slices", "long_corpus_only",
        "migration_or_rollback", "public_contract", "resume_required",
        "same_session_execution", "strategy_family_count"
      ],
      "properties": {
        "explicit_plan_request": {"type": "boolean"},
        "root_cause_status": {"enum": ["known", "unknown", "not_applicable"]},
        "intent_status": {"enum": ["defined", "materially_underdefined"]},
        "copy_paste_projection_requested": {"type": "boolean"},
        "disposable_spike": {"type": "boolean"},
        "durable_handoff": {"type": "boolean"},
        "external_side_effect": {"type": "boolean"},
        "independent_write_slices": {"type": "integer", "minimum": 0},
        "long_corpus_only": {"type": "boolean"},
        "migration_or_rollback": {"type": "boolean"},
        "public_contract": {"type": "boolean"},
        "resume_required": {"type": "boolean"},
        "same_session_execution": {"type": "boolean"},
        "strategy_family_count": {"type": "integer", "minimum": 1}
      }
    },
    "briefFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "scope", "invariants", "approach", "proof", "completion"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "invariants": {"type": "string", "minLength": 1},
        "approach": {"type": "string", "minLength": 1},
        "proof": {"type": "string", "minLength": 1},
        "risks_open_facts": {"type": "string"},
        "completion": {"type": "string", "minLength": 1}
      }
    },
    "planDeltaFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "rationale", "evidence_refs"],
      "properties": {
        "operations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["operation", "target", "value"],
            "properties": {
              "operation": {"enum": ["upsert_by_identity", "replace_field", "rebind_source"]},
              "target": {"type": "string", "minLength": 1},
              "value": {}
            }
          }
        },
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "evidenceFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "observations", "limitations", "verdict"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verdict": {"type": "string", "minLength": 1}
      }
    },
    "handoffFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "non_goals", "invariants", "owner_seams", "ordered_slices", "required_evidence", "rollback"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "owner_seams": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "ordered_slices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "programFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "non_goals", "invariants", "initial_queue"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "initial_queue": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["decision_id", "subject_ref"],
            "properties": {
              "decision_id": {"type": "string", "minLength": 1},
              "subject_ref": {"type": ["string", "null"], "minLength": 1}
            }
          }
        }
      }
    },
    "outputProjectionFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontier_node_ids", "required_sections"],
      "properties": {
        "frontier_node_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "required_sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "contextCapsuleFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "consumer_profile", "budget_bytes", "runtime_projection"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "consumer_profile": {"type": "string", "minLength": 1},
        "budget_bytes": {"type": "integer", "minimum": 1},
        "runtime_projection": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "incumbent_artifact_ref": {"type": "string", "minLength": 1},
            "hard_failure_refs": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "remaining_budget": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "iterations": {"type": "integer", "minimum": 0},
                "candidate_evaluations": {"type": "integer", "minimum": 0},
                "review_rounds": {"type": "integer", "minimum": 0},
                "changed_lines": {"type": "integer", "minimum": 0},
                "total_changed_lines": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "longDocumentHandoffFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_goal", "source_ledger", "coverage_matrix", "recovery_packet", "next_sections"],
      "properties": {
        "document_goal": {"type": "string", "minLength": 1},
        "source_ledger": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "coverage_matrix": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "recovery_packet": {"type": "string", "minLength": 1},
        "next_sections": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity_hash"],
      "properties": {
        "kind": {"enum": ["repository", "unversioned"]},
        "identity_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "nextCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "decision_id", "card_id", "card_path", "card_hash"],
      "properties": {
        "kind": {"const": "card"},
        "decision_id": {"type": "string", "minLength": 1},
        "card_id": {"type": "string", "minLength": 1},
        "card_path": {"type": "string", "minLength": 1},
        "card_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "terminalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status"],
      "properties": {
        "kind": {"const": "terminal"},
        "status": {"const": "brief_complete"}
      }
    },
    "contentLocator": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schema_version", "content_kind", "artifact_id", "content_hash", "bytes"],
      "properties": {
        "schema_version": {"const": "content-locator/1"},
        "content_kind": {"const": "projection"},
        "artifact_id": {"const": "plan-brief"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 32768}
      }
    },
    "planningScopeBinding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["binding_id", "profile", "allowed_plan_outputs", "delivery_root_binding_hash"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "profile": {"const": "brief"},
        "allowed_plan_outputs": {"type": "array", "prefixItems": [{"const": "plan-brief"}], "items": false},
        "delivery_root_binding_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "completion": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["completion_id", "artifact_id", "producer_card_id", "decision_id", "payload_hash", "outcome"],
      "properties": {
        "completion_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_id": {"const": "plan-brief"},
        "producer_card_id": {"const": "wp.profiles.brief"},
        "decision_id": {"const": "wp.select.profiles.brief"},
        "payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "outcome": {"$ref": "#/$defs/completionOutcome"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "receipt_kind", "receipt_id", "bundle_id", "skill_id",
        "source_identity", "next_step", "route_context", "completion",
        "planning_scope_binding", "content_locator"
      ],
      "properties": {
        "schema_version": {"const": "wp-card-receipt/1"},
        "receipt_kind": {"enum": ["route", "completion"]},
        "receipt_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bundle_id": {"type": "string", "minLength": 1},
        "skill_id": {"const": "writing-plans"},
        "source_identity": {"$ref": "#/$defs/sourceIdentity"},
        "next_step": {"oneOf": [{"$ref": "#/$defs/nextCard"}, {"$ref": "#/$defs/terminalStep"}]},
        "route_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/routeFields"}]},
        "completion": {"$ref": "#/$defs/completion"},
        "planning_scope_binding": {"$ref": "#/$defs/planningScopeBinding"},
        "content_locator": {"$ref": "#/$defs/contentLocator"}
      }
    },
    "routeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.route.initial/1"},
        "invocation_phase": {"const": "initial"},
        "previous_receipt": {"type": "null"},
        "fields": {"$ref": "#/$defs/routeFields"},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "briefCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.complete.brief/1"},
        "invocation_phase": {"const": "initial"},
        "previous_receipt": {"$ref": "#/$defs/receipt"},
        "fields": {"$ref": "#/$defs/briefFields"},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "command": {
      "oneOf": [{"$ref": "#/$defs/routeCommand"}, {"$ref": "#/$defs/briefCommand"}]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    },
    "artifactFamilyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_def", "payload_def", "human_max_bytes", "payload_max_bytes",
        "source_binding", "persistence_class"
      ],
      "properties": {
        "human_def": {"type": "string", "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9]*$"},
        "payload_def": {"type": "string", "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9]*$"},
        "human_max_bytes": {"type": "integer", "minimum": 1},
        "payload_max_bytes": {"type": "integer", "minimum": 1},
        "source_binding": {"const": "required"},
        "persistence_class": {
          "enum": ["semantic_inline", "boundary_by_contract", "immutable_projection", "owner_disposable_projection"]
        }
      }
    },
    "artifactContractRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "families", "artifacts"],
      "properties": {
        "schema_version": {"const": "wp-artifact-family-contracts/1"},
        "families": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/artifactFamilyContract"}
        },
        "artifacts": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
