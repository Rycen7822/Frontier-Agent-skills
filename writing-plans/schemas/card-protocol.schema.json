{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent-skills.local/writing-plans/card-protocol.schema.json",
  "$ref": "#/$defs/command",
  "$defs": {
    "humanOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker"],
      "properties": {
        "blocker": {"type": ["string", "null"]}
      }
    },
    "completionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker", "decision_request"],
      "properties": {
        "blocker": {"type": ["string", "null"]},
        "decision_request": {"type": ["string", "null"]}
      }
    },
    "routeFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_plan_request", "root_cause_status", "intent_status",
        "copy_paste_projection_requested", "disposable_spike", "durable_handoff",
        "external_side_effect", "independent_write_slices", "long_corpus_only",
        "migration_or_rollback", "public_contract", "resume_required",
        "same_session_execution", "strategy_family_count"
      ],
      "properties": {
        "explicit_plan_request": {"type": "boolean"},
        "root_cause_status": {"enum": ["known", "unknown", "not_applicable"]},
        "intent_status": {"enum": ["defined", "materially_underdefined"]},
        "copy_paste_projection_requested": {"type": "boolean"},
        "disposable_spike": {"type": "boolean"},
        "durable_handoff": {"type": "boolean"},
        "external_side_effect": {"type": "boolean"},
        "independent_write_slices": {"type": "integer", "minimum": 0},
        "long_corpus_only": {"type": "boolean"},
        "migration_or_rollback": {"type": "boolean"},
        "public_contract": {"type": "boolean"},
        "resume_required": {"type": "boolean"},
        "same_session_execution": {"type": "boolean"},
        "strategy_family_count": {"type": "integer", "minimum": 1}
      }
    },
    "briefFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "scope", "invariants", "approach", "proof", "completion"],
      "properties": {
        "outcome": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "invariants": {"type": "string", "minLength": 1},
        "approach": {"type": "string", "minLength": 1},
        "proof": {"type": "string", "minLength": 1},
        "risks_open_facts": {"type": "string"},
        "completion": {"type": "string", "minLength": 1}
      }
    },
    "planDeltaFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "rationale", "evidence_refs"],
      "properties": {
        "operations": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["operation", "target", "value"],
            "properties": {
              "operation": {"enum": ["upsert_by_identity", "replace_field", "rebind_source"]},
              "target": {"type": "string", "minLength": 1},
              "value": {}
            }
          }
        },
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "evidenceFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "observations", "limitations", "verdict"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verdict": {"type": "string", "minLength": 1}
      }
    },
    "handoffFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "non_goals", "invariants", "owner_seams", "ordered_slices", "required_evidence", "rollback"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "owner_seams": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "ordered_slices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "initialProgramNode": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "objective", "depends_on", "inputs", "outputs", "read_set", "write_set", "resource_set", "effect_set", "side_effect_level", "verifier", "retry", "refinement"],
      "properties": {
        "id": {"type": "string", "pattern": "^P-"},
        "kind": {"enum": ["discovery", "decision", "verification", "implementation", "migration", "cleanup", "documentation", "approval", "release"]},
        "status": {"enum": ["fog", "ready", "in_progress", "blocked", "done", "failed", "invalidated", "superseded", "skipped"]},
        "objective": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^P-"}},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "read_set": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "write_set": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "resource_set": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "effect_set": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "side_effect_level": {"enum": ["none", "local_ephemeral", "local_reversible", "external_reversible", "external_non_idempotent", "destructive"]},
        "verifier": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "completion_criterion", "false_green_risk", "required_evidence"],
          "properties": {
            "kind": {"enum": ["command", "evidence_set", "manual", "schema", "static", "runtime"]},
            "completion_criterion": {"type": "string", "minLength": 1},
            "false_green_risk": {"type": "string", "minLength": 1},
            "required_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "retry": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed", "max_attempts", "idempotency"],
          "properties": {
            "allowed": {"type": "boolean"}, "max_attempts": {"type": "integer", "minimum": 0, "maximum": 20},
            "idempotency": {"enum": ["idempotent", "inspect_before_retry", "idempotency_key", "manual_reconciliation", "not_retryable"]}
          }
        },
        "refinement": {
          "type": "object", "additionalProperties": false,
          "required": ["parent", "replaces"],
          "properties": {
            "parent": {"type": ["string", "null"], "pattern": "^P-"},
            "replaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^P-"}}
          }
        }
      }
    },
    "programFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "non_goals", "invariants", "initial_nodes", "initial_queue"],
      "properties": {
        "goal": {"type": "string", "minLength": 1},
        "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "initial_nodes": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/initialProgramNode"}},
        "initial_queue": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["decision_id", "subject_ref"],
            "properties": {
              "decision_id": {"type": "string", "minLength": 1},
              "subject_ref": {"type": ["string", "null"], "minLength": 1}
            }
          }
        }
      }
    },
    "outputProjectionFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontier_node_ids", "required_sections"],
      "properties": {
        "frontier_node_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "required_sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "contextCapsuleFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "consumer_profile", "budget_bytes"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "consumer_profile": {"type": "string", "minLength": 1},
        "budget_bytes": {"type": "integer", "minimum": 500, "maximum": 8192}
      }
    },
    "runtimeProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["hard_failure_refs", "remaining_budget"],
      "properties": {
        "incumbent_artifact_ref": {"type": "string", "minLength": 1},
        "hard_failure_refs": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "remaining_budget": {
          "type": "object", "additionalProperties": false,
          "required": ["iterations", "candidate_evaluations", "review_rounds", "changed_lines", "total_changed_lines"],
          "properties": {
            "iterations": {"type": "integer", "minimum": 0},
            "candidate_evaluations": {"type": "integer", "minimum": 0},
            "review_rounds": {"type": "integer", "minimum": 0},
            "changed_lines": {"type": "integer", "minimum": 0},
            "total_changed_lines": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "longDocumentHandoffFields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_goal", "source_ledger", "coverage_matrix", "recovery_packet", "next_sections"],
      "properties": {
        "document_goal": {"type": "string", "minLength": 1},
        "source_ledger": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "coverage_matrix": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "recovery_packet": {"type": "string", "minLength": 1},
        "next_sections": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity_hash"],
      "properties": {
        "kind": {"enum": ["repository", "unversioned"]},
        "identity_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "sourceTransition": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["operation_kind", "before_identity_hash", "after_identity_hash", "changed_paths"],
      "properties": {
        "operation_kind": {"const": "plan-output"},
        "before_identity_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "after_identity_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "changed_paths": {
          "type": "array", "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "status"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "status": {"enum": ["added", "modified"]}
            }
          }
        }
      }
    },
    "nextCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "decision_id", "card_id", "card_path", "card_hash", "input_contract"],
      "properties": {
        "kind": {"const": "card"},
        "decision_id": {"type": "string", "minLength": 1},
        "card_id": {"type": "string", "minLength": 1},
        "card_path": {"type": "string", "minLength": 1},
        "card_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "input_contract": {"$ref": "#/$defs/inputContract"},
        "card_instance_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "subject_ref": {"type": ["string", "null"]}
      }
    },
    "inputContract": {
      "type": "object", "additionalProperties": false,
      "required": ["completion_contract_id", "artifact_id", "persistence_class", "required_fields", "optional_fields", "enum_values", "human_max_bytes", "required_root_args"],
      "properties": {
        "completion_contract_id": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "persistence_class": {"enum": ["semantic_inline", "immutable_projection", "boundary_by_contract", "owner_disposable_projection"]},
        "required_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "optional_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "enum_values": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": ["string", "integer", "boolean", "null"]}}},
        "human_max_bytes": {"type": "integer", "minimum": 1},
        "required_root_args": {
          "type": "object", "additionalProperties": false, "required": ["always", "conditional"],
          "properties": {
            "always": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^--"}},
            "conditional": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["arg", "field", "in"],
                "properties": {
                  "arg": {"type": "string", "pattern": "^--"},
                  "field": {"type": "string", "minLength": 1},
                  "in": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": ["string", "integer", "boolean"]}}
                }
              }
            }
          }
        }
      }
    },
    "terminalStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status"],
      "properties": {
        "kind": {"const": "terminal"},
        "status": {"enum": ["brief_complete", "handoff_complete", "program_ready", "program_blocked", "program_complete", "program_superseded", "source_blocked"]}
      }
    },
    "contentLocator": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schema_version", "content_kind", "artifact_id", "content_hash", "bytes"],
      "properties": {
        "schema_version": {"const": "content-locator/1"},
        "content_kind": {"enum": ["projection", "artifact", "owner"]},
        "artifact_id": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"content_kind": {"const": "owner"}}, "required": ["content_kind"]},
          "then": {"properties": {"bytes": {"maximum": 65536}}},
          "else": {"properties": {"bytes": {"maximum": 32768}}}
        }
      ]
    },
    "planningScopeBinding": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["binding_id", "profile", "allowed_plan_outputs", "delivery_root_binding_hash"],
      "properties": {
        "binding_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "profile": {"enum": ["brief", "handoff", "program"]},
        "allowed_plan_outputs": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1}},
        "delivery_root_binding_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "completion": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["completion_id", "artifact_id", "producer_card_id", "decision_id", "payload_hash", "outcome"],
      "properties": {
        "completion_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_id": {"type": "string", "minLength": 1},
        "producer_card_id": {"type": "string", "pattern": "^wp\\."},
        "decision_id": {"type": "string", "pattern": "^wp\\."},
        "payload_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "outcome": {"$ref": "#/$defs/completionOutcome"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "receipt_kind", "receipt_id", "bundle_id", "skill_id",
        "source_identity", "next_step", "route_context", "completion",
        "planning_scope_binding", "content_locator", "owner_locator", "already_completed",
        "source_fresh", "source_rebind_required", "source_transition", "state_version", "state_hash"
      ],
      "properties": {
        "schema_version": {"const": "wp-card-receipt/2"},
        "receipt_kind": {"enum": ["route", "completion"]},
        "receipt_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bundle_id": {"type": "string", "minLength": 1},
        "skill_id": {"const": "writing-plans"},
        "source_identity": {"$ref": "#/$defs/sourceIdentity"},
        "next_step": {"oneOf": [{"$ref": "#/$defs/nextCard"}, {"$ref": "#/$defs/terminalStep"}]},
        "route_context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/routeFields"}]},
        "completion": {"$ref": "#/$defs/completion"},
        "planning_scope_binding": {"$ref": "#/$defs/planningScopeBinding"},
        "content_locator": {"$ref": "#/$defs/contentLocator"},
        "owner_locator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ownerLocator"}]},
        "already_completed": {"type": "boolean"},
        "source_fresh": {"type": ["boolean", "null"]},
        "source_rebind_required": {"type": "boolean"},
        "source_transition": {"$ref": "#/$defs/sourceTransition"},
        "state_version": {"type": ["integer", "null"], "minimum": 1},
        "state_hash": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}]}
      }
    },
    "routeCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.route.initial/2"},
        "invocation_phase": {"const": "initial"},
        "previous_receipt": {"type": "null"},
        "fields": {"$ref": "#/$defs/routeFields"},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "briefCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.complete.brief/2"},
        "invocation_phase": {"const": "initial"},
        "previous_receipt": {"$ref": "#/$defs/receipt"},
        "fields": {"$ref": "#/$defs/briefFields"},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "standaloneCardCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.complete.card/2"},
        "invocation_phase": {"const": "initial"},
        "previous_receipt": {"$ref": "#/$defs/receipt"},
        "fields": {"oneOf": [{"$ref": "#/$defs/evidenceFields"}, {"$ref": "#/$defs/longDocumentHandoffFields"}]},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "ownerLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "plan_id", "initialization_id", "bundle_id", "initial_source_identity_hash", "planning_scope_binding_id"],
      "properties": {
        "schema_version": {"const": "wp-program-owner/1"},
        "plan_id": {"type": "string", "pattern": "^wp-plan:[0-9a-f]{64}$"},
        "initialization_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bundle_id": {"type": "string", "minLength": 1},
        "initial_source_identity_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "planning_scope_binding_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "routeResumeCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.route.resume/2"},
        "invocation_phase": {"const": "resume"},
        "previous_receipt": {"type": "null"},
        "fields": {"type": "object", "additionalProperties": false, "required": ["owner_locator"], "properties": {"owner_locator": {"$ref": "#/$defs/ownerLocator"}}},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "handoffCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.complete.handoff/2"},
        "invocation_phase": {"const": "initial"},
        "previous_receipt": {"$ref": "#/$defs/receipt"},
        "fields": {"$ref": "#/$defs/handoffFields"},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "programInitCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.complete.program/2"},
        "invocation_phase": {"const": "initial"},
        "previous_receipt": {"$ref": "#/$defs/receipt"},
        "fields": {"$ref": "#/$defs/programFields"},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "enqueueRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "subject_ref"],
      "properties": {"decision_id": {"type": "string", "pattern": "^wp\\."}, "subject_ref": {"type": ["string", "null"]}}
    },
    "programCardFields": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_locator", "expected_state_version", "expected_content_hash", "operations", "enqueue_requests", "rationale", "evidence_refs", "context", "runtime_projection"],
      "properties": {
        "owner_locator": {"$ref": "#/$defs/ownerLocator"},
        "expected_state_version": {"type": "integer", "minimum": 1},
        "expected_content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "operations": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/planDeltaFields/properties/operations/items"}},
        "enqueue_requests": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/enqueueRequest"}},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "context": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/contextCapsuleFields"}]},
        "runtime_projection": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/runtimeProjection"}]}
      }
    },
    "programCardCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.complete.program-card/2"},
        "invocation_phase": {"const": "resume"},
        "previous_receipt": {"$ref": "#/$defs/receipt"},
        "fields": {"$ref": "#/$defs/programCardFields"},
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "renderCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.render.program/2"},
        "invocation_phase": {"const": "resume"},
        "previous_receipt": {"type": "null"},
        "fields": {
          "type": "object", "additionalProperties": false,
          "required": ["owner_locator", "projection_kind"],
          "properties": {"owner_locator": {"$ref": "#/$defs/ownerLocator"}, "projection_kind": {"enum": ["program", "context-capsule"]}}
        },
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "handoffRenderCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "invocation_phase", "previous_receipt", "fields", "outcome"],
      "properties": {
        "contract_id": {"const": "wp.render.handoff/2"},
        "invocation_phase": {"const": "resume"},
        "previous_receipt": {"type": "null"},
        "fields": {
          "type": "object", "additionalProperties": false,
          "required": ["content_locator"],
          "properties": {"content_locator": {"$ref": "#/$defs/contentLocator"}}
        },
        "outcome": {"$ref": "#/$defs/humanOutcome"}
      }
    },
    "command": {
      "oneOf": [
        {"$ref": "#/$defs/routeCommand"}, {"$ref": "#/$defs/routeResumeCommand"},
        {"$ref": "#/$defs/briefCommand"}, {"$ref": "#/$defs/standaloneCardCommand"}, {"$ref": "#/$defs/handoffCommand"},
        {"$ref": "#/$defs/programInitCommand"}, {"$ref": "#/$defs/programCardCommand"},
        {"$ref": "#/$defs/renderCommand"}, {"$ref": "#/$defs/handoffRenderCommand"}
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"type": "boolean"}
      }
    },
    "artifactFamilyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_def", "payload_def", "human_max_bytes", "payload_max_bytes",
        "source_binding", "persistence_class"
      ],
      "properties": {
        "human_def": {"type": "string", "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9]*$"},
        "payload_def": {"type": "string", "pattern": "^#/\\$defs/[A-Za-z][A-Za-z0-9]*$"},
        "human_max_bytes": {"type": "integer", "minimum": 1},
        "payload_max_bytes": {"type": "integer", "minimum": 1},
        "source_binding": {"const": "required"},
        "persistence_class": {
          "enum": ["semantic_inline", "boundary_by_contract", "immutable_projection", "owner_disposable_projection"]
        }
      }
    },
    "artifactContractRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "families", "artifacts"],
      "properties": {
        "schema_version": {"const": "wp-artifact-family-contracts/1"},
        "families": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/artifactFamilyContract"}
        },
        "artifacts": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
