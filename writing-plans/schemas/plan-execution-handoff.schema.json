{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.frontier-agent/schemas/plan-execution-handoff.schema.json",
  "title": "Plan Execution Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "bundle_id",
    "source_revision",
    "execution_policy",
    "profile",
    "closure_admission_ref",
    "closure_admission_hash",
    "plan_ref",
    "plan_hash",
    "closure_contract_ref",
    "closure_contract_hash",
    "authority_manifest_ref",
    "scope_hash",
    "frontier_node_ids",
    "required_execution_policy_ids",
    "unresolved_blockers"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "handoff_id": {"type": "string", "pattern": "^handoff-[0-9a-f]{20}$"},
    "bundle_id": {"const": "frontier-engineering/5.0.0+4.0.0"},
    "source_revision": {"$ref": "#/$defs/nonempty_string"},
    "execution_policy": {"enum": ["standard", "autonomous_closure"]},
    "profile": {"enum": ["brief", "handoff", "program"]},
    "closure_admission_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/admission_ref"}]},
    "closure_admission_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "plan_ref": {"type": "string", "pattern": "^artifact:plan/[A-Za-z0-9._-]+$"},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "closure_contract_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/contract_ref"}]},
    "closure_contract_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "authority_manifest_ref": {"type": "string", "pattern": "^artifact:authority/auth-[0-9a-f]{20}$"},
    "scope_hash": {"$ref": "#/$defs/hash"},
    "frontier_node_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty_string"}},
    "required_execution_policy_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^sqw\\.[a-z0-9.-]+$"}},
    "unresolved_blockers": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty_string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"execution_policy": {"const": "standard"}}, "required": ["execution_policy"]},
      "then": {
        "properties": {
          "closure_admission_ref": {"type": "null"},
          "closure_admission_hash": {"type": "null"},
          "closure_contract_ref": {"type": "null"},
          "closure_contract_hash": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"execution_policy": {"const": "autonomous_closure"}}, "required": ["execution_policy"]},
      "then": {
        "properties": {
          "profile": {"const": "program"},
          "closure_admission_ref": {"$ref": "#/$defs/admission_ref"},
          "closure_admission_hash": {"$ref": "#/$defs/hash"},
          "closure_contract_ref": {"$ref": "#/$defs/contract_ref"},
          "closure_contract_hash": {"$ref": "#/$defs/hash"}
        }
      }
    }
  ],
  "$defs": {
    "nonempty_string": {"type": "string", "minLength": 1, "maxLength": 4096},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "admission_ref": {"type": "string", "pattern": "^artifact:admission/admission-[0-9a-f]{20}$"},
    "contract_ref": {"type": "string", "pattern": "^artifact:contract/[A-Za-z0-9._-]+$"}
  }
}
