{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.frontier-agent/schemas/plan-execution-handoff.schema.json",
  "title": "Plan Execution Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "bundle_id",
    "source_revision",
    "profile",
    "plan_ref",
    "plan_hash",
    "authority_manifest_ref",
    "scope_hash",
    "frontier_node_ids",
    "required_execution_policy_ids",
    "unresolved_blockers"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "handoff_id": {"type": "string", "pattern": "^handoff-[0-9a-f]{20}$"},
    "bundle_id": {"const": "frontier-engineering/6.0.0+5.0.0"},
    "source_revision": {"$ref": "#/$defs/nonempty_string"},
    "profile": {"enum": ["brief", "handoff", "program"]},
    "plan_ref": {"type": "string", "pattern": "^artifact:plan/[A-Za-z0-9._-]+$"},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "authority_manifest_ref": {"type": "string", "pattern": "^artifact:authority/auth-[0-9a-f]{20}$"},
    "scope_hash": {"$ref": "#/$defs/hash"},
    "frontier_node_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty_string"}},
    "required_execution_policy_ids": {"type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^sqw\\.[a-z0-9.-]+$"}},
    "unresolved_blockers": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty_string"}}
  },
  "$defs": {
    "nonempty_string": {"type": "string", "minLength": 1, "maxLength": 4096},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
