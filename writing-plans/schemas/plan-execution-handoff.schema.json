{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.frontier-agent/schemas/plan-execution-handoff.schema.json",
  "title": "Typed Plan Execution Handoff v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "handoff_id", "bundle_id", "producer", "source_identity",
    "scope_binding", "goal", "non_goals", "global_invariants", "owner_seams",
    "requirements", "ordered_slices", "rollback", "target_entry", "unresolved_blockers"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "handoff_id": {"type": "string", "pattern": "^wp-handoff:[0-9a-f]{64}$"},
    "bundle_id": {"const": "frontier-engineering/4.0.0"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "card_id", "decision_id", "completion_id", "plan_id", "state_hash"],
      "properties": {
        "profile": {"enum": ["handoff", "program"]},
        "card_id": {"type": "string", "pattern": "^wp\\."},
        "decision_id": {"type": "string", "pattern": "^wp\\."},
        "completion_id": {"$ref": "#/$defs/hash"},
        "plan_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^wp-plan:[0-9a-f]{64}$"}]},
        "state_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]}
      }
    },
    "source_identity": {"$ref": "#/$defs/source_identity"},
    "scope_binding": {"$ref": "#/$defs/scope_binding"},
    "goal": {"$ref": "#/$defs/nonempty_string"},
    "non_goals": {"$ref": "#/$defs/string_array"},
    "global_invariants": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/typed_ref"}},
    "owner_seams": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/owner_seam"}},
    "requirements": {"$ref": "#/$defs/requirements"},
    "ordered_slices": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/slice"}},
    "rollback": {"$ref": "#/$defs/rollback"},
    "target_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["skill_id", "route_phase", "required_decision_ids"],
      "properties": {
        "skill_id": {"const": "software-quality-workflows"},
        "route_phase": {"const": "entry"},
        "required_decision_ids": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^sqw\\."}}
      }
    },
    "unresolved_blockers": {"$ref": "#/$defs/string_array"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonempty_string": {"type": "string", "minLength": 1, "maxLength": 4096},
    "string_array": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/nonempty_string"}},
    "path_array": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty_string"}},
    "source_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identity_hash"],
      "properties": {
        "kind": {"enum": ["repository", "unversioned"]},
        "identity_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "scope_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["binding_id", "allowed_reads", "allowed_writes", "effect_ceiling", "approval_requirements", "publication_ceiling"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/hash"},
        "allowed_reads": {"$ref": "#/$defs/path_array"},
        "allowed_writes": {"$ref": "#/$defs/path_array"},
        "effect_ceiling": {"enum": ["read-only", "local-plan-artifact", "workspace-mutation", "external-side-effect"]},
        "approval_requirements": {"$ref": "#/$defs/string_array"},
        "publication_ceiling": {"enum": ["none", "local-artifact", "external"]}
      }
    },
    "typed_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "statement"],
      "properties": {"ref": {"$ref": "#/$defs/nonempty_string"}, "statement": {"$ref": "#/$defs/nonempty_string"}}
    },
    "owner_seam": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "paths", "resources", "effects"],
      "properties": {
        "owner": {"$ref": "#/$defs/nonempty_string"},
        "paths": {"$ref": "#/$defs/path_array"},
        "resources": {"$ref": "#/$defs/string_array"},
        "effects": {"$ref": "#/$defs/string_array"}
      }
    },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_refs", "decision_refs", "evidence_refs", "approval_refs", "policy_refs"],
      "properties": {
        "fact_refs": {"$ref": "#/$defs/path_array"},
        "decision_refs": {"$ref": "#/$defs/path_array"},
        "evidence_refs": {"$ref": "#/$defs/path_array"},
        "approval_refs": {"$ref": "#/$defs/path_array"},
        "policy_refs": {"$ref": "#/$defs/path_array"}
      }
    },
    "slice": {
      "type": "object", "additionalProperties": false,
      "required": ["slice_id", "node_ref", "objective", "depends_on", "read_set", "write_set", "effect_set", "completion_criterion"],
      "properties": {
        "slice_id": {"type": "string", "pattern": "^S-[0-9]{2,4}$"},
        "node_ref": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^P-"}]},
        "objective": {"$ref": "#/$defs/nonempty_string"},
        "depends_on": {"$ref": "#/$defs/path_array"},
        "read_set": {"$ref": "#/$defs/path_array"},
        "write_set": {"$ref": "#/$defs/path_array"},
        "effect_set": {"$ref": "#/$defs/string_array"},
        "completion_criterion": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "steps", "verifier_refs"],
      "properties": {
        "strategy": {"enum": ["restore_previous_state", "manual_recovery", "not_applicable"]},
        "steps": {"$ref": "#/$defs/string_array"},
        "verifier_refs": {"$ref": "#/$defs/path_array"}
      }
    }
  }
}
