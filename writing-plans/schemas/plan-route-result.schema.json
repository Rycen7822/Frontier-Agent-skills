{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontier-agent-skills.local/writing-plans/plan-route-result.schema.json",
  "title": "Writing Plans Route Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route",
    "profile",
    "execution_policy",
    "primary_card",
    "required_artifact_projection_ids",
    "reason_codes",
    "handoff_owner"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "route": {"enum": ["direct", "sqw-diagnosis", "sqw-intent", "writing-plans", "spike", "long-document", "terminal"]},
    "profile": {"enum": [null, "brief", "handoff", "program"]},
    "execution_policy": {"enum": ["standard", "autonomous_closure"]},
    "primary_card": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/card_ref"}]},
    "required_artifact_projection_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "handoff_owner": {"type": ["string", "null"], "minLength": 1}
  },
  "$defs": {
    "card_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "path", "sha256", "bytes"],
      "properties": {
        "card_id": {"type": "string", "pattern": "^wp\\."},
        "path": {"type": "string", "pattern": "^references/.*\\.md$"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
