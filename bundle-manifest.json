      "PYTHONDONTWRITEBYTECODE=1 LONG_DOCUMENT_SKILL_ROOT=<installed-skill-root> python3 -m unittest discover -s software-quality-workflows/tests -p 'test_*.py' -v",
      "PYTHONDONTWRITEBYTECODE=1 LONG_DOCUMENT_SKILL_ROOT=<installed-skill-root> python3 -m unittest discover -s tests -p 'test_*.py' -v"
    ],
    "standalone": [
      "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s writing-plans/tests -p 'test_*.py' -v",
      "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s software-quality-workflows/tests -p 'test_*.py' -v",
      "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_*.py' -v"
    ]
  }
